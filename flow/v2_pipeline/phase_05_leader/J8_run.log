#!/usr/bin/env python3
"""platform.lib.spike_ref — assemble + run Spike to get the golden final regfile.

code-first ISA lockstep reference: assembles a program (riscv64-linux-gnu-gcc),
runs it on **Spike** (the authoritative RISC-V ISS) with --log-commits, and
returns the final architectural GPRs (x1..x31) plus a memory .hex the DUT loads.
Only user-code commits (pc >= DRAM_BASE) count, so the result matches a DUT that
starts clean at _start. Requires: riscv64-linux-gnu-{gcc,objcopy}, spike.
"""
from __future__ import annotations

import os
import re
import struct
import subprocess

GCC = "riscv64-linux-gnu-gcc"
OBJCOPY = "riscv64-linux-gnu-objcopy"
DRAM_BASE = 0x8000_0000

LK = """OUTPUT_ARCH("riscv")
ENTRY(_start)
SECTIONS {
  . = 0x80000000;
  .text : { *(.text*) }
  . = 0x80000400;
  .tohost : { *(.tohost) }
  /DISCARD/ : { *(.comment) *(.note*) *(.riscv.attributes) }
}
"""

_COMMIT = re.compile(
    r"core\s+\d+:\s+\d+\s+0x([0-9a-f]+)\s+\(0x[0-9a-f]+\)\s+x\s*(\d+)\s+0x([0-9a-f]+)")
_DISASM = re.compile(
    r"core\s+\d+:\s+0x([0-9a-f]+)\s+\(0x[0-9a-f]+\)\s+(\S+)")


def available():
    from shutil import which
    return all(which(t) for t in (GCC, OBJCOPY, "spike"))


def golden_and_hex(asm, work, ram_words=256, timeout=30):
    """Assemble `asm`, run on Spike, return (regs{1..31:int}, hex_path).
    hex_path is a $readmemh image of `ram_words` 64-bit little-endian words."""
    os.makedirs(work, exist_ok=True)
    s, lk, elf = (os.path.join(work, f) for f in ("p.s", "lk.ld", "p.elf"))
    binf, hexf, log = (os.path.join(work, f) for f in ("p.bin", "p.hex", "commit.log"))
    open(s, "w").write(asm)
    open(lk, "w").write(LK)

    subprocess.run([GCC, "-nostdlib", "-nostartfiles", "-march=rv64ima_zicsr", "-mabi=lp64",
                    "-T", lk, "-o", elf, s], check=True, capture_output=True, text=True)
    with open(log, "w") as lf:
        subprocess.run(["spike", "--log-commits", "--isa=rv64ima_zicsr", "-l", elf],
                       stderr=lf, stdout=subprocess.DEVNULL, timeout=timeout)

    regs = {i: 0 for i in range(1, 32)}
    for line in open(log, encoding="utf-8", errors="replace"):
        m = _COMMIT.search(line)
        if m and int(m.group(1), 16) >= DRAM_BASE:
            rd = int(m.group(2))
            if 1 <= rd <= 31:
                regs[rd] = int(m.group(3), 16)

    _emit_hex(elf, binf, hexf, ram_words)
    return regs, hexf


def _emit_hex(elf, binf, hexf, ram_words):
    subprocess.run([OBJCOPY, "-O", "binary", elf, binf], check=True, capture_output=True)
    data = open(binf, "rb").read()
    data += b"\x00" * ((8 - len(data) % 8) % 8)
    words = struct.unpack("<%dQ" % (len(data) // 8), data)
    with open(hexf, "w") as hf:
        for i in range(ram_words):
            hf.write("%016x\n" % (words[i] if i < len(words) else 0))


def assemble_hex(asm, work, ram_words=256):
    """Assemble `asm` to a $readmemh image WITHOUT running Spike. For coverage-only
    / peripheral-directed programs (MMIO Spike doesn't model) — no golden trace."""
    os.makedirs(work, exist_ok=True)
    s, lk, elf = (os.path.join(work, f) for f in ("p.s", "lk.ld", "p.elf"))
    binf, hexf = (os.path.join(work, f) for f in ("p.bin", "p.hex"))
    open(s, "w").write(asm)
    open(lk, "w").write(LK)
    subprocess.run([GCC, "-nostdlib", "-nostartfiles", "-march=rv64ima_zicsr", "-mabi=lp64",
                    "-T", lk, "-o", elf, s], check=True, capture_output=True, text=True)
    _emit_hex(elf, binf, hexf, ram_words)
    return hexf


def golden_trace_and_hex(asm, work, ram_words=256, timeout=30):
    """Like golden_and_hex but returns the ORDERED register-write commit trace
    [(pc, rd, val)] (user code only) + a hex image + the executed mnemonic list
    [(pc, mnemonic)] for coverage. Per-commit lockstep + functional coverage."""
    os.makedirs(work, exist_ok=True)
    s, lk, elf = (os.path.join(work, f) for f in ("p.s", "lk.ld", "p.elf"))
    binf, hexf, log = (os.path.join(work, f) for f in ("p.bin", "p.hex", "commit.log"))
    open(s, "w").write(asm)
    open(lk, "w").write(LK)
    subprocess.run([GCC, "-nostdlib", "-nostartfiles", "-march=rv64ima_zicsr", "-mabi=lp64",
                    "-T", lk, "-o", elf, s], check=True, capture_output=True, text=True)
    with open(log, "w") as lf:
        subprocess.run(["spike", "--log-commits", "--isa=rv64ima_zicsr", "-l", elf],
                       stderr=lf, stdout=subprocess.DEVNULL, timeout=timeout)

    trace, mnems = [], []
    for line in open(log, encoding="utf-8", errors="replace"):
        m = _COMMIT.search(line)
        if m and int(m.group(1), 16) >= DRAM_BASE:
            trace.append((int(m.group(1), 16), int(m.group(2)), int(m.group(3), 16)))
            continue
        d = _DISASM.search(line)
        if d and int(d.group(1), 16) >= DRAM_BASE:
            mnems.append((int(d.group(1), 16), d.group(2)))
    _emit_hex(elf, binf, hexf, ram_words)
    return trace, hexf, mnems


if __name__ == "__main__":
    import tempfile, sys
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import riscv_rand
    if not available():
        print("spike_ref: toolchain/spike NOT available"); raise SystemExit(0)
    g, h = golden_and_hex(riscv_rand.gen(1, 8), tempfile.mkdtemp())
    print("spike_ref: OK — golden x1..x5 =", {i: hex(g[i]) for i in range(1, 6)}, "hex:", h)

