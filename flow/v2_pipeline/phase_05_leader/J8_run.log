    run_cmd([str(nm), "-n", "firmware.elf"], nm_log, work, env)
    tohost_addr = None
    for line in nm_log.read_text(errors="replace").splitlines():
        fields = line.split()
        if len(fields) >= 3 and fields[-1] == "tohost":
            tohost_addr = int(fields[0], 16)
            break
    if tohost_addr is None:
        raise RuntimeError(f"missing tohost symbol in {nm_log}")
    binary_size = (work / "firmware.bin").stat().st_size
    if CODE_BASE + binary_size > RAM_SIZE:
        raise RuntimeError(f"{test['test']} binary end 0x{CODE_BASE + binary_size:x} exceeds RAM 0x{RAM_SIZE:x}")
    return {
        "work": work,
        "elf": work / "firmware.elf",
        "bin": work / "firmware.bin",
        "tohost_addr": tohost_addr,
        "binary_size": binary_size,
    }


def load_binary_at(binary_path: pathlib.Path, ram: bytearray, addr: int) -> None:
    data = binary_path.read_bytes()
    ram[addr:addr + len(data)] = data


def run_dut(test: dict[str, str], build: dict[str, pathlib.Path | int], out_root: pathlib.Path) -> list[dict[str, str]]:
    sys.path.insert(0, str(repo_root() / "dut" / "magpie_x1"))
    from rtl_cosim.system_cosim import SystemCosim

    system = SystemCosim(ram_size_bytes=RAM_SIZE)
    load_binary_at(build["bin"], system.ram, CODE_BASE)  # type: ignore[arg-type]
    system.set_pc(CODE_BASE)
    tohost_addr = int(build["tohost_addr"])
    system.watch_tohost(tohost_addr, 4)
    rows: list[dict[str, str]] = []
    for step_idx in range(MAX_STEPS):
        pc_before = system.read_pc()
        inst = int.from_bytes(system.ram[pc_before:pc_before + 4], "little")
        result = system.step()
        pc_after = system.read_pc()
        rows.append(
            {
                "test": test["test"],
                "seed": test["seed"],
                "step": str(step_idx),
                "pc": f"0x{pc_before:016x}",
                "inst": f"0x{inst:08x}",
                "committed": str(int(bool(result["committed"]))),
                "rd": f"x{int(result['rd'])}",
                "rd_wdata": f"0x{int(result['data']) & MASK64:016x}",
                "invalid_kind": str(int(bool(result["invalid_kind"]))),
                "next_pc": f"0x{int(result['next_pc']) & MASK64:016x}",
                "pc_after": f"0x{pc_after:016x}",
                "mem_op": str(result["mem_op"] or ""),
                "mem_addr": f"0x{int(result['mem_addr']):016x}",
                "mem_region": str(result["mem_region"] or ""),
                "tohost": f"0x{int.from_bytes(system.ram[tohost_addr:tohost_addr + 4], 'little'):08x}",
            }
        )
        if int.from_bytes(system.ram[tohost_addr:tohost_addr + 4], "little"):
            break
    return rows


def run_spike(test: dict[str, str], build: dict[str, pathlib.Path | int], instruction_count: int, out_root: pathlib.Path) -> list[dict[str, int]]:
    spike = pathlib.Path(os.environ.get("SPIKE", "/home/edauser/.local/bin/spike"))
    work = build["work"]  # type: ignore[assignment]
    spike_log = pathlib.Path(work) / "spike.log"
    run_cmd(
        [
            str(spike),
            f"--isa={ISA}",
            "--priv=m",
            "--disable-dtb",
            "-m0x1000:0x100000",
            "--pc=0x1000",
            "--log-commits",
            "-l",
            f"--instructions={instruction_count}",
            str(build["elf"]),
        ],
        spike_log,
        out_root,
    )
    rows: list[dict[str, int]] = []
    with spike_log.open() as f:
        for line in f:
            match = SPIKE_COMMIT_RE.search(line)
            if not match:
                continue
            rows.append(
                {
                    "pc": int(match.group(1), 16),
                    "inst": int(match.group(2), 16),
                    "rd": int(match.group(3)) if match.group(3) is not None else 0,
                    "rd_wdata": int(match.group(4), 16) if match.group(4) is not None else 0,
                }
            )
    return rows


