+    MIE,
+    MTVEC,
+    MSCRATCH,
+    MEPC,
+    MCAUSE,
+    MIP,
+    MCYCLE,
+    MCYCLEH,
+    MINSTRET,
+    MINSTRETH
+};
+
+bit [11:0] custom_csr[] = {};
+
+const interrupt_cause_t implemented_interrupt[] = {
+    M_EXTERNAL_INTR
+};
+
+const exception_cause_t implemented_exception[] = {
+    ILLEGAL_INSTRUCTION
+};
