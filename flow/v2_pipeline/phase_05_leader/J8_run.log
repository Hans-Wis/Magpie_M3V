    assign wb_take_irq = ex_wb_valid_r && irq_pending && !ex_wb_illegal_r && !wb_take_data_trap && !mem_stall;
                           (ex_wb_is_misaligned_store_r ? `MCAUSE_STORE_ADDR_MISALIGNED :
    assign wb_trap_mtval  = ex_wb_alu_result_r;
    assign rfu_we      = ex_wb_valid_r && ex_wb_rd_we_r && !ex_wb_illegal_r && !wb_take_irq && !wb_take_data_trap && !mem_stall;
    assign rfu_wr_idx  = ex_wb_rd_idx_r;
    assign rfu_wr_data = wb_data;
