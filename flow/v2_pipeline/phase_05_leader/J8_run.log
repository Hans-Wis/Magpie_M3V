+parameter int VELEN = 2;
+parameter int MAX_LMUL = 8;
+
+parameter int NUM_HARTS = 1;
+
+const privileged_reg_t implemented_csr[] = {
+    MSTATUS,
+    MIE,
+    MTVEC,
+    MSCRATCH,
+    MEPC,
+    MCAUSE,
+    MIP,
+    MCYCLE,
+    MCYCLEH,
+    MINSTRET,
+    MINSTRETH
+};
+
+bit [11:0] custom_csr[] = {};
+
+const interrupt_cause_t implemented_interrupt[] = {
+    M_EXTERNAL_INTR
+};
+
+const exception_cause_t implemented_exception[] = {
+    ILLEGAL_INSTRUCTION
+};
