        .dbus_wstrb        (dbus_wstrb),
        .dbus_wdata        (dbus_wdata),
        .dbus_ready        (dbus_ready),
        .dbus_rdata        (dbus_rdata),
        .irq_external_pulse (1'b0),
        .dbg_pc            (dbg_pc),
        .dbg_instr         (dbg_instr),
        .dbg_state         (dbg_state)
