+    reg clk = 1'b0;
+    reg resetn = 1'b0;
+    integer imode = WAIT_MODE_3;
+    integer dmode = WAIT_MODE_1;
+    integer max_cycles = MAXC_DEFAULT;
+
+    wire        ibus_req;
+    wire [31:0] ibus_addr;
+    reg         ibus_ready;
+    reg  [31:0] ibus_rdata;
+
+    wire        dbus_req;
+    wire [31:0] dbus_addr;
+    wire        dbus_we;
+    wire [3:0]  dbus_wstrb;
+    wire [31:0] dbus_wdata;
