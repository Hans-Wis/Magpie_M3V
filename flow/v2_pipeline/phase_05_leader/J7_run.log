+            ilfsr      <= {ilfsr[14:0], ilfsr[15]^ilfsr[13]^ilfsr[12]^ilfsr[10]};
+            dlfsr      <= {dlfsr[14:0], dlfsr[15]^dlfsr[13]^dlfsr[12]^dlfsr[10]};
+        end
+    end
