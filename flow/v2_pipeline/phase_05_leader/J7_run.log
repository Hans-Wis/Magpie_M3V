+        end else if (!trap) begin
+            watchdog <= watchdog + 1;
+            if (dut.u_core.wb_instr_retired && !dut.u_core.ex_wb_illegal_r) commit_count <= commit_count + 1;
+            if (dut.u_core.mem_stall) begin
