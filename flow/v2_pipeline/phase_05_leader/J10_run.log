+                        imm = ((instr >> 3) & 0x3) << 7 | ((instr >> 5) & 0x1) << 6 | ((instr >> 2) & 0x1) << 5 | ((instr >> 6) & 0x1) << 4 | ((instr >> 12) & 0x1) << 9
+                        return _u32(norm_regs[2] + _sext(imm, 10))
+                    return _u32(_sext(((instr >> 2) & 0x1F) | ((instr >> 7) & 0x20), 6) << 12)
+                if funct3 == 0x2:
