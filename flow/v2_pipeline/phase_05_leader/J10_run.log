+                return _u32(norm_regs[2] + imm)
+            if op == 0x1:
+                if funct3 == 0x0:
+                    return _u32(norm_regs[rd] + _sext((instr >> 2) & 0x1F | ((instr >> 7) & 0x20), 6))
+                if funct3 == 0x3:
