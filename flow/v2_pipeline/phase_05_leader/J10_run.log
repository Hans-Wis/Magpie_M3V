+            if funct3 == 2:
+                return 1 if _s32(a) < imm_i else 0
+            if funct3 == 3:
+                return 1 if (a & 0xFFFF_FFFF) < (imm_i & 0xFFFF_FFFF) else 0
+            if funct3 == 4:
+                return _u32(a ^ imm_i)
+            if funct3 == 6:
