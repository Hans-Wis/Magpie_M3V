--- a/flow/v2_pipeline/lib/spike_commit.py
+++ b/flow/v2_pipeline/lib/spike_commit.py
@@ -73,6 +73,56 @@
     """Parse Spike commit log and normalize PC/writeback addresses to DUT base."""
     stop_instrs = stop_instrs or set()
     rows: list[Commit] = []
+    addr_taint = [False] * 32
+
+    def _rs1(instr: int) -> int:
+        return (instr >> 15) & 0x1F
+
+    def _rs2(instr: int) -> int:
+        return (instr >> 20) & 0x1F
+
+    def _c_rd(instr: int) -> int:
+        return (instr >> 7) & 0x1F
+
+    def _c_rs2(instr: int) -> int:
+        return (instr >> 2) & 0x1F
+
+    def _c_rd_p(instr: int) -> int:
+        return 8 + ((instr >> 7) & 0x7)
+
+    def _c_rs2_p(instr: int) -> int:
+        return 8 + ((instr >> 2) & 0x7)
+
+    def _next_taint(instr: int, rd: int) -> bool:
+        if rd == 0:
+            return False
+        if (instr & 0x3) != 0x3:
+            funct3 = (instr >> 13) & 0x7
+            op = instr & 0x3
+            if op == 0x1:
+                if funct3 in (0x0, 0x3):
+                    return addr_taint[_c_rd(instr)]  # C.ADDI/C.ADDI16SP; C.LUI is untainted when rd!=x2.
+                if funct3 == 0x2:
+                    return False  # C.LI
+                if funct3 == 0x4 and ((instr >> 10) & 0x3) == 0x3:
+                    return addr_taint[_c_rd_p(instr)] or addr_taint[_c_rs2_p(instr)]
+            if op == 0x2 and funct3 == 0x4:
+                return addr_taint[_c_rs2(instr)] if ((instr >> 12) & 0x1) == 0 else (
+                    addr_taint[_c_rd(instr)] or addr_taint[_c_rs2(instr)]
+                )
+            return False
+
+        opcode = instr & 0x7F
+        if opcode == 0x17:  # AUIPC
+            return True
+        if opcode in (0x13, 0x67, 0x03):  # OP-IMM/JALR/LOAD
+            return addr_taint[_rs1(instr)]
+        if opcode == 0x33:  # OP
+            return addr_taint[_rs1(instr)] or addr_taint[_rs2(instr)]
+        if opcode == 0x6F:  # JAL link value is PC-relative.
+            return True
+        return False
+
     for line in log.read_text(encoding="utf-8", errors="replace").splitlines():
         match = COMMIT_RE.search(line)
         if not match:
@@ -87,8 +137,11 @@
             break
         rd = int(match.group("rd") or "0")
         wdata = int(match.group("wdata") or "0", 16)
-        if normalize_wdata_base and pc_base <= wdata < pc_base + normalize_window:
+        tainted = _next_taint(instr, rd)
+        if normalize_wdata_base and tainted and pc_base <= wdata < pc_base + normalize_window:
             wdata -= pc_base
+        if rd != 0:
+            addr_taint[rd] = tainted
         rows.append({"idx": len(rows), "pc": pc, "instr": instr, "rd": rd, "wdata": wdata})
         if len(rows) >= limit:
             break

