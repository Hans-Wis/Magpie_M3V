+            sa = _s32(a)
+            sb = _s32(b)
+            quot = (abs(sa) // abs(sb)) * (-1 if (sa < 0) ^ (sb < 0) else 1)
+            return _u32(sa - quot * sb)
+        return _u32((a & 0xFFFF_FFFF) % (b & 0xFFFF_FFFF))
+
+    def _eval_norm_wdata(instr: int, pc: int, rd: int, raw_wdata: int) -> int:
+        if rd == 0:
+            return 0
+        if (instr & 0x3) != 0x3:
+            funct3 = (instr >> 13) & 0x7
+            op = instr & 0x3
+            if op == 0x0 and funct3 == 0x0:
