   description: >
-    cpu_m1 RV32IMC riscv-dv pyflow arithmetic/compressed/M stream.
-    Memory, branches, fences, CSR randomization, traps, interrupts, A/F/D/V,
-    unaligned accesses, and unsupported privileged behavior are excluded.
+    cpu_m1 RV32IMC riscv-dv pyflow arithmetic/compressed/M plus load/store
+    and branch/jump stream. Fences, CSR randomization, traps, interrupts,
+    A/F/D/V, unaligned accesses, and unsupported privileged behavior are
+    excluded.
   iterations: 1
   gen_test: riscv_instr_base_test
   gen_opts: >
     --instr_cnt=4000
     --num_of_sub_program=0
     --no_fence=1
-    --no_data_page=1
-    --no_load_store=1
-    --no_branch_jump=1
+    --no_data_page=0
     --no_csr_instr=1
     --no_ebreak=1
+    --enable_unaligned_load_store=0
+    --enable_misaligned_instr=0
     --bare_program_mode=1
     --boot_mode=m
   rtl_test: core_base_test
