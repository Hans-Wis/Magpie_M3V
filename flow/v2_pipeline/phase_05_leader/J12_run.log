    reg [ 2:0] ex_wb_wb_sel_r;
    reg        ex_wb_is_load_r;
    /* verilator lint_off UNUSEDSIGNAL */
    reg        ex_wb_is_store_r;   // store 在 MEM 已 commit 到 d-port，WB 不用
    /* verilator lint_on UNUSEDSIGNAL */
    reg        ex_wb_is_misaligned_r;
