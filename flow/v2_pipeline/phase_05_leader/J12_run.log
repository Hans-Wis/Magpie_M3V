            ex_mem_is_misaligned_store_r <= 1'b0;
            ex_mem_csr_we_r          <= 1'b0;
            ex_mem_is_branch_taken_r <= 1'b0;
            ex_mem_is_jal_r          <= 1'b0;
            ex_mem_is_jalr_r         <= 1'b0;
            ex_mem_illegal_r         <= 1'b0;
