        .em_rd_we     (ex_mem_rd_we_r),
        .em_rd_idx    (ex_mem_rd_idx_r),
        .em_is_load   (ex_mem_is_load_r),
        .wb_valid     (ex_wb_valid),
        .wb_rd_we     (ex_wb_rd_we),
        .wb_rd_idx    (ex_wb_rd_idx),

