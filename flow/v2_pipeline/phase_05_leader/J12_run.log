-    unaligned accesses, and unsupported privileged behavior are excluded.
+    cpu_m1 RV32IC riscv-dv pyflow arithmetic/compressed plus load/store
+    and branch/jump stream. Fences, CSR randomization, traps, interrupts,
+    M/A/F/D/V, unaligned accesses, and unsupported privileged behavior are
+    excluded for this J12 wave.
   iterations: 1
   gen_test: riscv_instr_base_test
   gen_opts: >
     --instr_cnt=4000
     --num_of_sub_program=0
     --no_fence=1
-    --no_data_page=1
