   331	def run_one(seed: int, instr_cnt: int, max_cycles: int) -> tuple[int, bool, str]:
   332	    work = ROOT / "runs" / f"seed_{seed}"
   333	    if work.exists():
   334	        shutil.rmtree(work)
   335	    work.mkdir(parents=True)
   336	    src = generate_seed(seed, work, instr_cnt)
   337	    adapt_asm(src, work / "firmware.S")
   338	    build_firmware(work)
   339	    run_dut(work, max_cycles)
   340	    dut = parse_dut_commits(work / "dut_commit.trace")
   341	    # Terminal alignment: the program ends by writing `tohost`; Spike (HTIF) stops
   342	    # exactly there, but the DUT TB keeps looping at `write_tohost` until its own
   343	    # terminal, inflating the DUT commit count. Truncate the DUT trace at the first
   344	    # entry into `write_tohost` so both end at the SAME program point. This is NOT
   345	    # masking: compare_commits still checks every commit up to that shared exit, and
   346	    # a real divergence before exit (or one that prevents reaching write_tohost) is
   347	    # still caught.
   348	    _wt = elf_symbol(work, "write_tohost")
   349	    if _wt is not None:
   350	        for _i, _c in enumerate(dut):
   351	            if _c["pc"] == _wt:
   352	                dut = dut[:_i + 2]  # keep the auipc + the tohost store, drop the loop
   353	                break
   354	    # Spike --instructions budget must be GENEROUS, not len(dut)+32: around a
   355	    # synchronous trap Spike executes setup + handler instructions whose count
   356	    # does not match the DUT commit count, so a tight budget truncates Spike
   357	    # right at the trap (looked like "Spike halts at ecall"). The program exits
   358	    # naturally via the tohost write, so a large cap is safe; we still compare
   359	    # only the first len(dut) commits below.
   360	    run_spike(work, len(dut) * 8 + 20000)
   361	    spike = parse_spike_commits(
   362	        work / "spike.log",
   363	        limit=len(dut),
   364	        pc_base=0,
   365	        stop_instrs=set(),
   366	        normalize_wdata_base=False,
   367	    )
   368	    write_commit_csv(work / "spike_commit.trace", spike)
   369	    ok, message = compare_commits(dut, spike, label=f"riscv-dv seed {seed}")
   370	    trap_count = 0
   371	    trap_path = work / "dut_trap.trace"
   372	    if trap_path.exists():
   373	        with trap_path.open(newline="", encoding="utf-8") as fh:
   374	            trap_count = sum(1 for row in csv.DictReader(fh) if row.get("event") == "enter")
   375	    if not ok:
   376	        div = write_divergence(seed, work, message)
   377	        return len(dut), False, f"{message}; divergence={div}"
   378	    return len(dut), True, f"{message}; sync_traps={trap_count}"
