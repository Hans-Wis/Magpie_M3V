+        int(drow["pc"]) == int(srow["pc"])
+        and int(drow["instr"]) == int(srow["instr"])
+        and int(drow["mcause"]) == int(srow["cause"])
+        and int(drow["mtval"]) == int(srow["mtval"])
+    )
+    if not same:
