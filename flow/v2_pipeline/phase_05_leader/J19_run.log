   243	def elf_symbol(work: Path, name: str) -> int:
   244	    proc = subprocess.run([NM, "-n", "firmware.elf"], cwd=work, text=True, capture_output=True, check=True)
   245	    for line in proc.stdout.splitlines():
   246	        parts = line.split()
   247	        if len(parts) >= 3 and parts[2] == name:
   248	            return int(parts[0], 16)
   249	    raise RuntimeError(f"missing ELF symbol {name}")
