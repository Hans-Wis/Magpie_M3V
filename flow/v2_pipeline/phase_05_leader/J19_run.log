   317	        "message": message,
   318	        "mismatch_index": idx,
   319	        "dut": dut_rows[idx] if idx < len(dut_rows) else None,
   320	        "spike": spike_rows[idx] if idx < len(spike_rows) else None,
   321	        "last_20_dut": dut_rows[context_start:idx],
   322	        "last_20_spike": spike_rows[context_start:idx],
   323	        "repro": str(work),
   324	    }
   325	    (div_dir / f"seed_{seed}_divergence.json").write_text(json.dumps(detail, indent=2), encoding="utf-8")
   326	    shutil.copy2(work / "firmware.S", div_dir / f"seed_{seed}_firmware.S")
   327	    shutil.copy2(work / "firmware.disasm", div_dir / f"seed_{seed}_firmware.disasm")
   328	    return div_dir / f"seed_{seed}_divergence.json"
