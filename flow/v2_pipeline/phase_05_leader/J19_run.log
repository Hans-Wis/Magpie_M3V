   252	def emit_verilog_hex(binary: Path, hex_path: Path) -> None:
   253	    data = binary.read_bytes()
   254	    if len(data) % 4:
   255	        data += b"\x00" * (4 - (len(data) % 4))
   256	    lines = []
   257	    for offset in range(0, len(data), 4):
   258	        word = int.from_bytes(data[offset:offset + 4], "little")
   259	        lines.append(f"{word:08x}\n")
   260	    hex_path.write_text("".join(lines), encoding="utf-8")
