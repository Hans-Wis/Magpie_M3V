+            epc = int(exc_match.group(2), 16)
+            instr = last_instr[1] if last_instr and last_instr[0] == epc else 0
+            pending = {"pc": epc, "instr": instr, "cause": TRAP_CAUSES.get(name, -1), "name": name, "mtval": 0}
+            rows.append(pending)
