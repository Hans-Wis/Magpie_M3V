+def trap_rows(path: Path) -> list[dict[str, int | str]]:
+    if not path.exists():
+        return []
+    rows: list[dict[str, int | str]] = []
+    with path.open(newline="", encoding="utf-8") as fh:
+        for row in csv.DictReader(fh):
+            rows.append({
