   125	    lines = src.read_text(encoding="utf-8").splitlines()
   126	    out: list[str] = []
   127	    inserted = False
   128	    in_test_done = False
   129	    in_ecall_handler = False
   130	    patched_resume = False
   131	    skip_old_advance = 0
   132	    cause_reg = "x6"
   133	    tmp_reg = "x15"
   134	    for line in lines:
   135	        if skip_old_advance:
   136	            skip_old_advance -= 1
   137	            continue
   138	        if line.strip().startswith("test_done:"):
   139	            in_test_done = True
   140	        elif in_test_done and line.strip() == "ecall":
   141	            out.append("                  j write_tohost")
   142	            in_test_done = False
   143	            continue
   144	        elif in_test_done and line and not line.startswith(" "):
   145	            in_test_done = False
   146	        if line.strip().startswith("ecall_handler:"):
   147	            out.append(line)
   148	            out.append("                  j j18_resume_trap_handler")
   149	            in_ecall_handler = True
   150	            continue
   151	        if in_ecall_handler:
   152	            if line.strip().startswith("illegal_instr_handler:"):
   153	                in_ecall_handler = False
   154	            else:
   155	                continue
   156	        cause_match = re.search(r"csrr\s+(x\d+),\s+0x342\s+# MCAUSE", line)
   157	        if cause_match:
   158	            cause_reg = cause_match.group(1)
   159	        if "li x" in line and "# ILLEGAL_INSTRUCTION" in line:
   160	            tmp_match = re.search(r"li\s+(x\d+),", line)
   161	            if tmp_match:
   162	                tmp_reg = tmp_match.group(1)
   163	            out.extend([
   164	                f"                  li {tmp_reg}, 0x3 # BREAKPOINT",
   165	                f"                  beq {cause_reg}, {tmp_reg}, j18_resume_trap_handler",
   166	                f"                  li {tmp_reg}, 0x4 # LOAD_ADDRESS_MISALIGNED",
   167	                f"                  beq {cause_reg}, {tmp_reg}, j18_resume_trap_handler",
   168	                f"                  li {tmp_reg}, 0x6 # STORE_ADDRESS_MISALIGNED",
   169	                f"                  beq {cause_reg}, {tmp_reg}, j18_resume_trap_handler",
   170	            ])
   171	        if line.strip().startswith("illegal_instr_handler:") and not patched_resume:
   172	            out.append(line)
   173	            out.append("j18_resume_trap_handler:")
   174	            patched_resume = True
   175	            continue
   176	        if patched_resume and line.strip().startswith("csrr  x") and "0x341" in line:
   177	            out.extend([
   178	                "                  csrr  x6, 0x341",
   179	                "                  lhu   x15, 0(x6)",
   180	                "                  andi  x15, x15, 3",
   181	                "                  li    x31, 3",
   182	                "                  bne   x15, x31, 1f",
   183	                "                  addi  x6, x6, 4",
   184	                "                  j     2f",
   185	                "1:                addi  x6, x6, 2",
   186	                "2:                csrw  0x341, x6",
   187	            ])
   188	            skip_old_advance = 2
   189	            patched_resume = False
   190	            continue
   191	        out.append(line)
   192	        if not inserted and line.strip().startswith("main:"):
   193	            out.extend([
   194	                "                  # M1 J18 synchronous-trap smoke stream",
   195	                "                  ecall",
   196	                "                  ebreak",
   197	                "                  .word 0x00000000",
   198	                "                  la x5, j18_misalign_data",
   199	                "                  lw x6, 1(x5)",
   200	                "                  sw x6, 2(x5)",
   201	                "                  # M1 J14 supported-CSR lockstep sweep",
   202	                "                  csrr x5, 0x300",
   203	                "                  csrrw x6, 0x340, x5",
   204	                "                  csrr x5, 0x340",
   205	                "                  csrrs x6, 0x300, x0",
   206	                "                  csrrc x6, 0x304, x0",
   207	                "                  csrr x6, 0x305",
   208	                "                  csrr x6, 0x341",
   209	                "                  csrr x6, 0x342",
   210	                "                  csrr x6, 0x343",
   211	                "                  csrr x6, 0x344",
   212	                "                  csrr x6, 0xc00",
   213	                "                  csrr x6, 0xc80",
   214	                "                  csrr x6, 0xc02",
   215	                "                  csrr x6, 0xc82",
   216	                "                  csrrw x6, 0x340, x0",
   217	            ])
   218	            inserted = True
   219	        if line.strip() == ".section .data":
   220	            out.extend([
   221	                ".align 2",
   222	                "j18_misalign_data:",
   223	                ".word 0x11223344",
   224	            ])
   225	    dst.write_text("\n".join(out) + "\n", encoding="utf-8")
