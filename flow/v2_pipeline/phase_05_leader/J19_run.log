+        and int(drow["mcause"]) == int(srow["cause"])
+        and int(drow["mtval"]) == int(srow["mtval"])
+    )
+    if not same:
+        return None
+    return {
+        "matched_commits": prefix_len,
+        "dut_idx": int(drow["idx"]),
+        "pc": int(drow["pc"]),
+        "instr": int(drow["instr"]),
+        "mcause": int(drow["mcause"]),
