+        return None
+    prefix_ok, _ = compare_commits(dut[:len(spike)], spike, label="nested-trap prefix")
+    if not prefix_ok:
+        return None
+    expected_idx = dut[len(spike)]["idx"]
+    for srow in reversed(spike_exceptions(work / "spike.log")):
