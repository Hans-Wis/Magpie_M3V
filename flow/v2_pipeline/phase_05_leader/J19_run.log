+    return {
+        "matched_commits": prefix_len,
+        "dut_idx": int(drow["idx"]),
+        "pc": int(drow["pc"]),
+        "instr": int(drow["instr"]),
+        "mcause": int(drow["mcause"]),
+        "mtval": int(drow["mtval"]),
+        "spike_exception": str(srow["name"]),
+    }
