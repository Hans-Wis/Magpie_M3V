+                "event": row["event"],
+                "pc": int(row["pc"], 16),
+                "instr": int(row["instr"], 16),
+                "mepc": int(row["mepc"], 16),
+                "mcause": int(row["mcause"], 16),
+                "mtval": int(row["mtval"], 16),
+                "mstatus": int(row["mstatus"], 16),
+            })
+    return rows
