+.option push
+.option norvc
+    la   t0, trap_handler
+    csrw mtvec, t0
+    la   a0, data_area
+
+    lb   a1, 0(a0)
+    sb   a1, 3(a0)
+    lw   a2, 1(a0)
+    lh   a3, 1(a0)
+    li   a4, 0x123
+    sh   a4, 1(a0)
+done:
