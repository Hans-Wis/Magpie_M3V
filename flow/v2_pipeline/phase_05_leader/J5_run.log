+
+    .balign 4
+    .org 0x100
+.option push
+.option norvc
+.global mtvec_handler
+mtvec_handler:
+    csrr t1, mepc
+    sw   t1, 16(s0)
+    csrr t1, mcause
+    sw   t1, 20(s0)
+    csrr t1, mstatus
+    sw   t1, 24(s0)
+    mret
+.option pop
