+    csrrw zero, mepc, t0
+    li   t0, 0x55
+    csrrw zero, mcause, t0
+
+    li   t0, (1 << 11)
+    csrrs zero, mie, t0
+    li   t0, (1 << 3)
+    csrrs zero, mstatus, t0
+
+    j    irq_target
+
+    .org 0x80
