+    c.addi s1, 1
+after_irq:
+    c.li   s2, 2
+.option pop
+
+    li   t1, 0x600d
+    sw   t1, 28(s0)
+done:
+    ebreak
+
+    .balign 4
+    .org 0x100
+.option push
+.option norvc
+.global mtvec_handler
+mtvec_handler:
+    csrr t1, mepc
+    sw   t1, 16(s0)
+    csrr t1, mcause
+    sw   t1, 20(s0)
+    csrr t1, mstatus
+    sw   t1, 24(s0)
+    mret
+.option pop
