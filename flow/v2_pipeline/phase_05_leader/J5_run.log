`include "def.vh"

module cpu_m1_func_cov_observer (
    input         clk,
    input         resetn,
    input         stall,
    input         fetch_stall,
    input         mem_stall,
    input         pc_redirect,
    input         id_advance_to_ex_mem,
    input         ex_mem_advance_to_wb,
