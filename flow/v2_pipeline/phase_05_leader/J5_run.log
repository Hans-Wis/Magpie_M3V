+.section .init
+.global _start
+
+.option push
+.option norvc
+_start:
+    lui  sp, %hi(16*1024)
+    addi sp, sp, %lo(16*1024)
+
+    fence
+
+    li   t0, 1
+    li   t1, 1
+    beq  t0, t1, beq_taken
+    addi s0, zero, -1
+beq_taken:
+    bne  t0, t1, bne_not_taken_bad
+    addi s0, zero, 1
+bne_not_taken_bad:
+
