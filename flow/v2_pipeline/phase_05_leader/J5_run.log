--- /dev/null
+++ b/flow/v2_pipeline/phase_04_08_functional_coverage/stim_branch_bp_ras.S
@@ -0,0 +1,74 @@
+.section .init
+.global _start
+
+.option push
+.option norvc
+_start:
+    lui  sp, %hi(16*1024)
+    addi sp, sp, %lo(16*1024)
+
+    fence
+
+    li   t0, 1
+    li   t1, 1
+    beq  t0, t1, beq_taken
+    addi s0, zero, -1
+beq_taken:
+    bne  t0, t1, bne_not_taken_bad
+    addi s0, zero, 1
+bne_not_taken_bad:
+
+    li   t2, -1
+    li   t3, 2
+    blt  t2, t3, blt_taken
+    addi s1, zero, -1
+blt_taken:
+    bge  t2, t3, bge_not_taken_bad
+    addi s1, zero, 2
+bge_not_taken_bad:
+
+    li   t4, 3
+    li   t5, 4
+    bltu t4, t5, bltu_taken
+    addi s2, zero, -1
+bltu_taken:
+    bgeu t4, t5, bgeu_not_taken_bad
+    addi s2, zero, 3
+bgeu_not_taken_bad:
+
+    li   a0, 0
+    li   a1, 20
+bp_train_loop:
+    addi a0, a0, 1
+    blt  a0, a1, bp_train_loop
+
+    jal  ra, func_a
+    la   t0, jalr_target
+    jalr ra, 0(t0)
+after_jalr:
+    ebreak
+
+jalr_target:
+    addi s3, zero, 4
+    jalr zero, 0(ra)
+
+func_a:
+    addi sp, sp, -16
+    sw   ra, 12(sp)
+    jal  ra, func_b
+    lw   ra, 12(sp)
+    addi sp, sp, 16
+    ret
+
+func_b:
+    addi sp, sp, -16
+    sw   ra, 12(sp)
+    jal  ra, func_c
+    lw   ra, 12(sp)
+    addi sp, sp, 16
+    ret
+
+func_c:
+    addi s4, zero, 5
+    ret
+.option pop
diff --git a/flow/v2_pipeline/phase_04_08_functional_coverage/stim_csr_irq.S b/flow/v2_pipeline/phase_04_08_functional_coverage/stim_csr_irq.S
new file mode 100644
index 0000000000000000000000000000000000000000..3f5a30448740bd36c560229b5cb52ef407817fb4
--- /dev/null
+++ b/flow/v2_pipeline/phase_04_08_functional_coverage/stim_csr_irq.S
@@ -0,0 +1,62 @@
+.section .init
+.global _start
+
+_start:
+    lui  sp, %hi(16*1024)
+    addi sp, sp, %lo(16*1024)
+
+    li   s0, 0x10000000
+    la   t0, mtvec_handler
+    csrrw t1, mtvec, t0
+
+    li   t0, 0x12345678
+    csrrw t1, mscratch, t0
+    sw   t1, 0(s0)
+    li   t0, 0x0000000f
+    csrrs t1, mscratch, t0
+    sw   t1, 4(s0)
+    li   t0, 0x00000008
+    csrrc t1, mscratch, t0
+    sw   t1, 8(s0)
+
+    li   t0, 0x44
+    csrrw zero, mepc, t0
+    li   t0, 0x55
+    csrrw zero, mcause, t0
+
+    li   t0, (1 << 11)
+    csrrs zero, mie, t0
+    li   t0, (1 << 3)
+    csrrs zero, mstatus, t0
+
+    j    irq_target
+
+    .org 0x80
+.option push
+.option rvc
+.global irq_target
+irq_target:
+    c.addi s1, 1
+after_irq:
+    c.li   s2, 2
+.option pop
+
+    li   t1, 0x600d
+    sw   t1, 28(s0)
+done:
+    ebreak
+
+    .balign 4
+    .org 0x100
+.option push
+.option norvc
+.global mtvec_handler
+mtvec_handler:
+    csrr t1, mepc
+    sw   t1, 16(s0)
+    csrr t1, mcause
+    sw   t1, 20(s0)
+    csrr t1, mstatus
+    sw   t1, 24(s0)
+    mret
+.option pop
