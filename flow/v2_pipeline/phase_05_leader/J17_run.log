.section .init
.global _start

_start:
    /* Set stack to top of the 16 KB test memory. */
    lui  sp, %hi(16*1024)
    addi sp, sp, %lo(16*1024)

    /* mtvec direct mode -> handler at 0x100. */
    la   t0, mtvec_handler
    csrw mtvec, t0

    /* Enable machine external interrupt and global MIE. */
    li   t0, (1 << 11)
    csrs mie, t0
    li   t0, (1 << 3)
    csrs mstatus, t0

    /* Jump to a fixed 16-bit instruction target. */
    j    irq_target

    .org 0x80
.option push
.option rvc
.global irq_target
irq_target:
