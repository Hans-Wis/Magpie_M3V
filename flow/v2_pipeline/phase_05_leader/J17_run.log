            ex_wb_rd_we_r           <= 1'b0;
            ex_wb_wb_sel_r          <= 3'h0;
            ex_wb_is_load_r         <= 1'b0;
            ex_wb_is_store_r        <= 1'b0;
            ex_wb_is_misaligned_r       <= 1'b0;
