--- a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v
+++ b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v
@@ -680,7 +680,7 @@
     reg        ex_wb_is_ebreak_r;
     reg [31:0] ex_wb_instr_r;
     wire       wb_take_irq;
-    wire [31:0] wb_sync_exception_pc = ex_wb_pc_r - 32'd4;
