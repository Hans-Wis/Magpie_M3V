    reg [ 2:0] ex_wb_ls_funct3_r;
    reg [ 1:0] ex_wb_addr_lo_r;
    reg        ex_wb_is_mret_r;
    reg        ex_wb_csr_we_r;
    reg [11:0] ex_wb_csr_addr_r;
