+
+    .org 0x8c
+    c.nop
+.global illegal32_half
+illegal32_half:
+    .word 0xffff_ffff
+
+    .org 0x98
+.global illegal16
+illegal16:
+    .2byte 0x0000
+
+    .org 0xa0
+.global ebreak32
+ebreak32:
+    ebreak
+
+    .org 0xa8
+.global misaligned_lw
+misaligned_lw:
+    lw   x9, 1(x5)
+
+    .balign 4
+trap_vector:
+    la   x10, event_count
+    lw   x11, 0(x10)
+    li   x12, 0x10000000
+    slli x13, x11, 4
+    add  x12, x12, x13
+
+    csrr x14, mepc
+    sw   x14, 0(x12)
+    csrr x14, mcause
+    sw   x14, 4(x12)
+    csrr x14, mtval
+    sw   x14, 8(x12)
+
+    la   x15, resume_table
+    slli x16, x11, 2
+    add  x15, x15, x16
+    lw   x14, 0(x15)
+    addi x11, x11, 1
+    sw   x11, 0(x10)
+    csrw mepc, x14
+    mret
+    .option pop
+
+    .balign 4
+resume_table:
+    .word resume_illegal32_aligned
+    .word resume_illegal32_half
+    .word resume_illegal16
+    .word resume_ebreak32
