         "ex_wb_is_jal_r          ? ex_wb_pc_plus_imm_r :",
         "ex_wb_is_jalr_r         ? (ex_wb_alu_result_r & ~32'd1) :",
diff --git a/tests/gates/gate_02_03_mepc_directed.py b/tests/gates/gate_02_03_mepc_directed.py
new file mode 100644
