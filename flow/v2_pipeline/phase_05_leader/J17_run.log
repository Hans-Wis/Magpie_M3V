+.section .init
+.global _start
+
+_start:
+    .option push
+    .option norvc
+    lui  x8, %hi(0x10000000)
+
+    li   x5, 0x00000083
+    csrw mepc, x5
+    csrr x6, mepc
+    sw   x6, 0x200(x8)
+
+    la   x5, trap_vector
+    csrw mtvec, x5
+    la   x5, data_area
+
+    j    illegal32_aligned
+resume_illegal32_aligned:
+    j    illegal32_half
+resume_illegal32_half:
+    j    illegal16
+resume_illegal16:
+    j    ebreak32
+resume_ebreak32:
+    j    misaligned_lw
+resume_misaligned_lw:
+    li   x6, 0x600d
+    sw   x6, 0x100(x8)
+done:
