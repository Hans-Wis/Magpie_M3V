    //   RAS 預測對且 target 也對：mem_ras_mispredict=0、ex_mem_mispredict_r=0 → 不 redirect，
    //   pipeline 順利往下走（IF 階段已從 RAS target fetch 完成）。
    always @* begin
        pc_redirect     = 1'b0;
