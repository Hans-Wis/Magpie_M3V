+SECTIONS
+{
+  . = ORIGIN(rom);
+  .text : { *(.init) *(.text*) } > rom
+  .rodata : { *(.rodata*) } > rom
+  .data : { *(.data*) } > rom
+  .bss : { *(.bss*) *(COMMON) } > rom
+}
