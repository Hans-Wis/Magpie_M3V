diff --git a/tests/gates/gate_02_02_misalign_trap.py b/tests/gates/gate_02_02_misalign_trap.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea298fc1781d39f7dda0e25cd77da89c16937b37
--- /dev/null
+++ b/tests/gates/gate_02_02_misalign_trap.py
@@ -0,0 +1,84 @@
+"""gate_02_02_misalign_trap - directed misaligned load/store trap gate."""
+
+from __future__ import annotations
+
+import csv
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+PHASE = ROOT / "flow/v2_pipeline/phase_02_02_misalign"
+
+
+def _read(path: Path) -> str:
+    return path.read_text(encoding="utf-8", errors="replace")
+
+
+def _rows(path: Path) -> list[dict[str, str]]:
+    with path.open(newline="", encoding="utf-8") as fh:
+        return list(csv.DictReader(fh))
+
+
+def test_phase_02_02_rebuild_run_and_spike_compare():
+    res = subprocess.run(["make", "-C", str(PHASE), "clean", "all"], capture_output=True, text=True)
+    out = res.stdout + res.stderr
+    assert res.returncode == 0, out[-4000:]
+    assert "PASS: misalign trap observed 3 precise traps" in out
+    assert "PASS: Spike trap-on-misaligned observed lw:mcause=4" in out
+
+
+def test_phase_02_02_artifacts_and_firmware_intent():
+    for name in [
+        "Makefile",
+        "firmware.S",
+        "firmware.lds",
+        "firmware_spike.lds",
+        "tb_misalign_trap.v",
+        "spike_misalign.py",
+        "firmware.hex",
+        "firmware.disasm",
+        "sim.log",
+        "spike_lw.log",
+        "spike_lh.log",
+        "spike_sh.log",
+        "misalign_events.csv",
+        "misalign_trap.log",
+    ]:
+        path = PHASE / name
+        assert path.is_file(), f"missing artifact: {name}"
+        assert path.stat().st_size > 0, f"empty artifact: {name}"
+
+    source = _read(PHASE / "firmware.S")
+    for needle in ["lb   x12, 0(x10)", "sb   x13, 0(x10)", "lw   x15, 1(x10)", "lh   x16, 1(x10)", "sh   x17, 1(x10)"]:
+        assert needle in source
+
+
+def test_phase_02_02_observed_mcause_mtval_and_no_bad_dbus():
+    rows = _rows(PHASE / "misalign_events.csv")
+    assert len(rows) == 3
+    expected = [
+        ("load", "00000004"),
+        ("load", "00000004"),
+        ("store", "00000006"),
+    ]
+    mtvals = {row["mtval"] for row in rows}
+    assert len(mtvals) == 1
+    assert next(iter(mtvals)) != "00000000"
+    for row, (kind, mcause) in zip(rows, expected):
+        assert row["kind"].strip() == kind
+        assert row["mcause"] == mcause
+        assert int(row["mtval"], 16) & 0x3 == 1
+
+    sim_log = _read(PHASE / "sim.log")
+    assert "MARK aligned_byte_no_trap" in sim_log
+    assert "FAIL: misaligned DBUS request" not in sim_log
+    assert "no misaligned DBUS request" in sim_log
+
+
+def test_phase_02_02_spike_was_trap_on_misaligned():
+    checker = _read(PHASE / "spike_misalign.py")
+    assert '"--misaligned"' not in checker.split("cmd = [", 1)[1].split("]", 1)[0]
+    assert "trap_load_address_misaligned" in _read(PHASE / "spike_lw.log")
+    assert "trap_load_address_misaligned" in _read(PHASE / "spike_lh.log")
+    assert "trap_store_address_misaligned" in _read(PHASE / "spike_sh.log")
diff --git a/tests/gates/gate_03_08_lockstep_revalidate.py b/tests/gates/gate_03_08_lockstep_revalidate.py
new file mode 100644
index 0000000000000000000000000000000000000000..6da54cd0e6f2cc1bf57a6ae43060e4b291b7acb4
--- /dev/null
+++ b/tests/gates/gate_03_08_lockstep_revalidate.py
@@ -0,0 +1,49 @@
+"""gate_03_08_lockstep_revalidate - rebuild and rerun Phase 3.5 lockstep."""
+
+from __future__ import annotations
+
+import csv
+import os
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+PHASE = ROOT / "flow/v2_pipeline/phase_03_05_random_lockstep"
+RTL = ROOT / "IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e"
+
+VFLAGS = (
+    "--binary -j 4 --trace --trace-depth 2 --trace-structs "
+    "--top-module tb_random_lockstep --timescale 1ns/1ns "
+    f"-I{RTL} -Wall -Wno-PROCASSINIT -Wno-DECLFILENAME "
+    "-Wno-TIMESCALEMOD -Wno-UNUSEDSIGNAL -Wno-SYNCASYNCNET -Wno-PINMISSING"
+)
+
+
+def _rows(path: Path) -> list[dict[str, str]]:
+    with path.open(newline="", encoding="utf-8") as fh:
+        return list(csv.DictReader(fh))
+
+
+def test_phase_03_08_rebuilds_current_rtl_and_reruns_lockstep():
+    core = RTL / "core.v"
+    before = (PHASE / "dut_commit.trace").stat().st_mtime_ns if (PHASE / "dut_commit.trace").exists() else 0
+    env = os.environ.copy()
+    res = subprocess.run(
+        ["make", "-C", str(PHASE), "clean", "all", f"VFLAGS={VFLAGS}"],
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+    out = res.stdout + res.stderr
+    assert res.returncode == 0, out[-5000:]
+    assert "--top-module tb_random_lockstep" in out
+    assert "-Wno-PINMISSING" in out
+    assert str(core) in out
+    assert (PHASE / "dut_commit.trace").stat().st_mtime_ns > before
+    assert "PASS: random lockstep matched" in out
+
+    dut = _rows(PHASE / "dut_commit.trace")
+    spike = _rows(PHASE / "spike_commit.trace")
+    assert len(dut) >= 80
+    assert dut == spike

diff --git a/flow/v2_pipeline/phase_02_02_misalign/Makefile b/flow/v2_pipeline/phase_02_02_misalign/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..6296effd432bb8684e8064d92f52fa9558f13ef6
--- /dev/null
+++ b/flow/v2_pipeline/phase_02_02_misalign/Makefile
@@ -0,0 +1,63 @@
+TOOLCHAIN_DIR    = /home/edauser/miniforge3/pkgs/riscv-tools-1.0.6-0_h1234567_g56c29e0/riscv-tools/bin
+TOOLCHAIN_PREFIX = $(TOOLCHAIN_DIR)/riscv64-unknown-elf-
+TOOLCHAIN_LIBS   = /home/edauser/miniforge3/pkgs/mpfr-4.2.2-he0a73b1_0/lib:/home/edauser/miniforge3/pkgs/gmp-6.3.0-hac33072_2/lib:/home/edauser/miniforge3/pkgs/mpc-1.4.0-he0a73b1_0/lib
+TOOLCHAIN_ENV    = LD_LIBRARY_PATH=$(TOOLCHAIN_LIBS)
+VERILATOR ?= /home/edauser/miniforge3/envs/magpie_claude/bin/verilator
+
+GCC_MARCH = rv32imc_zicsr_zifencei
+GCC_MABI  = ilp32
+RTL_DIR  = ../../../IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e
+RTL_SRCS = $(RTL_DIR)/rfu.v $(RTL_DIR)/alu.v $(RTL_DIR)/idu.v \
+           $(RTL_DIR)/ifu.v $(RTL_DIR)/lsu.v $(RTL_DIR)/csr.v \
+           $(RTL_DIR)/mul.v $(RTL_DIR)/div.v $(RTL_DIR)/forward.v \
+           $(RTL_DIR)/hazard.v $(RTL_DIR)/bp.v $(RTL_DIR)/ras.v \
+           $(RTL_DIR)/cdec.v $(RTL_DIR)/core.v $(RTL_DIR)/cpu_m1_top.v
+TB_RTL = tb_misalign_trap.v
+VFLAGS = --binary -j 4 --trace --trace-depth 2 --trace-structs \
+         --top-module tb_misalign_trap --timescale 1ns/1ns \
+         -I$(RTL_DIR) -Wall -Wno-PROCASSINIT -Wno-DECLFILENAME \
+         -Wno-TIMESCALEMOD -Wno-UNUSEDSIGNAL -Wno-SYNCASYNCNET \
+         -Wno-PINMISSING
+SIM_BIN = obj_dir/Vtb_misalign_trap
+
+all: misalign_trap.log
+
+firmware.elf: firmware.S firmware.lds
+	$(TOOLCHAIN_ENV) $(TOOLCHAIN_PREFIX)gcc -Os -march=$(GCC_MARCH) -mabi=$(GCC_MABI) \
+	    -nostartfiles -nostdlib -ffreestanding \
+	    -Wl,-Bstatic,-T,firmware.lds,--strip-debug -o $@ firmware.S
+
+firmware_spike.elf: firmware.S firmware_spike.lds
+	$(TOOLCHAIN_ENV) $(TOOLCHAIN_PREFIX)gcc -Os -march=$(GCC_MARCH) -mabi=$(GCC_MABI) \
+	    -nostartfiles -nostdlib -ffreestanding \
+	    -Wl,-Bstatic,-T,firmware_spike.lds,--strip-debug -o $@ firmware.S
+
+firmware.hex: firmware.elf
+	$(TOOLCHAIN_ENV) $(TOOLCHAIN_PREFIX)objcopy -O verilog --verilog-data-width=4 $< $@
+
+firmware.disasm: firmware.elf
+	$(TOOLCHAIN_ENV) $(TOOLCHAIN_PREFIX)objdump -d $< > $@
+
+$(SIM_BIN): $(TB_RTL) $(RTL_SRCS)
+	$(VERILATOR) $(VFLAGS) $(RTL_SRCS) $(TB_RTL)
+
+sim.log misalign_events.csv wave.vcd: $(SIM_BIN) firmware.hex firmware.disasm
+	./$(SIM_BIN) | tee sim.log
+	@grep -q '^PASS' sim.log || (echo "FAIL: sim did not report PASS" && exit 1)
+
+spike_misalign.log: firmware_spike.elf spike_misalign.py
+	python3 spike_misalign.py | tee spike_misalign.log
+	@grep -q '^PASS' spike_misalign.log || (echo "FAIL: Spike misalign check did not report PASS" && exit 1)
+
+misalign_trap.log: sim.log spike_misalign.log
+	@cat sim.log spike_misalign.log > $@
+	@grep -q '^PASS: misalign trap' sim.log
+	@grep -q '^PASS: Spike' spike_misalign.log
+
+clean:
+	rm -rf obj_dir wave.vcd sim.log firmware.elf firmware_spike.elf \
+	    firmware.hex firmware.disasm misalign_events.csv spike.log \
+	    spike_misalign.log misalign_trap.log spike_case_*.S \
+	    spike_case_*.elf spike_lw.log spike_lh.log spike_sh.log
+
+.PHONY: all clean
diff --git a/flow/v2_pipeline/phase_02_02_misalign/firmware.S b/flow/v2_pipeline/phase_02_02_misalign/firmware.S
new file mode 100644
index 0000000000000000000000000000000000000000..816247ecb6e4d61e861d1e6a254dfb0cf7adc9d6
--- /dev/null
+++ b/flow/v2_pipeline/phase_02_02_misalign/firmware.S
@@ -0,0 +1,47 @@
+.section .init
+.global _start
+_start:
+    .option push
+    .option norvc
+    la   x5, trap_handler
+    csrw mtvec, x5
+    la   x10, data_area
+    lui  x11, %hi(0x10001000)
+
+    /* Aligned byte accesses must not trap. */
+    lb   x12, 0(x10)
+    addi x13, zero, 0x5a
+    sb   x13, 0(x10)
+    addi x14, zero, 0x11
+    sw   x14, 0(x11)
+
+    /* Deliberate misaligned load word: mcause=4, mtval=data_area+1. */
+    lw   x15, 1(x10)
+    addi x14, zero, 0x22
+    sw   x14, 0(x11)
+
+    /* Deliberate misaligned load half: mcause=4, mtval=data_area+1. */
+    lh   x16, 1(x10)
+    addi x14, zero, 0x33
+    sw   x14, 0(x11)
+
+    /* Deliberate misaligned store half: mcause=6, mtval=data_area+1. */
+    addi x17, zero, 0x123
+    sh   x17, 1(x10)
+    addi x14, zero, 0x44
+    sw   x14, 0(x11)
+
+done:
+    ebreak
+
+trap_handler:
+    csrr x6, mepc
+    addi x6, x6, 4
+    csrw mepc, x6
+    mret
+    .option pop
+
+    .balign 4
+data_area:
+    .word 0x44332211
+    .word 0x88776655
