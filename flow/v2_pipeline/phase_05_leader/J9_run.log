diff --git a/docs/adr/0007-crossboundary-consecutive-32bit.md b/docs/adr/0007-crossboundary-consecutive-32bit.md
new file mode 100644
index 0000000000000000000000000000000000000000..c251e3a3252768292e92aae5b7d4077bb24788ca
