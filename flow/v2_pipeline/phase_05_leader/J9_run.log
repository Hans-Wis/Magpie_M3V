flow/v2_pipeline/phase_05_leader/J5_run.log:7488:// lab08d 加 cross_assemble/residue pre-fetch buffer：
flow/v2_pipeline/phase_05_leader/J5_run.log:7545:    //   2. 保存 residue ← cur_half_hi (= 32-bit instr 的前 16 bits)
flow/v2_pipeline/phase_05_leader/J5_run.log:7546:    //   3. 設定 cross_assemble
flow/v2_pipeline/phase_05_leader/J5_run.log:7547:    //   下一拍直接用 {i_mem_rdata[15:0], residue} assemble，0 cycle penalty。
flow/v2_pipeline/phase_05_leader/J5_run.log:7549:    // 只有在 upcoming_cross 前一拍有 stall/redirect 時才退回 at_cross_boundary 路徑
flow/v2_pipeline/phase_05_leader/J5_run.log:7573:    // Lab08e: residue-based pre-fetch (replaces wait_high + high_buf)
flow/v2_pipeline/phase_05_leader/J5_run.log:7574:    reg [15:0]  residue;        // saved high-half for upcoming cross-boundary assemble
flow/v2_pipeline/phase_05_leader/J5_run.log:7575:    reg         cross_assemble; // 1 = this cycle: assemble {i_mem_rdata[15:0], residue}
flow/v2_pipeline/phase_05_leader/J5_run.log:7585:    // at_cross_boundary: fallback — arrived at cross-boundary without pre-setup
flow/v2_pipeline/phase_05_leader/J5_run.log:7586:    // (happens after stall / redirect blocked upcoming_cross the previous cycle)
flow/v2_pipeline/phase_05_leader/J5_run.log:7587:    wire        at_cross_boundary = cur_at_high && !is_comp_hi && !cross_assemble;
flow/v2_pipeline/phase_05_leader/J5_run.log:7589:    // upcoming_cross: sequential 16-bit at low half, FOLLOWED BY 32-bit at high half
flow/v2_pipeline/phase_05_leader/J5_run.log:7591:    // with no prediction override or stall this cycle. Guarantees residue = correct high-half.
flow/v2_pipeline/phase_05_leader/J5_run.log:7592:    wire        upcoming_cross = !cur_at_high && is_comp_lo && !is_comp_hi &&
flow/v2_pipeline/phase_05_leader/J5_run.log:7593:                                  !cross_assemble && !stall && !warmup && !pc_redirect &&
flow/v2_pipeline/phase_05_leader/J5_run.log:7598:    wire        is_16bit_w = cross_assemble  ? 1'b0 :       // assembled cross = 32-bit
flow/v2_pipeline/phase_05_leader/J5_run.log:7602:    // fetch_stall: only fallback cross-boundary detection (not upcoming_cross path)
flow/v2_pipeline/phase_05_leader/J5_run.log:7603:    wire        fetch_stall = at_cross_boundary;
flow/v2_pipeline/phase_05_leader/J5_run.log:7617:    // cross_assemble: {new_word[15:0], residue} — both from registers (short path)
flow/v2_pipeline/phase_05_leader/J5_run.log:7620:    // (at_cross_boundary case produces garbage but any_stall=1 prevents latching)
flow/v2_pipeline/phase_05_leader/J5_run.log:7621:    wire [31:0] instr_assembled =
flow/v2_pipeline/phase_05_leader/J5_run.log:7622:        cross_assemble  ? {cur_half_lo, residue} :
flow/v2_pipeline/phase_05_leader/J5_run.log:7631:    wire if_is_ret_32  = (instr_assembled[6:0]  == 7'b1100111) &&  // JALR opcode
flow/v2_pipeline/phase_05_leader/J5_run.log:7632:                         (instr_assembled[11:7]  == 5'b00000)   &&  // rd = x0
flow/v2_pipeline/phase_05_leader/J5_run.log:7633:                         (instr_assembled[14:12] == 3'b000)     &&  // funct3 = 0
flow/v2_pipeline/phase_05_leader/J5_run.log:7634:                         (instr_assembled[19:15] == 5'b00001);      // rs1 = ra (x1)
flow/v2_pipeline/phase_05_leader/J5_run.log:7682:    //   at_cross_boundary: fetch next word (fallback, same as lab08d)
flow/v2_pipeline/phase_05_leader/J5_run.log:7683:    //   upcoming_cross:    pre-fetch next word one cycle early (if_pc[1]=0 → +4 = next word)
flow/v2_pipeline/phase_05_leader/J5_run.log:7685:    assign i_mem_addr = at_cross_boundary ? (if_pc + 32'd2) :
flow/v2_pipeline/phase_05_leader/J5_run.log:7686:                        upcoming_cross    ? (if_pc + 32'd4) :
flow/v2_pipeline/phase_05_leader/J5_run.log:7688:    // Keep BRAM active during at_cross_boundary even if lu/md stall fires simultaneously.
flow/v2_pipeline/phase_05_leader/J5_run.log:7690:    assign i_mem_en   = (!stall || at_cross_boundary) && !mem_stall;
flow/v2_pipeline/phase_05_leader/J5_run.log:7695:            cross_assemble <= 1'b0;
flow/v2_pipeline/phase_05_leader/J5_run.log:7696:            residue        <= 16'h0;
flow/v2_pipeline/phase_05_leader/J5_run.log:7697:        end else if (upcoming_cross) begin
flow/v2_pipeline/phase_05_leader/J5_run.log:7699:            cross_assemble <= 1'b1;
flow/v2_pipeline/phase_05_leader/J5_run.log:7700:            residue        <= cur_half_hi;
flow/v2_pipeline/phase_05_leader/J5_run.log:7701:        end else if (at_cross_boundary && !warmup && !mem_stall) begin
flow/v2_pipeline/phase_05_leader/J5_run.log:7703:            cross_assemble <= 1'b1;
flow/v2_pipeline/phase_05_leader/J5_run.log:7704:            residue        <= cur_half_hi;
flow/v2_pipeline/phase_05_leader/J5_run.log:7707:            cross_assemble <= 1'b0;
flow/v2_pipeline/phase_05_leader/J5_run.log:7731:            // hold (load-use / muldiv / at_cross_boundary stall)
flow/v2_pipeline/phase_05_leader/J5_run.log:7740:            if_ex_instr           <= instr_assembled;
