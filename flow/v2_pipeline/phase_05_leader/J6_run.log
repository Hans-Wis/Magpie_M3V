--- /dev/null
+++ b/flow/v2_pipeline/phase_04_08_functional_coverage/stim_load_use.S
@@ -0,0 +1,20 @@
+.section .init
+.global _start
+
+.option push
+.option norvc
+_start:
+    lui  sp, %hi(16*1024)
+    addi sp, sp, %lo(16*1024)
+
+    la   t0, load_data
+    lw   s1, 0(t0)
+    addi s2, s1, 1
+    add  s3, s2, s1
