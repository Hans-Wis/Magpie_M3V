        .d_mem_valid        (d_mem_valid),
        .d_mem_addr         (d_mem_addr),
        .d_mem_wdata        (d_mem_wdata),
        .d_mem_wstrb        (d_mem_wstrb),
        .d_mem_rdata        (d_mem_rdata),
        .irq_external_pulse (irq_external_pulse),
        .dbg_pc             (dbg_pc),
        .dbg_instr          (dbg_instr),
        .dbg_state          (dbg_state)
    );

    always #5 clk = ~clk;

    always @(posedge clk) begin
        if (i_mem_en) i_mem_rdata <= memory[i_word_idx];
        if (d_mem_valid) begin
            d_mem_rdata <= memory[d_word_idx];
            if (!d_is_mmio && |d_mem_wstrb) begin
                if (d_mem_wstrb[0]) memory[d_word_idx][ 7: 0] <= d_mem_wdata[ 7: 0];
                if (d_mem_wstrb[1]) memory[d_word_idx][15: 8] <= d_mem_wdata[15: 8];
                if (d_mem_wstrb[2]) memory[d_word_idx][23:16] <= d_mem_wdata[23:16];
                if (d_mem_wstrb[3]) memory[d_word_idx][31:24] <= d_mem_wdata[31:24];
            end
        end
    end

    integer trace_fd;
    integer commit_count;
    integer watchdog;
    reg [31:0] commit_instr;
    reg        injected_irq;
    reg        finish_pending;
    reg [1:0]  finish_kind;

    function [31:0] instr_at_pc;
        input [31:0] pc;
        reg [31:0] word0;
        reg [31:0] word1;
        reg [15:0] half0;
        begin
            word0 = memory[pc[13:2]];
            if (pc[1]) begin
                half0 = word0[31:16];
                instr_at_pc = (half0[1:0] == 2'b11) ? {memory[pc[13:2] + 12'd1][15:0], half0} : {16'h0, half0};
            end else begin
                half0 = word0[15:0];
                instr_at_pc = (half0[1:0] == 2'b11) ? word0 : {16'h0, half0};
            end
        end
    endfunction

    initial begin
        trace_fd = $fopen("dut_commit.trace", "w");
        if (trace_fd == 0) begin
            $display("FAIL: could not open dut_commit.trace");
            $fatal(1);
        end
        $fdisplay(trace_fd, "idx,pc,instr,rd,wdata");
        commit_count = 0;
        watchdog = 0;
        injected_irq = 1'b0;
        finish_pending = 1'b0;
        finish_kind = 2'd0;
    end

    always @(negedge clk) begin
        if (resetn && $test$plusargs("irq_at_0x80") && !injected_irq &&
            dbg_pc == 32'h0000_0080) begin
            irq_external_pulse <= 1'b1;
            injected_irq <= 1'b1;
            $display("[%0t ns] inject IRQ at pc=%08x instr=%08x", $time, dbg_pc, dbg_instr);
        end else begin
            irq_external_pulse <= 1'b0;
        end
    end

    always @(posedge clk) begin
        watchdog <= watchdog + 1;
        if (finish_pending) begin
            $fclose(trace_fd);
            if (finish_kind == 2'd2)
                $display("PASS: functional coverage IRQ/mret trace observed mret after %0d commits", commit_count);
            else
                $display("PASS: functional coverage random trace wrote %0d commits before terminal trap", commit_count);
            $finish;
        end
        if (watchdog > 1400) begin
            $display("FAIL: watchdog timeout");
            $fatal(1);
        end

        if (!finish_pending && dut.ex_wb_valid_r && dut.ex_wb_illegal_r) begin
            $display("[%0t ns] stop on illegal/ebreak pc=%08x commits=%0d", $time, dut.ex_wb_pc_r, commit_count);
            if (commit_count < 2) begin
                $display("FAIL: too few commits before ebreak");
                $fatal(1);
            end
            finish_pending <= 1'b1;
            finish_kind <= 2'd1;
        end else if (!finish_pending && $test$plusargs("stop_after_mret") && dut.wb_trap_exit) begin
            finish_pending <= 1'b1;
            finish_kind <= 2'd2;
        end else if (dut.wb_instr_retired && !dut.ex_wb_illegal_r) begin
            commit_instr = instr_at_pc(dut.ex_wb_pc_r);
            $fdisplay(trace_fd, "%0d,%08x,%08x,%0d,%08x",
                      commit_count,
                      dut.ex_wb_pc_r,
                      (commit_instr[1:0] != 2'b11) ? {16'h0, commit_instr[15:0]} : commit_instr,
                      (dut.rfu_we && dut.rfu_wr_idx != 5'd0) ? dut.rfu_wr_idx : 5'd0,
                      (dut.rfu_we && dut.rfu_wr_idx != 5'd0) ? dut.rfu_wr_data : 32'h0);
            commit_count <= commit_count + 1;
        end
    end

    initial begin
        $dumpfile("wave.vcd");
        if ($test$plusargs("full_vcd")) begin
            $dumpvars(0, tb_random_func_cov);
        end else begin
            $dumpvars(0, clk, resetn, trap, commit_count, dbg_pc, dbg_instr, dbg_state);
            $dumpvars(0, dut.if_ex_valid, dut.if_ex_instr, dut.if_ex_is_16bit);
            $dumpvars(0, dut.stall, dut.fetch_stall, dut.pc_redirect);
            $dumpvars(0, dut.ex_mem_valid_r, dut.ex_wb_valid_r);
        end
        repeat (6) @(posedge clk);
        resetn = 1'b1;
    end
endmodule

