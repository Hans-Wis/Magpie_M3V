46:    wire load_use_match_em = (id_rs1_idx == em_rd_idx) || (id_rs2_idx == em_rd_idx);
47:    wire load_use_stall = id_valid && em_valid && em_is_load && em_rd_we &&
48:                          (em_rd_idx != 5'd0) && load_use_match_em;
