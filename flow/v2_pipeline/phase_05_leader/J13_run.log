   444	        .wb_is_load   (ex_wb_is_load),
   445	        .rs1_val      (rs1_val),
   446	        .rs2_val      (rs2_val)
   447	    );
   448	
   449	    // =========================================================================
   450	    // ALU
   451	    // =========================================================================
   452	    wire [31:0] alu_op_a = rs1_val;
   453	    wire [31:0] alu_op_b = id_alu_b_use_imm ? id_imm : rs2_val;
   454	    wire [31:0] alu_result;
   455	    wire        alu_cmp_eq, alu_cmp_lt_s, alu_cmp_lt_u;
   456	
   457	    alu u_alu (
   458	        .op_a      (alu_op_a),
   459	        .op_b      (alu_op_b),
   460	        .alu_op    (id_alu_op),
   461	        .result    (alu_result),
   462	        .cmp_eq    (alu_cmp_eq),
   463	        .cmp_lt_s  (alu_cmp_lt_s),
   464	        .cmp_lt_u  (alu_cmp_lt_u)
   465	    );
   466	
   467	    // Branch decision — fast path bypasses alu_result case mux (lab08e v2)
   468	    // id_br_type = funct3[2:1]: 00=BEQ/BNE(eq), 10=BLT/BGE(lt_s), 11=BLTU/BGEU(lt_u)
   469	    wire branch_cond  = (id_br_type == 2'b00) ? alu_cmp_eq  :
   470	                        (id_br_type == 2'b10) ? alu_cmp_lt_s : alu_cmp_lt_u;
   471	    wire branch_taken = id_is_branch && (id_branch_invert ^ branch_cond);
   472	
   473	    // pc + imm (給 JAL / branch target / AUIPC)
   474	    // Use actual instruction size (16-bit→+2, 32-bit→+4) for link address and mepc
   475	    wire [31:0] if_ex_pc_plus_4   = if_ex_pc + (if_ex_is_16bit ? 32'd2 : 32'd4);
   476	    wire [31:0] if_ex_pc_plus_imm = if_ex_pc + id_imm;
   477	
   478	    // BP mispredict detection: direction plus predicted-target equality.
   479	    // BTB target aliases are possible; a predicted-taken branch/JAL/JALR must
   480	    // still redirect if the resolved target differs from the fetched target.
   481	    wire ex_actual_taken = if_ex_valid && (branch_taken | id_is_jal | id_is_jalr);
   482	    wire [31:0] ex_actual_target = id_is_jalr ? (alu_result & ~32'd1) : if_ex_pc_plus_imm;
   483	    wire ex_target_mispredict = if_ex_valid && if_ex_pred_taken && ex_actual_taken
   484	                              && !if_ex_pred_ras
   485	                              && (if_ex_pred_target != ex_actual_target);
   486	
   487	    wire ex_mispredict = if_ex_valid && ((if_ex_pred_taken != ex_actual_taken)
   488	                                      || ex_target_mispredict);
   489	
   490	    // Recovery target NOT computed here — moved to MEM stage (combinational from
   491	    // ex_mem.Q registers) to keep alu_result off the redirect_target.D path
   492	
   493	    // BP update：combinational in EX，latch 進 ex_mem_bp_upd_* register，下一拍才
   494	    // drive bp.v 的 upd port → BP counter_arr.D 跟 target_arr.D path 從 register
   495	    // output 出發 (不再有 alu_result 進 BP write data 路徑)
   496	    wire        ex_bp_upd_valid  = if_ex_valid && (id_is_branch | id_is_jal)
   497	                                              && !stall && !pc_redirect;
   498	    wire [31:0] ex_bp_upd_pc     = if_ex_pc;
   499	    wire        ex_bp_upd_taken  = ex_actual_taken;
   500	    wire [31:0] ex_bp_upd_target = if_ex_pc_plus_imm;
   501	
   502	    // Lab08c: RAS push — 偵測 IF/EX 是 JAL ra (id_is_jal && rd == x1)，push pc+4
   503	    //         （= 函式 return address）。Gating 跟 bp_upd 同：!stall, !pc_redirect
   504	    assign ras_push     = if_ex_valid && id_is_jal && (id_rd_idx == 5'd1)
   505	                                      && !stall && !pc_redirect && !mem_stall;
   506	    assign ras_push_val = if_ex_pc_plus_4;
   507	
   508	    // =========================================================================
   509	    // MUL / DIV units
   510	    // =========================================================================
   511	    // 兩個共用一條 start / done / result 介面 (透過 md_is_div 路由)
   512	    wire        mul_done, div_done;
   513	    wire [31:0] mul_result, div_result;
   514	    reg         md_started;
   515	    reg         md_active_is_div;
   516	    reg         md_result_valid;
   517	    reg  [31:0] md_result_q;
   518	    wire        md_done = md_active_is_div ? div_done : mul_done;
   519	    wire        md_busy = if_ex_valid && id_is_muldiv && !md_result_valid;
   520	    wire [31:0] md_result = md_result_q;
   521	
   522	    wire md_start = if_ex_valid && id_is_muldiv && !md_started && !md_result_valid;
   523	
   524	    always @(posedge clk) begin
   525	        if (!resetn) begin
   526	            md_started       <= 1'b0;
   527	            md_active_is_div <= 1'b0;
   528	            md_result_valid  <= 1'b0;
   529	            md_result_q      <= 32'h0;
   530	        end else if (md_done) begin
   531	            md_started      <= 1'b0;
   532	            md_result_valid <= 1'b1;
   533	            md_result_q     <= md_active_is_div ? div_result : mul_result;
   534	        end else if (id_advance_to_ex_mem && md_result_valid) begin
   535	            md_result_valid <= 1'b0;
   536	        end else if (md_start) begin
   537	            md_started       <= 1'b1;
   538	            md_active_is_div <= id_md_is_div;
   539	        end
   540	    end
   541	
   542	    mul u_mul (
   543	        .clk    (clk),
   544	        .resetn (resetn),
   545	        .start  (md_start && !id_md_is_div),
   546	        .md_op  (id_md_op),
   547	        .op_a   (rs1_val),
   548	        .op_b   (rs2_val),
   549	        .result (mul_result),
   550	        .done   (mul_done)
   551	    );
   552	
   553	    div u_div (
   554	        .clk    (clk),
   555	        .resetn (resetn),
   556	        .start  (md_start &&  id_md_is_div),
   557	        .md_op  (id_md_op),
   558	        .op_a   (rs1_val),
   559	        .op_b   (rs2_val),
   560	        .result (div_result),
   561	        .done   (div_done)
   562	    );
   563	
   564	    // =========================================================================
   565	    // LSU (in ID/EX stage: 生成 d-port outputs)
   566	    //   addr_lo, wdata_raw, funct3, is_store, mem_rdata
   567	    //   addr_lo 跟 mem_rdata 給 MEM/WB 用 (要 latch 到 EX/WB register)
   568	    // =========================================================================
   569	    wire [31:0] lsu_mem_wdata_id;
   570	    wire [ 3:0] lsu_mem_wstrb_id;
   571	    wire [31:0] lsu_ld_result_wb;       // 計算在 MEM/WB stage
   572	
   573	    // lab08e v3: store_addr_lo[1:0] = rs1[1:0] + imm[1:0], 2-bit adder.
   574	    // (rs1+imm)[1:0] == (rs1[1:0]+imm[1:0])[1:0] — lower bits independent of upper carries.
   575	    // Bypasses 32-bit ALU CARRY4 chain; wstrb only needs addr[1:0].
   576	    wire [1:0] store_addr_lo = rs1_val[1:0] + id_imm[1:0];
   577	
   578	    // ID/EX：根據 store 算 wdata + wstrb
   579	    /* verilator lint_off PINCONNECTEMPTY */
   580	    lsu u_lsu_id (
   581	        .addr_lo   (store_addr_lo),
   582	        .wdata_raw (rs2_val),
   583	        .funct3    (id_ls_funct3),
   584	        .is_store  (id_is_store && if_ex_valid && !stall),
   585	        .mem_rdata (32'h0),              // ID/EX 不用 ld_result
   586	        .mem_wdata (lsu_mem_wdata_id),
   587	        .mem_wstrb (lsu_mem_wstrb_id),
   588	        .ld_result ()                    // 不用
   589	    );
   590	    /* verilator lint_on PINCONNECTEMPTY */
   591	
   592	    // NOTE: `&&` binds tighter than `?:` — the ternary MUST be parenthesized,
   593	    // else a non-load/store instr whose funct3 == F3_LW/F3_SW (e.g. SLT=010)
   594	    // spuriously reports a misalign trap from its ALU result (drops div->..->slt,
   595	    // diverged from Spike at idx=36).
   596	    wire id_mem_align_error = (id_is_load || id_is_store) && (
   597	                             ((id_ls_funct3 == `F3_LH) || (id_ls_funct3 == `F3_SH)) ? (alu_result[0] != 1'b0) :
   598	                             ((id_ls_funct3 == `F3_LW) || (id_ls_funct3 == `F3_SW)) ? (alu_result[1:0] != 2'b00) :
   599	                             1'b0);
   600	    wire id_mem_misaligned = id_mem_align_error && if_ex_valid && !stall && !pc_redirect && !warmup;
   601	
   602	    // 對外 d-port：MEM stage 驅動 (lab06b: 從 ex_mem.Q 出，不是 ID/EX 組合)
   603	    //   d_mem_addr 走 register output → 切開 lab06 的 "BRAM → ALU → d_mem WEA" 長路徑
   604	    //   id_mem_active 仍在 ID/EX 算 (寫 ex_mem 用)
   605	    wire id_mem_active = (id_is_load || id_is_store) && if_ex_valid && !stall &&
   606	                         !pc_redirect && !warmup;
   607	    // 從 ex_mem register 驅動 d-port (MEM stage)
   608	    assign d_mem_valid = ex_mem_valid_r && (ex_mem_is_load_r || ex_mem_is_store_r) &&
   609	                         !pc_redirect && !ex_mem_is_misaligned_r;
   610	    assign d_mem_addr  = ex_mem_alu_result_r;
   611	    assign d_mem_wdata = ex_mem_store_wdata_r;
   612	    assign d_mem_wstrb = ex_mem_is_store_r && ex_mem_valid_r && !pc_redirect ?
   613	                         ex_mem_store_wstrb_r : 4'h0;
   614	
   615	    // =========================================================================
   616	    // CSR (lab05 同款，但 instr_retired 改成「EX/WB stage commits a valid instr」)
   617	    // =========================================================================
   618	    wire [31:0] id_csr_wdata = id_csr_uses_imm ? id_csr_zimm : rs1_val;
   619	    wire        id_csr_we_logic = id_is_csr &&
   620	                                  ((id_csr_op == `CSR_OP_W) || (id_csr_wdata != 32'h0));
   621	
   622	    wire [31:0] csr_rdata;
   623	    wire [31:0] mtvec_o, mepc_o;
   624	    wire        irq_pending;
   625	    wire [31:0] wb_trap_cause;
   626	    wire [31:0] wb_trap_mtval;
   627	
   628	    // CSR write happens in EX/WB stage (latched into ex_wb register)
   629	    wire        wb_csr_we;
   630	    wire        wb_trap_enter, wb_trap_exit;
   631	    wire [31:0] wb_trap_pc_for_mepc;
   632	    wire        wb_instr_retired;
   633	    reg        ex_wb_valid_r;
   634	    /* verilator lint_off UNUSEDSIGNAL */  // 留作 debug; trap_pc 走 pc_plus_4 路徑
   635	    reg [31:0] ex_wb_pc_r;
   636	    /* verilator lint_on UNUSEDSIGNAL */
   637	    reg [31:0] ex_wb_alu_result_r;
   638	    reg [31:0] ex_wb_md_result_r;
   639	    reg [31:0] ex_wb_pc_plus_4_r;
   640	    reg [31:0] ex_wb_pc_plus_imm_r;
   641	    reg [31:0] ex_wb_csr_rdata_r;
   642	    reg [ 4:0] ex_wb_rd_idx_r;
   643	    reg        ex_wb_rd_we_r;
   644	    reg [ 2:0] ex_wb_wb_sel_r;
   645	    reg        ex_wb_is_load_r;
   646	    /* verilator lint_off UNUSEDSIGNAL */
   647	    reg        ex_wb_is_store_r;   // store 在 MEM 已 commit 到 d-port，WB 不用
   648	    /* verilator lint_on UNUSEDSIGNAL */
   649	    reg        ex_wb_is_misaligned_r;
   650	    reg        ex_wb_is_misaligned_store_r;
   651	    reg [ 2:0] ex_wb_ls_funct3_r;
   652	    reg [ 1:0] ex_wb_addr_lo_r;
   653	    reg        ex_wb_is_mret_r;
   654	    reg        ex_wb_csr_we_r;
   655	    reg [11:0] ex_wb_csr_addr_r;
   656	    reg [ 1:0] ex_wb_csr_op_r;
   657	    reg [31:0] ex_wb_csr_wdata_r;
   658	    reg        ex_wb_is_branch_taken_r;
   659	    reg        ex_wb_is_jal_r;
   660	    reg        ex_wb_is_jalr_r;
   661	    reg        ex_wb_illegal_r;
   662	    wire       wb_take_irq;
   663	
   664	    csr u_csr (
   665	        .clk                (clk),
   666	        .resetn             (resetn),
   667	        .csr_raddr          (id_csr_addr),       // read in ID/EX
   668	        .csr_rdata          (csr_rdata),
   669	        .csr_we             (wb_csr_we),         // write in EX/WB (latched addr)
   670	        .csr_waddr          (ex_wb_csr_addr_r),
   671	        .csr_op             (ex_wb_csr_op_r),
   672	        .csr_wdata          (ex_wb_csr_wdata_r),
   673	        .csr_old_val        (ex_wb_csr_rdata_r),
   674	        .instr_retired      (wb_instr_retired),
   675	        .trap_enter         (wb_trap_enter),
   676	        .trap_pc            (wb_trap_pc_for_mepc),
   677	        .trap_exit          (wb_trap_exit),
   678	        .irq_external_pulse (irq_external_pulse),
   679	        .trap_cause        (wb_trap_cause),
   680	        .trap_mtval        (wb_trap_mtval),
   681	        .mtvec_o            (mtvec_o),
   682	        .mepc_o             (mepc_o),
   683	        .irq_pending        (irq_pending)
   684	    );
   685	
   686	    // =========================================================================
   687	    // hazard (load-use stall + muldiv stall)
   688	    // =========================================================================
   689	    hazard u_hazard (
   690	        .id_valid     (if_ex_valid),
   691	        .id_rs1_idx   (id_rs1_idx),
   692	        .id_rs2_idx   (id_rs2_idx),
   693	        .id_is_muldiv (id_is_muldiv),
   694	        .em_valid     (ex_mem_valid_r),
   695	        .em_rd_we     (ex_mem_rd_we_r),
   696	        .em_rd_idx    (ex_mem_rd_idx_r),
   697	        .em_is_load   (ex_mem_is_load_r),
   698	        .wb_valid     (ex_wb_valid),
   699	        .wb_rd_we     (ex_wb_rd_we),
   700	        .wb_rd_idx    (ex_wb_rd_idx),
   701	        .wb_is_load   (ex_wb_is_load),
   702	        .md_busy      (md_busy),
   703	        .stall        (stall)
   704	    );
   705	
   706	    // =========================================================================
   707	    // EX/MEM pipeline register (NEW in lab06b)
   708	    //   存：control signals + ALU result + branch decide + store data
   709	    //   ALU output 在這裡 latch → 下一拍 d_mem_addr 從 register Q 驅動
   710	    //   PC redirect 在 MEM stage 從 ex_mem.Q 出 (branch penalty 跟 lab06 同 3 cycle)
   711	    // =========================================================================
   712	    // Lab08b: BP mispredict 取代「無條件 branch_taken/jal/jalr → redirect」
   713	    // 注意：不 latch recovery_target — 在 MEM stage 用 ex_mem.Q registers 組合算
   714	    //       (避免 alu_result → ex_mem_recovery_target_r.D 的 critical path)
   715	    // Lab08b: BP update path register (避免 alu_result→counter_arr/target_arr.D
   716	    // 的 critical path；多 1 cycle update latency，但對 hot-loop 命中率影響忽略)
   717	    // Lab08c: RAS prediction info forwarded to MEM stage for target verify
   718	
   719	    // ID/EX → EX/MEM 推進條件
   720	    // Lab08e: !any_stall (= 不在 lu/md/at_cross_boundary/warmup stall 期間)。
   721	    assign id_advance_to_ex_mem = !any_stall && if_ex_valid && !warmup && !pc_redirect;
   722	    // VCS-compatible split declaration for: wire id_advance_to_ex_mem = !any_stall && if_ex_valid && !warmup && !pc_redirect;
   723	
   724	    always @(posedge clk) begin
   725	        if (!resetn) begin
   726	            ex_mem_valid_r           <= 1'b0;
   727	            ex_mem_rd_we_r           <= 1'b0;
   728	            ex_mem_is_load_r         <= 1'b0;
   729	            ex_mem_is_store_r        <= 1'b0;
   730	            ex_mem_store_wstrb_r     <= 4'h0;
   731	            ex_mem_is_mret_r         <= 1'b0;
   732	            ex_mem_is_misaligned_r   <= 1'b0;
   733	            ex_mem_is_misaligned_store_r <= 1'b0;
   734	            ex_mem_csr_we_r          <= 1'b0;
   735	            ex_mem_is_branch_taken_r <= 1'b0;
   736	            ex_mem_is_jal_r          <= 1'b0;
   737	            ex_mem_is_jalr_r         <= 1'b0;
   738	            ex_mem_illegal_r         <= 1'b0;
   739	            ex_mem_mispredict_r      <= 1'b0;
   740	            ex_mem_bp_upd_valid_r    <= 1'b0;
   741	            ex_mem_pred_ras_r        <= 1'b0;
   742	        end else if (id_advance_to_ex_mem) begin
   743	            ex_mem_valid_r           <= 1'b1;
   744	            ex_mem_pc_r              <= if_ex_pc;
   745	            ex_mem_alu_result_r      <= alu_result;
   746	            ex_mem_md_result_r       <= md_result;
   747	            ex_mem_pc_plus_4_r       <= if_ex_pc_plus_4;
   748	            ex_mem_pc_plus_imm_r     <= if_ex_pc_plus_imm;
   749	            ex_mem_csr_rdata_r       <= csr_rdata;
   750	            ex_mem_rd_idx_r          <= id_rd_idx;
   751	            ex_mem_rd_we_r           <= id_rd_we;
   752	            ex_mem_wb_sel_r          <= id_wb_sel;
   753	            ex_mem_is_load_r         <= id_is_load;
   754	            ex_mem_is_store_r        <= id_is_store;
   755	            ex_mem_ls_funct3_r       <= id_ls_funct3;
   756	            ex_mem_addr_lo_r         <= alu_result[1:0];
   757	            ex_mem_store_wdata_r     <= lsu_mem_wdata_id;
   758	            ex_mem_store_wstrb_r     <= id_is_store && id_mem_active ? lsu_mem_wstrb_id : 4'h0;
   759	            ex_mem_is_mret_r         <= id_is_mret;
   760	            ex_mem_is_misaligned_r   <= id_mem_misaligned;
   761	            ex_mem_is_misaligned_store_r <= id_is_store;
   762	            ex_mem_csr_we_r          <= id_csr_we_logic;
   763	            ex_mem_csr_addr_r        <= id_csr_addr;
   764	            ex_mem_csr_op_r          <= id_csr_op;
   765	            ex_mem_csr_wdata_r       <= id_csr_wdata;
   766	            ex_mem_is_branch_taken_r <= branch_taken;
   767	            ex_mem_is_jal_r          <= id_is_jal;
   768	            ex_mem_is_jalr_r         <= id_is_jalr;
   769	            ex_mem_illegal_r         <= id_illegal;
   770	            ex_mem_mispredict_r      <= ex_mispredict;
   771	            ex_mem_bp_upd_valid_r    <= ex_bp_upd_valid;
   772	            ex_mem_bp_upd_pc_r       <= ex_bp_upd_pc;
   773	            ex_mem_bp_upd_taken_r    <= ex_bp_upd_taken;
   774	            ex_mem_bp_upd_target_r   <= ex_bp_upd_target;
   775	            ex_mem_pred_ras_r        <= if_ex_pred_ras;
   776	            ex_mem_pred_ras_target_r <= if_ex_pred_ras_target;
   777	        end else if (mem_stall) begin
   778	            // ADR-0005 freeze: hold EX/MEM in place during a memory wait (no bubble)
   779	        end else begin
   780	            // Stall / wrong-path / warmup: 插 bubble
   781	            ex_mem_valid_r           <= 1'b0;
   782	            ex_mem_rd_we_r           <= 1'b0;
   783	            ex_mem_is_load_r         <= 1'b0;
   784	            ex_mem_is_store_r        <= 1'b0;
   785	            ex_mem_store_wstrb_r     <= 4'h0;
   786	            ex_mem_is_mret_r         <= 1'b0;
   787	            ex_mem_is_misaligned_r   <= 1'b0;
   788	            ex_mem_is_misaligned_store_r <= 1'b0;
   789	            ex_mem_csr_we_r          <= 1'b0;
   790	            ex_mem_is_branch_taken_r <= 1'b0;
   791	            ex_mem_is_jal_r          <= 1'b0;
   792	            ex_mem_is_jalr_r         <= 1'b0;
   793	            ex_mem_illegal_r         <= 1'b0;
   794	            ex_mem_mispredict_r      <= 1'b0;
   795	            ex_mem_bp_upd_valid_r    <= 1'b0;
   796	            ex_mem_pred_ras_r        <= 1'b0;
   797	        end
   798	    end
   799	
   800	    // Lab08c: MEM-stage RAS target verify (combinational from ex_mem.Q)
   801	    //   pred_ras=1 表示 IF 階段 RAS 預測這條 jalr 的 target；現在比對 alu_result 是否相同
   802	    //   alu_result for jalr = rs1 + imm = ra (因為 ret 是 jalr x0, ra, 0)，& ~1 mask LSB
   803	    //   mismatch → fire 額外 redirect (priority 比 ex_mem_mispredict 高)
   804	    wire [31:0] mem_ras_actual_target = ex_mem_alu_result_r & ~32'd1;
   805	    wire        mem_ras_mispredict    = ex_mem_valid_r && ex_mem_pred_ras_r
   806	                                     && (mem_ras_actual_target != ex_mem_pred_ras_target_r);
   807	
   808	    // BP update 用 ex_mem_bp_upd_* register output 驅動 (1 cycle delay)
   809	    assign bp_upd_valid  = ex_mem_bp_upd_valid_r && !mem_stall;
