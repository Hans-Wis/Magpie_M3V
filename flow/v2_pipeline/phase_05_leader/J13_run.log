   120	    assign csr_uses_imm = funct3[2];             // 0=use rs1, 1=use zimm
   121	    assign csr_addr     = instr[31:20];
   122	    assign csr_zimm     = {27'b0, instr[19:15]}; // zero-ext rs1 field
   123	
   124	    // -------------------------------------------------------------------------
   125	    // M extension (lab06): opcode = OP (0110011) + funct7 = 0000001
   126	    //   funct3 直接編碼成 md_op:
   127	    //     000 MUL    001 MULH   010 MULHSU 011 MULHU
