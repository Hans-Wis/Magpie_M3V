   140	            is_lui, is_auipc            : imm = imm_u;
   141	            is_jal                      : imm = imm_j;
   142	            is_jalr, is_load, is_op_imm : imm = imm_i;
   143	            is_store                    : imm = imm_s;
   144	            is_branch                   : imm = imm_b;
   145	            default                     : imm = 32'h0;
   146	        endcase
   147	    end
   148	
   149	    // -------------------------------------------------------------------------
   150	    // ALU 控制
   151	    //   * OP-IMM / OP: funct3 + funct7 決定 alu_op
