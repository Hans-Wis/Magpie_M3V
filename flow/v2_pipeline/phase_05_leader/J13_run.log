   171	                `F3_SLL     : alu_op = `ALU_SLL;
   172	                `F3_SRL_SRA : alu_op = is_sub_or_sra ? `ALU_SRA : `ALU_SRL;
   173	                default     : alu_op = `ALU_ADD;
   174	            endcase
   175	        end else if (is_op) begin
   176	            case (funct3)
   177	                `F3_ADD_SUB : alu_op = is_sub_or_sra ? `ALU_SUB : `ALU_ADD;
   178	                `F3_SLT     : alu_op = `ALU_SLT;
   179	                `F3_SLTU    : alu_op = `ALU_SLTU;
   180	                `F3_XOR     : alu_op = `ALU_XOR;
   181	                `F3_OR      : alu_op = `ALU_OR;
   182	                `F3_AND     : alu_op = `ALU_AND;
   183	                `F3_SLL     : alu_op = `ALU_SLL;
   184	                `F3_SRL_SRA : alu_op = is_sub_or_sra ? `ALU_SRA : `ALU_SRL;
   185	                default     : alu_op = `ALU_ADD;
   186	            endcase
   187	        end else if (is_branch) begin
   188	            case (funct3)
   189	                `F3_BEQ, `F3_BNE   : alu_op = `ALU_SEQ;
   190	                `F3_BLT, `F3_BGE   : alu_op = `ALU_SLT;
   191	                `F3_BLTU, `F3_BGEU : alu_op = `ALU_SLTU;
   192	                default            : alu_op = `ALU_SEQ;
   193	            endcase
   194	        end else if (is_lui) begin
   195	            alu_op = `ALU_COPY_B; // result = imm_u
   196	        end
   197	        // 其他 case (load/store/jalr/auipc/jal/fence) → ALU_ADD (default)
   198	    end
   199	
   200	    // BRANCH operand 也是 rs2，不是 imm
   201	    assign alu_b_use_imm = is_op_imm | is_lui | is_auipc | is_load | is_store
   202	                         | is_jal     | is_jalr;
   203	
   204	    assign branch_invert = is_branch && (funct3 == `F3_BNE ||
   205	                                         funct3 == `F3_BGE ||
   206	                                         funct3 == `F3_BGEU);
   207	    assign br_type = funct3[2:1]; // 00=BEQ/BNE(eq) 10=BLT/BGE(lt_s) 11=BLTU/BGEU(lt_u)
   208	
   209	    // -------------------------------------------------------------------------
   210	    // Write-back 控制
   211	    // -------------------------------------------------------------------------
   212	    assign rd_we = is_op | is_op_imm | is_lui | is_auipc
   213	                 | is_jal | is_jalr | is_load | is_csr;
   214	
   215	    always @* begin
   216	        case (1'b1)
   217	            is_auipc       : wb_sel = `WB_SEL_PCIMM; // pc + imm
   218	            is_jal, is_jalr: wb_sel = `WB_SEL_PC4;   // pc + 4 (link)
   219	            is_load        : wb_sel = `WB_SEL_LSU;
   220	            is_csr         : wb_sel = `WB_SEL_CSR;   // csr_rdata (lab05)
   221	            is_muldiv      : wb_sel = `WB_SEL_MD;    // mul/div (lab06)
   222	            default        : wb_sel = `WB_SEL_ALU;   // LUI / OP / OP-IMM
   223	        endcase
   224	    end
   225	
   226	    // -------------------------------------------------------------------------
   227	    // 記憶體存取
   228	    // -------------------------------------------------------------------------
   229	    assign ls_funct3 = funct3;
   230	
   231	    // -------------------------------------------------------------------------
   232	    // 例外
   233	    //   * Fence  : NOP
   234	    //   * CSR* / MRET : 合法 (lab05 新加)
   235	    //   * ECALL / EBREAK / WFI / 其他 SYSTEM 變種 : illegal → ST_TRAP
   236	    //   * 未知 opcode : illegal
   237	    // -------------------------------------------------------------------------
   238	    wire branch_funct3_valid =
   239	        (funct3 == `F3_BEQ)  || (funct3 == `F3_BNE)  ||
   240	        (funct3 == `F3_BLT)  || (funct3 == `F3_BGE)  ||
   241	        (funct3 == `F3_BLTU) || (funct3 == `F3_BGEU);
   242	
   243	    wire known_opcode =
   244	        is_lui | is_auipc | is_jal | (is_branch && branch_funct3_valid)
   245	      | is_load | is_store | is_op_imm | is_op | is_fence
   246	      | is_jalr | is_csr | is_mret;
   247	
   248	    assign illegal = !known_opcode;
   249	
   250	endmodule

