diff --git a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v
index cf762bd127a7f8fc1bb4a1e72b787db030310e3a..aa9424e080cbabad98a77c2e2f6b8416b69ca981
--- a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v
+++ b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v
@@ -15,7 +15,9 @@
 
 `include "def.vh"
 
-module core (
+module core #(
+    parameter [31:0] RESET_PC = `PC_RESET
+) (
     input             clk,
     input             resetn,
     output            trap,
@@ -194,7 +196,9 @@
         .pop      (ras_pop)
     );
 
-    ifu u_ifu (
+    ifu #(
+        .RESET_PC(RESET_PC)
+    ) u_ifu (
         .clk                (clk),
         .resetn             (resetn),
         .pc_stall           (any_stall),
@@ -220,7 +224,7 @@
                                             next_pc_w;
     // Keep BRAM active during at_cross_boundary even if lu/md stall fires simultaneously.
     // (same fix as lab08d §problems_log 1, but now only needed for fallback path)
-    assign i_mem_en   = (!stall || at_cross_boundary) && !mem_stall;
+    assign i_mem_en   = (pc_redirect || redirect_warmup || !stall || at_cross_boundary) && !mem_stall;
 
     // ---- Cross-boundary state machine ----
     always @(posedge clk) begin
@@ -519,7 +523,8 @@
     wire        md_busy = if_ex_valid && id_is_muldiv && !md_result_valid;
     wire [31:0] md_result = md_result_q;
 
-    wire md_start = if_ex_valid && id_is_muldiv && !md_started && !md_result_valid;
+    wire md_start = if_ex_valid && id_is_muldiv && !md_started && !md_result_valid &&
+                    !pc_redirect && !warmup && !redirect_warmup;
 
     always @(posedge clk) begin
         if (!resetn) begin
@@ -527,6 +532,9 @@
             md_active_is_div <= 1'b0;
             md_result_valid  <= 1'b0;
             md_result_q      <= 32'h0;
+        end else if (pc_redirect) begin
+            md_started      <= 1'b0;
+            md_result_valid <= 1'b0;
         end else if (md_done) begin
             md_started      <= 1'b0;
             md_result_valid <= 1'b1;
diff --git a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/div.v b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/div.v
index f882196afbbb132ea2daa48d30fe3a5ad9989046..7e30114117649ed62c73a83351f2528c0e9c8093
--- a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/div.v
+++ b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/div.v
@@ -5,9 +5,9 @@
 //   IDLE     : 等 start
 //   WORK     : 32 cycles，每 cycle 做 shift + subtract + decide
 //   FIXUP    : 1 cycle，apply sign correction + special cases (div by 0, overflow)
-//   DONE     : 1 cycle，done=1
+//   DONE     : 1 cycle，done=1 with stable result
 //
-// Total latency from start to done = 1 (latch) + 32 (work) + 1 (fixup) = 34 cycles
+// Total latency from start to done = 1 (latch) + 32 (work) + 1 (fixup) + 1 (done) = 35 cycles
 //
 // RISC-V Spec corner cases (Privileged Spec 7.2):
 //   - DIVU / REMU by 0  : quot = 2^32 - 1, rem = rs1
@@ -31,6 +31,7 @@
     localparam IDLE  = 2'd0;
     localparam WORK  = 2'd1;
     localparam FIXUP = 2'd2;
+    localparam DONE  = 2'd3;
 
     reg [ 1:0] state;
     reg [ 5:0] iter;        // 0..31
@@ -122,6 +123,10 @@
                     end else begin
                         result <= sign_quot ? -quotient : quotient;
                     end
+                    state <= DONE;
+                end
+
+                DONE: begin
                     done  <= 1'b1;
                     state <= IDLE;
                 end
