     1	// =============================================================================
     2	// idu.v — Instruction Decode Unit (純組合)  [lab05 版本]
     3	// -----------------------------------------------------------------------------
     4	// 變動於 lab04：
     5	//   * 加 CSR* 指令解碼 (CSRRW/RS/RC + 3 個 immediate 版本)
     6	//   * 加 MRET 偵測 (完整 32-bit pattern 比對)
     7	//   * wb_sel 從 2-bit 擴成 3-bit，多一個 source = csr_rdata
     8	//   * illegal 判斷重寫：SYSTEM 不再一律 trap，CSR 跟 MRET 是合法
     9	//
    10	// 把 32-bit instruction 拆成：
    11	//   - 暫存器索引 (rd, rs1, rs2)
    12	//   - sign-extended immediate (I/S/B/U/J 五種格式都處理)
    13	//   - ALU 控制 (alu_op, alu_b_use_imm)
    14	//   - Write-back / next-PC / memory 控制
    15	//   - CSR 控制 (is_csr / csr_op / csr_uses_imm / csr_addr / csr_zimm)
    16	//   - is_mret (給 core 在 WB 把 PC ← mepc)
    17	//   - illegal flag → core.v 觸發 trap (ebreak / ecall 走這條)
    18	//
    19	// 此模組沒有任何 register / clock，是純組合邏輯。
    20	// =============================================================================
    21	
    22	`include "def.vh"
    23	
    24	module idu (
    25	    input  [31:0] instr,
    26	
    27	    // Register indices
    28	    output [ 4:0] rd_idx,
    29	    output [ 4:0] rs1_idx,
    30	    output [ 4:0] rs2_idx,
    31	
    32	    // Sign-extended immediate
    33	    output reg [31:0] imm,
    34	
    35	    // ALU control
    36	    output reg [ 3:0] alu_op,
    37	    output            alu_b_use_imm,
    38	
    39	    // Write-back control
    40	    output            rd_we,
    41	    output reg [ 2:0] wb_sel,         // 000=ALU 001=PC+imm 010=PC+4 011=LSU 100=CSR
    42	
    43	    // Branch / jump control
    44	    output            is_branch,
    45	    output            branch_invert,   // 1 = BNE/BGE/BGEU
    46	    output      [1:0] br_type,         // funct3[2:1]: 00=eq 10=lt_s 11=lt_u (valid when is_branch)
    47	    output            is_jal,
    48	    output            is_jalr,
    49	
    50	    // Memory control
    51	    output            is_load,
    52	    output            is_store,
    53	    output [ 2:0]     ls_funct3,
    54	
    55	    // CSR / MRET (lab05 新加)
    56	    output            is_csr,
    57	    output [ 1:0]     csr_op,         // CSR_OP_W/S/C (def.vh)
    58	    output            csr_uses_imm,    // 0 = use rs1, 1 = use zimm
    59	    output [11:0]     csr_addr,
    60	    output [31:0]     csr_zimm,
    61	    output            is_mret,
    62	
    63	    // M extension (lab06 新加)
    64	    output            is_muldiv,       // 1 = RV32M 指令 (mul/div family)
    65	    output [ 2:0]     md_op,           // = funct3 (MD_MUL/MULH/.../REMU)
    66	    output            md_is_div,       // 1 = 走 div unit; 0 = 走 mul unit
    67	
    68	    // Exception
    69	    output            illegal
    70	);
    71	
    72	    // -------------------------------------------------------------------------
    73	    // 拆 instruction field
    74	    // -------------------------------------------------------------------------
    75	    wire [ 6:0] opcode = instr[ 6: 0];
    76	    wire [ 2:0] funct3 = instr[14:12];
    77	    /* verilator lint_off UNUSEDSIGNAL */
    78	    wire [ 6:0] funct7 = instr[31:25]; // RV32I 只實際讀 funct7[5] (SUB/SRA bit)
    79	    /* verilator lint_on UNUSEDSIGNAL */
    80	
    81	    assign rd_idx  = instr[11: 7];
    82	    assign rs1_idx = instr[19:15];
    83	    assign rs2_idx = instr[24:20];
    84	
    85	    // -------------------------------------------------------------------------
    86	    // 五種 immediate 格式 (RISC-V spec)
    87	    // -------------------------------------------------------------------------
    88	    wire [31:0] imm_i = {{20{instr[31]}}, instr[31:20]};
    89	    wire [31:0] imm_s = {{20{instr[31]}}, instr[31:25], instr[11:7]};
    90	    wire [31:0] imm_b = {{19{instr[31]}}, instr[31], instr[7], instr[30:25], instr[11:8], 1'b0};
    91	    wire [31:0] imm_u = {instr[31:12], 12'b0};
    92	    wire [31:0] imm_j = {{11{instr[31]}}, instr[31], instr[19:12], instr[20], instr[30:21], 1'b0};
    93	
    94	    // -------------------------------------------------------------------------
    95	    // 主分類 (基於 opcode)
    96	    // -------------------------------------------------------------------------
    97	    wire is_lui    = (opcode == `OPC_LUI);
    98	    wire is_auipc  = (opcode == `OPC_AUIPC);
    99	    wire is_op_imm = (opcode == `OPC_OP_IMM);
   100	    wire is_op     = (opcode == `OPC_OP);
   101	    wire is_system = (opcode == `OPC_SYSTEM);
   102	    wire is_fence  = (opcode == `OPC_FENCE);
   103	
   104	    assign is_jal    = (opcode == `OPC_JAL);
   105	    assign is_jalr   = (opcode == `OPC_JALR) && (funct3 == 3'b000);
   106	    assign is_branch = (opcode == `OPC_BRANCH);
   107	    assign is_load   = (opcode == `OPC_LOAD);
   108	    assign is_store  = (opcode == `OPC_STORE);
   109	
   110	    // -------------------------------------------------------------------------
   111	    // SYSTEM opcode (lab05) 區分三類：
   112	    //   * funct3 != 0 → CSR* (6 種，funct3 = 1/2/3/5/6/7)
   113	    //   * 完整 32-bit instr 等於 INSTR_MRET → MRET
