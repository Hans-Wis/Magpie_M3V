   160	    // ras_predict_ret→next_pc→i_mem_addr path via CDec case-select (cinstr[14], fo=44,
   161	    // 6 LUT levels) → fo=26 routing bottleneck.  Imm is irrelevant for RAS prediction.
   162	    wire if_is_ret_32  = (instr_assembled[6:0]  == 7'b1100111) &&  // JALR opcode
   163	                         (instr_assembled[11:7]  == 5'b00000)   &&  // rd = x0
   164	                         (instr_assembled[14:12] == 3'b000)     &&  // funct3 = 0
   165	                         (instr_assembled[19:15] == 5'b00001);      // rs1 = ra (x1)
   166	    wire if_is_ret_16  = is_16bit_w && (cinstr == 16'h8082);
   167	    wire if_is_ret     = if_is_ret_32 || if_is_ret_16;
