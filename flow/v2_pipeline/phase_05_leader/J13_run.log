 `include "def.vh"
 
-module ifu (
+module ifu #(
+    parameter [31:0] RESET_PC = `PC_RESET
+) (
     input             clk,
     input             resetn,
 
@@ -54,7 +56,7 @@
                                             pc_reg + pc_inc;
 
     always @(posedge clk) begin
-        if (!resetn) pc_reg <= `PC_RESET;
+        if (!resetn) pc_reg <= RESET_PC;
         else         pc_reg <= next_pc;
     end
 
diff --git a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/mul.v b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/mul.v
index d9e6b57e036e65e4f467b4b581c25530a49e73f9..97034422e8198c60c9b53606168206f6f572e1e7
--- a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/mul.v
+++ b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/mul.v
@@ -3,8 +3,8 @@
 // -----------------------------------------------------------------------------
 // 2-cycle latency from start to done：
 //   cycle 0 (start=1)         : latch op_a, op_b (sign-extend to 33 bit)
-//   cycle 1                   : compute product, latch result, done=1
-//   cycle 2                   : done=0, ready for next start
+//   cycle 1                   : compute product, latch result
+//   cycle 2                   : done=1 with stable result
 //
 // Sign extension table:
 //   md_op    op_a       op_b       result selection
@@ -26,16 +26,15 @@
     input      [ 2:0] md_op,
     input      [31:0] op_a,
     input      [31:0] op_b,
-    output     [31:0] result,
+    output reg [31:0] result,
     output reg        done
 );
 
     reg                busy;
+    reg                done_pending;
     reg signed [32:0]  opa_r, opb_r;
-    /* verilator lint_off UNUSEDSIGNAL */  // 用 [63:32] 跟 [31:0]，bit 64/65 是 sign-ext 不取
-    reg signed [65:0]  product;
-    /* verilator lint_on UNUSEDSIGNAL */
     reg                high_out;
+    wire signed [65:0] product_w = opa_r * opb_r;
 
     // -------------------------------------------------------------------------
     // Sign-extension based on md_op
@@ -52,25 +51,27 @@
         if (!resetn) begin
             busy     <= 1'b0;
             done     <= 1'b0;
+            done_pending <= 1'b0;
             high_out <= 1'b0;
         end else begin
             done <= 1'b0;
 
-            if (start && !busy) begin
+            if (done_pending) begin
+                done         <= 1'b1;
+                done_pending <= 1'b0;
+            end else if (start && !busy) begin
                 // Cycle 0: latch
                 opa_r    <= opa_ext;
                 opb_r    <= opb_ext;
                 high_out <= (md_op != `MD_MUL);
                 busy     <= 1'b1;
             end else if (busy) begin
-                // Cycle 1: multiply, result available, signal done
-                product <= opa_r * opb_r;
-                done    <= 1'b1;
-                busy    <= 1'b0;
+                // Cycle 1: multiply, latch result; signal done next cycle.
+                result       <= high_out ? product_w[63:32] : product_w[31:0];
+                done_pending <= 1'b1;
+                busy         <= 1'b0;
             end
         end
     end
-
-    assign result = high_out ? product[63:32] : product[31:0];
 
 endmodule
