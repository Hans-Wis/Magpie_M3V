     1	// =============================================================================
     2	// core.v — Lab08e 4-stage pipeline RV32IMC + CSR + IRQ + BP (2-way) + RAS
     3	//          (lab08d base + pre-fetch buffer eliminates cross-boundary stall)
     4	// -----------------------------------------------------------------------------
     5	// lab08d 加 cross_assemble/residue pre-fetch buffer：
     6	//   - Sequential 16-bit → 32-bit cross-boundary：0-cycle penalty (pre-fetch path)
     7	//   - Post-stall/redirect cross-boundary：1-cycle fallback (= lab08d 同)
     8	//   - any_stall 不再含 is_cross_boundary，只含 load-use/muldiv stall + warmup
     9	//
    10	// 預期：
    11	//   - clock: 75 MHz target (IF stage secondary path 消除，worst path 仍 d_mem store)
    12	//   - IPC: 36+ LED (cross-boundary stall 消除，lab08d firmware hot loop中)
    13	//   - Wall-clock: 75/65 × lab08d ≈ 1.55× lab07
    14	// =============================================================================
    15	
    16	`include "def.vh"
    17	
    18	module core (
    19	    input             clk,
    20	    input             resetn,
    21	    output            trap,
    22	    input             mem_stall,
    23	
    24	    // I-port (instr fetch, sync read-only)
    25	    output     [31:0] i_mem_addr,
    26	    output            i_mem_en,        // gates BRAM update; =!stall (lab06 新加)
    27	    input      [31:0] i_mem_rdata,
    28	
    29	    // D-port (data load/store)
    30	    output            d_mem_valid,
    31	    output     [31:0] d_mem_addr,
    32	    output     [31:0] d_mem_wdata,
    33	    output     [ 3:0] d_mem_wstrb,
    34	    input      [31:0] d_mem_rdata,
    35	
    36	    // External IRQ
    37	    input             irq_external_pulse,
    38	
    39	    // Debug
    40	    output     [31:0] dbg_pc,
    41	    output     [31:0] dbg_instr,
    42	    output     [ 2:0] dbg_state
    43	);
    44	
    45	    // =========================================================================
    46	    // Reset / redirect warmup
    47	    // =========================================================================
    48	    reg warmup;
    49	    always @(posedge clk) begin
    50	        if (!resetn) warmup <= 1'b1;
    51	        else         warmup <= 1'b0;   // 1 cycle bubble after reset (BRAM warm)
    52	    end
    53	
    54	    // =========================================================================
    55	    // IF stage : ifu + BP + RAS + cdec + cross-boundary fetch (RV32C)
    56	    // -------------------------------------------------------------------------
    57	    // Lab08e 改進自 lab08d：消除 cross-boundary 1-cycle stall。
    58	    //
    59	    // 舊設計 (lab08d)：在 cross-boundary detect cycle 插入 stall，下拍 assemble。
    60	    // 新設計 (lab08e)：在上一拍偵測到「下一條 instr 是 cross-boundary 32-bit」時
    61	    //   1. 提前 override i_mem_addr = if_pc+4 (= 下一個 word)
    62	    //   2. 保存 residue ← cur_half_hi (= 32-bit instr 的前 16 bits)
    63	    //   3. 設定 cross_assemble
    64	    //   下一拍直接用 {i_mem_rdata[15:0], residue} assemble，0 cycle penalty。
    65	    //
    66	    // 只有在 upcoming_cross 前一拍有 stall/redirect 時才退回 at_cross_boundary 路徑
    67	    // (= lab08d fallback，仍 1-cycle stall)。熱迴圈無 stall 前置 → 0-cycle。
    68	    // =========================================================================
    69	    wire [31:0] if_pc;        // = pc_reg (current decode PC)
    70	    wire [31:0] next_pc_w;    // combinational from ifu
    71	    reg         pc_redirect;
    72	    reg  [31:0] redirect_target;
    73	    wire        stall;         // load-use / muldiv stall (existing)
    74	    wire        flush_if_next; // bubble next-cycle IF/EX
    75	    reg         redirect_warmup; // 1-cycle refetch bubble after redirect
    76	
    77	    always @(posedge clk) begin
    78	        if (!resetn) redirect_warmup <= 1'b0;
    79	        else         redirect_warmup <= pc_redirect;
    80	    end
    81	
    82	    // Lab08c: BP (64-entry 2-way) + RAS (8-entry)
    83	    wire        bp_predict_taken;
    84	    wire [31:0] bp_predict_target;
    85	    wire        bp_upd_valid;
    86	    wire [31:0] bp_upd_pc;
    87	    wire        bp_upd_taken;
    88	    wire [31:0] bp_upd_target;
    89	
    90	    wire [31:0] ras_top;
    91	    wire        ras_push;
    92	    wire [31:0] ras_push_val;
    93	    wire        ras_pop;
    94	    wire        ras_predict_ret;
    95	
    96	    // Lab08e: residue-based pre-fetch (replaces wait_high + high_buf)
    97	    reg [15:0]  residue;        // saved high-half for upcoming cross-boundary assemble
    98	    reg         cross_assemble; // 1 = this cycle: assemble {i_mem_rdata[15:0], residue}
    99	
   100	    // ---- Pre-decode i_mem_rdata for instruction length ----
   101	    wire [15:0] cur_half_lo = i_mem_rdata[15:0];
   102	    wire [15:0] cur_half_hi = i_mem_rdata[31:16];
   103	    wire        is_comp_lo  = (cur_half_lo[1:0] != 2'b11);
   104	    wire        is_comp_hi  = (cur_half_hi[1:0] != 2'b11);
   105	
   106	    wire        cur_at_high = if_pc[1];   // current instr at high half of fetched word
   107	
   108	    // at_cross_boundary: fallback — arrived at cross-boundary without pre-setup
   109	    // (happens after stall / redirect blocked upcoming_cross the previous cycle)
   110	    wire        at_cross_boundary = cur_at_high && !is_comp_hi && !cross_assemble;
   111	
   112	    // upcoming_cross: sequential 16-bit at low half, FOLLOWED BY 32-bit at high half
