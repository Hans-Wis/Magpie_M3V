   162	
   163	        if (is_op_imm) begin
   164	            case (funct3)
   165	                `F3_ADD_SUB : alu_op = `ALU_ADD;   // ADDI (沒有 SUBI)
   166	                `F3_SLT     : alu_op = `ALU_SLT;
   167	                `F3_SLTU    : alu_op = `ALU_SLTU;
   168	                `F3_XOR     : alu_op = `ALU_XOR;
