    15	//   3. ras_predict_ret   (RAS top)
    16	//   4. bp_predict_taken  (BTB target)
    17	//   5. default           (pc + 2 or pc + 4 by is_16bit)
    18	//
    19	// PC 現在可以 PC[1] = 1 (RV32C 准許 2-byte aligned PC)。PC[0] 必須 = 0。
    20	// =============================================================================
    21	
    22	`include "def.vh"
    23	
    24	module ifu (
    25	    input             clk,
    26	    input             resetn,
    27	
    28	    input             pc_stall,        // 1 = hold pc_reg
    29	    input             pc_redirect,
    30	    input      [31:0] redirect_target,
    31	
    32	    input             ras_predict_ret,
    33	    input      [31:0] ras_predict_target,
    34	
    35	    input             bp_predict_taken,
    36	    input      [31:0] bp_predict_target,
    37	
    38	    // Lab08d: PC 增量由 instr length 決定
    39	    input             is_16bit,
    40	
    41	    output     [31:0] pc,               // pc_reg = current decode PC
    42	    output     [31:0] next_pc            // combinational, = pc_reg next-cycle value
    43	);
    44	
    45	    reg [31:0] pc_reg;
    46	    assign pc = pc_reg;
    47	
    48	    wire [31:0] pc_inc = is_16bit ? 32'd2 : 32'd4;
    49	
    50	    assign next_pc = pc_redirect          ? redirect_target :
    51	                     pc_stall             ? pc_reg :
    52	                     ras_predict_ret      ? ras_predict_target :
    53	                     bp_predict_taken     ? bp_predict_target :
    54	                                            pc_reg + pc_inc;
    55	
    56	    always @(posedge clk) begin
    57	        if (!resetn) pc_reg <= `PC_RESET;
    58	        else         pc_reg <= next_pc;
    59	    end
    60	
    61	endmodule

