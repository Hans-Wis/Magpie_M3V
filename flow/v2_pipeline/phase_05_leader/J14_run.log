+
+def _is_timing_csr_read(row: Commit) -> bool:
+    instr = row["instr"]
+    return (
+        (instr & 0x7F) == 0x73
+        and ((instr >> 12) & 0x7) != 0
+        and row["rd"] != 0
+        and row.get("csr", 0) in TIMING_CSRS
+    )
