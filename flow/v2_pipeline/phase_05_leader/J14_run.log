IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:947:    assign wb_take_irq = ex_wb_valid_r && irq_pending && !ex_wb_illegal_r && !wb_take_data_trap && !mem_stall;
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:948:    assign wb_trap_cause = wb_take_data_trap ?
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:952:    assign wb_trap_mtval  = ex_wb_alu_result_r;
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:955:    assign rfu_we      = ex_wb_valid_r && ex_wb_rd_we_r && !ex_wb_illegal_r && !wb_take_irq && !wb_take_data_trap && !mem_stall;
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:962:    //     2. MRET → mepc           (從 ex_wb)
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:975:        end else if (wb_take_irq) begin
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:978:        end else if (ex_wb_valid_r && ex_wb_is_mret_r) begin
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:980:            redirect_target = mepc_o;
