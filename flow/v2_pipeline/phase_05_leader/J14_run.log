+def _is_timing_csr_read(row: Commit) -> bool:
+    instr = row["instr"]
+    csr = row.get("csr", ((instr >> 20) & 0xFFF) if ((instr & 0x7F) == 0x73 and ((instr >> 12) & 0x7) != 0) else 0)
+    return (
+        (instr & 0x7F) == 0x73
+        and ((instr >> 12) & 0x7) != 0
+        and row["rd"] != 0
+        and csr in TIMING_CSRS
+    )
+
+
