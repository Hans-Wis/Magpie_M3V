                 "rd": int(row["rd"]),
                 "wdata": int(row["wdata"], 16),
+                "csr": int(row.get("csr", "0"), 16),
             }
             for row in csv.DictReader(fh)
         ]
@@ -241,7 +242,8 @@
             wdata = _eval_norm_wdata(instr, pc, rd, wdata)
         if rd != 0:
             norm_regs[rd] = wdata
-        rows.append({"idx": len(rows), "pc": pc, "instr": instr, "rd": rd, "wdata": wdata})
+        csr = ((instr >> 20) & 0xFFF) if ((instr & 0x7F) == 0x73 and ((instr >> 12) & 0x7) != 0) else 0
+        rows.append({"idx": len(rows), "pc": pc, "instr": instr, "rd": rd, "wdata": wdata, "csr": csr})
         if len(rows) >= limit:
