+NUM_VEC_GPR = 32
+VECTOR_EXTENSION_ENABLE = 0
+VLEN = 512
+ELEN = 32
+SELEN = 8
+VELEN = int(math.log(ELEN) // math.log(2)) - 3
+MAX_LMUL = 8
+NUM_HARTS = 1
+
+implemented_csr = [
