+VECTOR_EXTENSION_ENABLE = 0
+VLEN = 512
+ELEN = 32
+SELEN = 8
+VELEN = int(math.log(ELEN) // math.log(2)) - 3
+MAX_LMUL = 8
+NUM_HARTS = 1
+
+implemented_csr = [
+    privileged_reg_t.MHARTID,
+    privileged_reg_t.MSTATUS,
+    privileged_reg_t.MIE,
+    privileged_reg_t.MTVEC,
+    privileged_reg_t.MSCRATCH,
