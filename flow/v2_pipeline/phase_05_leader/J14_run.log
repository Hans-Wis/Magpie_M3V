 def write_commit_csv(path: Path, rows: list[Commit]) -> None:
     path.write_text(
-        "idx,pc,instr,rd,wdata\n"
+        "idx,pc,instr,rd,wdata,csr\n"
         + "".join(
-            f"{r['idx']},{r['pc']:08x},{r['instr']:08x},{r['rd']},{r['wdata']:08x}\n"
