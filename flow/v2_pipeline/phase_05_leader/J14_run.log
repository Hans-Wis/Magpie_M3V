IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:1000:    assign wb_trap_enter        = (wb_take_irq || wb_take_data_trap) && !mem_stall;
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:1001:    assign wb_trap_exit          = ex_wb_valid_r && ex_wb_is_mret_r && !mem_stall;
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:1002:    // trap_pc_for_mepc = 中斷時要保存的「下一條 PC」
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:1005:    assign wb_trap_pc_for_mepc = ex_wb_is_branch_taken_r ? ex_wb_pc_plus_imm_r :
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:1009:    assign wb_instr_retired = ex_wb_valid_r && !wb_take_irq && !wb_take_data_trap && !mem_stall;
IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v:1012:    // Trap output (illegal 進 TRAP 簡化版：直接卡死，不像 lab05 那麼正式)
