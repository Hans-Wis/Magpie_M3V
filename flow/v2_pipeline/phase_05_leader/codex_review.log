   430	def watchdog_trap_waiver(work: Path, dut: list[dict[str, int]], spike: list[dict[str, int]]) -> dict[str, int | str] | None:
   431	    if not dut or not spike:
   432	        return None
   433	    prefix_len = min(len(dut), len(spike))
   434	    prefix_ok, _ = compare_commits(dut[:prefix_len], spike[:prefix_len], label="watchdog-trap prefix")
   435	    if not prefix_ok:
   436	        return None
   437	    s_excs = spike_exceptions(work / "spike.log")
   438	    d_enters = [row for row in trap_rows(work / "dut_trap.trace") if row["event"] == "enter"]
   439	    if len(s_excs) < 2 or len(d_enters) < 2:
   440	        return None
   441	    srow = s_excs[-1]
   442	    drow = d_enters[-1]
   443	    same = (
   444	        int(drow["pc"]) == int(srow["pc"])
   445	        and int(drow["instr"]) == int(srow["instr"])
   446	        and int(drow["mcause"]) == int(srow["cause"])
   447	        and int(drow["mtval"]) == int(srow["mtval"])
   448	    )
   449	    if not same:
   450	        return None
   451	    return {
   452	        "matched_commits": prefix_len,
   453	        "dut_idx": int(drow["idx"]),
   454	        "pc": int(drow["pc"]),
   455	        "instr": int(drow["instr"]),
   456	        "mcause": int(drow["mcause"]),
   457	        "mtval": int(drow["mtval"]),
   458	        "spike_exception": str(srow["name"]),
   459	    }
