   307	    expected: dict[str, tuple[int | None, int]],
   308	) -> tuple[bool, str]:
   309	    for name, (expected_pc, expected_value) in expected.items():
   310	        if name not in events:
   311	            return False, f"missing trap event {name}"
   312	        pc, value = events[name]
   313	        if expected_pc is not None and pc != expected_pc:
   314	            return False, f"{name} pc mismatch: got 0x{pc:08x} expected 0x{expected_pc:08x}"
   315	        if value != expected_value:
   316	            return False, f"{name} value mismatch: got 0x{value:08x} expected 0x{expected_value:08x}"
   317	    return True, "trap events matched expected values"

