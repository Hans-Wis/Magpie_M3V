   355	def trap_rows(path: Path) -> list[dict[str, int | str]]:
   356	    if not path.exists():
   357	        return []
   358	    rows: list[dict[str, int | str]] = []
   359	    with path.open(newline="", encoding="utf-8") as fh:
   360	        for row in csv.DictReader(fh):
   361	            rows.append({
   362	                "idx": int(row["idx"]),
   363	                "event": row["event"],
   364	                "pc": int(row["pc"], 16),
   365	                "instr": int(row["instr"], 16),
   366	                "mepc": int(row["mepc"], 16),
   367	                "mcause": int(row["mcause"], 16),
   368	                "mtval": int(row["mtval"], 16),
   369	                "mstatus": int(row["mstatus"], 16),
   370	            })
   371	    return rows
