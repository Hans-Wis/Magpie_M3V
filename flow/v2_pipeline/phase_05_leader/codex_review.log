   489	def sim_compare_seed(seed: int, work: Path, max_cycles: int) -> tuple[int, bool, bool, str]:
   490	    """Build firmware (from work/firmware.S), run the DUT, run Spike, lockstep compare.
   491	    Parallel-safe: reads the shared Verilator binary (build it ONCE up front via
   492	    verilator_bin()) and writes only inside `work`. The riscv-dv generation step
   493	    (generate_seed) is intentionally NOT here -- it mutates shared vendored riscv-dv
   494	    state and must run serially; the parallel script farm (dv_farm.py) pre-generates the
   495	    corpus serially, then fans this function out across workers."""
   496	    build_firmware(work)
   497	    dut_completed, dut_status = run_dut(work, max_cycles)
   498	    dut = parse_dut_commits(work / "dut_commit.trace")
   499	    # Terminal alignment: the program ends by writing `tohost`; Spike (HTIF) stops
   500	    # exactly there, but the DUT TB keeps looping at `write_tohost` until its own
   501	    # terminal, inflating the DUT commit count. Truncate the DUT trace at the first
   502	    # entry into `write_tohost` so both end at the SAME program point. This is NOT
   503	    # masking: compare_commits still checks every commit up to that shared exit, and
   504	    # a real divergence before exit (or one that prevents reaching write_tohost) is
   505	    # still caught.
   506	    # Grok-safe terminal alignment (replaces the earlier fragile `dut[:_i+2]`, which
   507	    # assumed write_tohost is exactly auipc+sw and was flagged as a masking risk in
   508	    # adversarial review): trim the DUT trace at its OWN architectural exit -- the first
   509	    # commit that enters `write_tohost` -- and keep that commit. This does NOT mask:
   510	    #  - a per-commit divergence before the exit is still compared and caught;
   511	    #  - a bug that routes the DUT into write_tohost EARLY puts pc==write_tohost at a
   512	    #    commit where Spike is still in user code, so compare_commits mismatches there;
   513	    #  - it makes no assumption about the size/shape of the exit stub.
   514	    _wt = elf_symbol(work, "write_tohost")
   515	    if _wt is not None:
   516	        for _i, _c in enumerate(dut):
   517	            if _c["pc"] == _wt:
   518	                dut = dut[:_i + 1]  # keep up to and including the first write_tohost commit
   519	                break
   520	    # Spike --instructions budget must be GENEROUS, not len(dut)+32: around a
   521	    # synchronous trap Spike executes setup + handler instructions whose count
   522	    # does not match the DUT commit count, so a tight budget truncates Spike
   523	    # right at the trap (looked like "Spike halts at ecall"). The program exits
   524	    # naturally via the tohost write, so a large cap is safe; we still compare
   525	    # only the first len(dut) commits below.
   526	    spike_budget = max(len(dut) * 8 + 20000, 100_000) if dut_completed else 200_000
   527	    run_spike(work, spike_budget)
   528	    spike = parse_spike_commits(
   529	        work / "spike.log",
   530	        limit=len(dut),
   531	        pc_base=0,
   532	        stop_instrs=set(),
   533	        normalize_wdata_base=False,
   534	    )
   535	    write_commit_csv(work / "spike_commit.trace", spike)
   536	    if not dut_completed:
   537	        waiver = watchdog_trap_waiver(work, dut, spike)
   538	        if waiver is not None:
   539	            evidence = (
   540	                f"handler_watchdog_waived prefix_commits={waiver['matched_commits']} "
   541	                f"dut_idx={waiver['dut_idx']} pc=0x{waiver['pc']:08x} "
   542	                f"instr=0x{waiver['instr']:08x} mcause=0x{waiver['mcause']:08x} "
   543	                f"mtval=0x{waiver['mtval']:08x} spike={waiver['spike_exception']}"
   544	            )
   545	            return int(waiver["matched_commits"]), True, True, evidence
   546	        div = write_divergence(seed, work, dut_status)
   547	        return len(dut), False, False, f"{dut_status}; divergence={div}"
   548	    ok, message = compare_commits(dut, spike, label=f"riscv-dv seed {seed}")
   549	    trap_count = 0
   550	    trap_path = work / "dut_trap.trace"
   551	    if trap_path.exists():
   552	        with trap_path.open(newline="", encoding="utf-8") as fh:
   553	            trap_count = sum(1 for row in csv.DictReader(fh) if row.get("event") == "enter")
