   113	    lets dv_farm.py parallelize generation, the real serial bottleneck."""
   114	    env = os.environ.copy()
   115	    env["PYTHONPATH"] = str(RISCV_DV / "pygen") + (":" + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
   116	    testlist = out / "testlist.yaml"
   117	    text = (ROOT / "config" / M1_CONFIG / "testlist.yaml").read_text(encoding="utf-8")
   118	    text = re.sub(r"--instr_cnt=\d+", f"--instr_cnt={instr_cnt}", text)
   119	    testlist.write_text(text, encoding="utf-8")
   120	    cmd = [
   121	        "python3", str(RISCV_DV / "run.py"),
   122	        "--target", GEN_TARGET,
   123	        "--simulator", "pyflow",
   124	        "--steps", "gen",
   125	        "--testlist", str(testlist),
   126	        "--test", "m1_rv32imc_arith",
   127	        "--iterations", "1",
   128	        "--seed", str(seed),
   129	        "--output", str(out / "riscv_dv_out"),
   130	        "--isa", ISA,
   131	        "--priv", "m",
   132	        "--mabi", MABI,
   133	    ]
   134	    run_cmd(cmd, ROOT, out / "riscvdv_gen.log", env)
   135	    asm = out / "riscv_dv_out/asm_test/m1_rv32imc_arith_0.S"
   136	    if not asm.exists():
   137	        raise FileNotFoundError(asm)
   138	    return asm
