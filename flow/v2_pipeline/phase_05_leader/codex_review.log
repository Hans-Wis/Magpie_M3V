   400	def matched_nested_trap_waiver(work: Path, dut: list[dict[str, int]], spike: list[dict[str, int]]) -> dict[str, int | str] | None:
   401	    if not spike or len(spike) >= len(dut):
   402	        return None
   403	    prefix_ok, _ = compare_commits(dut[:len(spike)], spike, label="nested-trap prefix")
   404	    if not prefix_ok:
   405	        return None
   406	    expected_idx = dut[len(spike)]["idx"]
   407	    for srow in reversed(spike_exceptions(work / "spike.log")):
   408	        for drow in trap_rows(work / "dut_trap.trace"):
   409	            if drow["event"] != "enter" or int(drow["idx"]) < expected_idx:
   410	                continue
   411	            same = (
   412	                int(drow["pc"]) == int(srow["pc"])
   413	                and int(drow["instr"]) == int(srow["instr"])
   414	                and int(drow["mcause"]) == int(srow["cause"])
   415	                and int(drow["mtval"]) == int(srow["mtval"])
   416	            )
   417	            if same:
   418	                return {
   419	                    "matched_commits": len(spike),
   420	                    "dut_idx": int(drow["idx"]),
   421	                    "pc": int(drow["pc"]),
   422	                    "instr": int(drow["instr"]),
   423	                    "mcause": int(drow["mcause"]),
   424	                    "mtval": int(drow["mtval"]),
   425	                    "spike_exception": str(srow["name"]),
   426	                }
   427	    return None
