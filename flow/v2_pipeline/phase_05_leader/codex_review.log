   307	def run_dut(work: Path, max_cycles: int) -> tuple[bool, str]:
   308	    sim = verilator_bin()
   309	    stop_addr = elf_symbol(work, "tohost")
   310	    cmd = [
   311	        str(sim),
   312	        f"+HEX={work / 'firmware.hex'}",
   313	        f"+TRACE={work / 'dut_commit.trace'}",
   314	        f"+TRAP_TRACE={work / 'dut_trap.trace'}",
   315	        f"+MAX_CYCLES={max_cycles}",
   316	        f"+STOP_ADDR={stop_addr:08x}",
   317	    ]
   318	    log = work / "sim.log"
   319	    with log.open("w", encoding="utf-8") as fh:
   320	        proc = subprocess.run(cmd, cwd=work, stdout=fh, stderr=subprocess.STDOUT, text=True)
   321	    sim_log = (work / "sim.log").read_text(encoding="utf-8", errors="replace")
   322	    if proc.returncode != 0:
   323	        if "FAIL: watchdog timeout" in sim_log:
   324	            return False, "watchdog timeout"
   325	        raise RuntimeError(f"command failed rc={proc.returncode}: {' '.join(cmd)}; see {log}")
   326	    if "DIVERGENCE:" in sim_log:
   327	        return False, "DUT divergence"
   328	    return True, "DUT completed"
