   374	def spike_exceptions(log: Path) -> list[dict[str, int | str]]:
   375	    rows: list[dict[str, int | str]] = []
   376	    last_instr: tuple[int, int] | None = None
   377	    pending: dict[str, int | str] | None = None
   378	    instr_re = re.compile(r"core\s+0:\s+0x([0-9a-f]+)\s+\(0x([0-9a-f]+)\)")
   379	    exc_re = re.compile(r"exception\s+(trap_[a-z_]+),\s+epc\s+0x([0-9a-f]+)")
   380	    tval_re = re.compile(r"tval\s+0x([0-9a-f]+)")
   381	    for line in log.read_text(encoding="utf-8", errors="replace").splitlines():
   382	        instr_match = instr_re.search(line)
   383	        if instr_match:
   384	            last_instr = (int(instr_match.group(1), 16), int(instr_match.group(2), 16))
   385	        exc_match = exc_re.search(line)
   386	        if exc_match:
   387	            name = exc_match.group(1)
   388	            epc = int(exc_match.group(2), 16)
   389	            instr = last_instr[1] if last_instr and last_instr[0] == epc else 0
   390	            pending = {"pc": epc, "instr": instr, "cause": TRAP_CAUSES.get(name, -1), "name": name, "mtval": 0}
   391	            rows.append(pending)
   392	            continue
   393	        tval_match = tval_re.search(line)
   394	        if tval_match and pending is not None:
   395	            pending["mtval"] = int(tval_match.group(1), 16)
   396	            pending = None
   397	    return rows
