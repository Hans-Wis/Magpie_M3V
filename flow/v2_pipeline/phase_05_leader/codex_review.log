   331	def run_spike(work: Path, instructions: int) -> None:
   332	    cmd = [
   333	        str(SPIKE),
   334	        f"--isa={SPIKE_ISA}",
   335	        "--priv=m",
   336	        "--disable-dtb",
   337	        "-m0x1000:0x40000",
   338	        f"--pc=0x{SPIKE_PC_BASE:08x}",
   339	        "--log-commits",
   340	        "-l",
   341	        f"--log={work / 'spike.log'}",
   342	        f"--instructions={instructions}",
   343	        str(work / "firmware.elf"),
   344	    ]
   345	    result = subprocess.run(cmd, cwd=work, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
   346	    if result.returncode not in (0, 255):
   347	        result.check_returncode()
