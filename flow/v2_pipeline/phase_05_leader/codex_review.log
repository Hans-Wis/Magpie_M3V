   296	def emit_verilog_hex(binary: Path, hex_path: Path) -> None:
   297	    data = binary.read_bytes()
   298	    if len(data) % 4:
   299	        data += b"\x00" * (4 - (len(data) % 4))
   300	    lines = []
   301	    for offset in range(0, len(data), 4):
   302	        word = int.from_bytes(data[offset:offset + 4], "little")
   303	        lines.append(f"{word:08x}\n")
   304	    hex_path.write_text("".join(lines), encoding="utf-8")
   305	
