   286	
   287	def elf_symbol(work: Path, name: str) -> int:
   288	    proc = subprocess.run([NM, "-n", "firmware.elf"], cwd=work, text=True, capture_output=True, check=True)
   289	    for line in proc.stdout.splitlines():
   290	        parts = line.split()
   291	        if len(parts) >= 3 and parts[2] == name:
   292	            return int(parts[0], 16)
   293	    raise RuntimeError(f"missing ELF symbol {name}")
