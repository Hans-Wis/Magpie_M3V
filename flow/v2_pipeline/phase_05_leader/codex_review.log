   141	def generate_seed(seed: int, out: Path, instr_cnt: int) -> Path:
   142	    """Single-seed generation (install shared target -> gen -> restore). Serial only."""
   143	    backups = install_riscvdv_target()
   144	    try:
   145	        return gen_core(seed, out, instr_cnt)
   146	    finally:
   147	        restore_riscvdv_target(backups)
