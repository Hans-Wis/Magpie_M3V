   462	def write_divergence(seed: int, work: Path, message: str) -> Path:
   463	    div_dir = ROOT / "divergence"
   464	    div_dir.mkdir(exist_ok=True)
   465	    dut_rows = commit_rows(work / "dut_commit.trace")
   466	    spike_rows = commit_rows(work / "spike_commit.trace")
   467	    idx = min(len(dut_rows), len(spike_rows))
   468	    for cur_idx, (drow, srow) in enumerate(zip(dut_rows, spike_rows)):
   469	        if drow != srow:
   470	            idx = cur_idx
   471	            break
   472	    context_start = max(0, idx - 20)
   473	    detail = {
   474	        "seed": seed,
   475	        "message": message,
   476	        "mismatch_index": idx,
   477	        "dut": dut_rows[idx] if idx < len(dut_rows) else None,
   478	        "spike": spike_rows[idx] if idx < len(spike_rows) else None,
   479	        "last_20_dut": dut_rows[context_start:idx],
   480	        "last_20_spike": spike_rows[context_start:idx],
   481	        "repro": str(work),
   482	    }
   483	    (div_dir / f"seed_{seed}_divergence.json").write_text(json.dumps(detail, indent=2), encoding="utf-8")
   484	    shutil.copy2(work / "firmware.S", div_dir / f"seed_{seed}_firmware.S")
   485	    shutil.copy2(work / "firmware.disasm", div_dir / f"seed_{seed}_firmware.disasm")
   486	    return div_dir / f"seed_{seed}_divergence.json"
