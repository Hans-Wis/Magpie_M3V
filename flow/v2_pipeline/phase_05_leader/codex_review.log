   272	def build_firmware(work: Path) -> None:
   273	    include_user = RISCV_DV / "user_extension"
   274	    cmd = [
   275	        GCC, "-Os", f"-march={ISA}", f"-mabi={MABI}",
   276	        "-nostartfiles", "-nostdlib", "-ffreestanding",
   277	        "-I", str(include_user),
   278	        "-Wl,-Bstatic,-T," + str(ROOT / "firmware.lds") + ",--strip-debug",
   279	        "-o", "firmware.elf", "firmware.S",
   280	    ]
   281	    run_cmd(cmd, work, work / "firmware_build.log")
   282	    run_cmd([OBJCOPY, "-O", "binary", "firmware.elf", "firmware.bin"], work, work / "firmware_objcopy.log")
   283	    emit_verilog_hex(work / "firmware.bin", work / "firmware.hex")
   284	    run_cmd([OBJDUMP, "-d", "firmware.elf"], work, work / "firmware.disasm")
