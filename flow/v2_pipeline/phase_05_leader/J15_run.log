     2	// cpu_m1_top  (Magpie_M1 CPU IP wrapper, Phase 2.1 mem-wrapper, ADR-0005)
     3	//
     4	// Presents Harvard, single-outstanding, ready-gated valid/ready I/D busses and
     5	// adapts the fixed-latency (registered-read look-ahead) `core` to variable bus
     6	// latency by freezing the pipeline through `core.mem_stall`.
     7	//
     8	// Per-port controller (I and D identical):
     9	//   fire  = core_req && !busy && !mem_stall   // start a bus xfer (not mid-freeze)
    10	//   req   = fire || busy                       // req held until ready
    11	//   addr  = busy ? latched : core              // stable address while waiting
    12	//   xfer  = req && ready                        // transaction completes this cycle
    13	//   on xfer: capture rdata into a register -> presented to core next cycle
    14	//   busy (registered): set on an unready fire, cleared on ready
    15	//   mem_stall = i_busy || d_busy
    16	//
    17	// Why this is correct:
    18	//  - 0 wait states (ready always 1, combinational-read memory): busy never sets,
    19	//    mem_stall stays 0, and `rdata_q <= bus_rdata when fire` is bit-identical to
    20	//    the native TB `if (en) i_mem_rdata <= mem[addr]`. => baseline equivalence.
    21	//  - With wait states: mem_stall is registered so it lags one cycle; the issuing
    22	//    instruction advances out of its stage on the (mem_stall==0) issue cycle, and
    23	//    the freeze protects the *next* cycle's data consumption. `!mem_stall` in
    24	//    `fire` forbids launching a second mem-op while frozen, so the single shared
    25	//    captured-data register is never clobbered before it is consumed.
    26	//  - Misalignment is handled inside `core` (no misaligned bus request is issued).
    27	// =============================================================================
    28	
    29	module cpu_m1_top(
    30	    input             clk,
    31	    input             resetn,
    32	
    33	    output            trap,
    34	
    35	    // I-side valid/ready (read-only, 1 outstanding)
    36	    output            ibus_req,
    37	    output     [31:0] ibus_addr,
    38	    input             ibus_ready,
    39	    input      [31:0] ibus_rdata,
    40	
    41	    // D-side valid/ready (1 outstanding)
    42	    output            dbus_req,
    43	    output     [31:0] dbus_addr,
    44	    output            dbus_we,
    45	    output     [ 3:0] dbus_wstrb,
    46	    output     [31:0] dbus_wdata,
    47	    input             dbus_ready,
    48	    input      [31:0] dbus_rdata,
    49	
    50	    input             irq_external_pulse,
    51	
    52	    output     [31:0] dbg_pc,
    53	    output     [31:0] dbg_instr,
    54	    output     [ 2:0] dbg_state
    55	);
    56	
    57	    // ---- core-facing native signals ----
    58	    wire        core_i_mem_en;
    59	    wire [31:0] core_i_mem_addr;
    60	    wire        core_d_mem_valid;
    61	    wire [31:0] core_d_mem_addr;
    62	    wire [31:0] core_d_mem_wdata;
    63	    wire [ 3:0] core_d_mem_wstrb;
    64	
    65	    // ---- per-port state ----
    66	    reg        i_busy;
    67	    reg [31:0] i_addr_q;
    68	    reg [31:0] i_rdata_q;
    69	
    70	    reg        d_busy;
    71	    reg [31:0] d_addr_q;
    72	    reg [31:0] d_wdata_q;
    73	    reg [ 3:0] d_wstrb_q;
    74	    reg [31:0] d_rdata_q;
    75	
    76	    reg primed;   // reset-vector instruction word captured into i_rdata_q
    77	
    78	    // single global freeze: any port waiting for its bus, OR the boot prime not
    79	    // yet done. Forced 0 under reset so the core's mem_stall input is never X
    80	    // while the busy/primed regs are still resetting.
    81	    wire mem_stall = ((i_busy | d_busy) | ~primed) & resetn;
    82	
    83	    // ---- I-port controller ----
    84	    // The look-ahead core assumes the reset-vector instruction is already in
    85	    // i_mem_rdata when it leaves warmup; a variable-latency bus cannot guarantee
    86	    // that, so the wrapper boot-fetches address 0 and freezes (mem_stall) until
    87	    // mem[0] is captured. This replaces the native always-on-BRAM priming.
    88	    wire i_boot = ~primed;
    89	    wire i_fire = core_i_mem_en & ~i_busy & ~mem_stall;
    90	    assign ibus_req  = i_boot | i_fire | i_busy;
    91	    assign ibus_addr = i_boot ? 32'h0 : (i_busy ? i_addr_q : core_i_mem_addr);
    92	    wire   i_xfer    = ibus_req & ibus_ready;
    93	
    94	    always @(posedge clk) begin
    95	        if (!resetn) begin
    96	            i_busy   <= 1'b0;
    97	            i_addr_q <= 32'h0;
    98	            primed   <= 1'b0;
    99	            // i_rdata_q intentionally NOT reset (captured memory data persists)
   100	        end else begin
   101	            if (i_fire & ~ibus_ready) begin
   102	                i_busy   <= 1'b1;
   103	                i_addr_q <= core_i_mem_addr;
   104	            end else if (i_busy & ibus_ready) begin
   105	                i_busy   <= 1'b0;
   106	            end
   107	        end
   108	        if (i_xfer) i_rdata_q <= ibus_rdata;       // boot word + normal fetches
   109	        if (i_boot & ibus_ready) primed <= 1'b1;   // boot prime complete
   110	    end
   111	
   112	    // ---- D-port controller ----
   113	    wire d_fire = core_d_mem_valid & ~d_busy & ~mem_stall;
   114	    assign dbus_req   = d_fire | d_busy;
   115	    assign dbus_addr  = d_busy ? d_addr_q  : core_d_mem_addr;
   116	    assign dbus_wdata = d_busy ? d_wdata_q : core_d_mem_wdata;
   117	    assign dbus_wstrb = d_busy ? d_wstrb_q : core_d_mem_wstrb;
   118	    assign dbus_we    = |dbus_wstrb;
   119	    wire   d_xfer     = dbus_req & dbus_ready;
   120	
   121	    always @(posedge clk) begin
   122	        if (!resetn) begin
   123	            d_busy    <= 1'b0;
   124	            d_addr_q  <= 32'h0;
   125	            d_wdata_q <= 32'h0;
   126	            d_wstrb_q <= 4'h0;
   127	            // d_rdata_q intentionally NOT reset (captured memory data persists)
   128	        end else begin
   129	            if (d_fire & ~dbus_ready) begin
   130	                d_busy    <= 1'b1;
   131	                d_addr_q  <= core_d_mem_addr;
   132	                d_wdata_q <= core_d_mem_wdata;
   133	                d_wstrb_q <= core_d_mem_wstrb;
   134	            end else if (d_busy & dbus_ready) begin
   135	                d_busy    <= 1'b0;
   136	            end
   137	        end
   138	        if (d_xfer) d_rdata_q <= dbus_rdata;
   139	    end
   140	
   141	    // ---- core ----
   142	    core u_core(
   143	        .clk                (clk),
   144	        .resetn             (resetn),
   145	        .trap               (trap),
   146	        .mem_stall          (mem_stall),
   147	
   148	        .i_mem_addr         (core_i_mem_addr),
   149	        .i_mem_en           (core_i_mem_en),
   150	        .i_mem_rdata        (i_rdata_q),
   151	
   152	        .d_mem_valid        (core_d_mem_valid),
   153	        .d_mem_addr         (core_d_mem_addr),
   154	        .d_mem_wdata        (core_d_mem_wdata),
   155	        .d_mem_wstrb        (core_d_mem_wstrb),
   156	        .d_mem_rdata        (d_rdata_q),
   157	
   158	        .irq_external_pulse (irq_external_pulse),
   159	
   160	        .dbg_pc             (dbg_pc),
   161	        .dbg_instr          (dbg_instr),
   162	        .dbg_state          (dbg_state)
   163	    );
   164	
   165	endmodule

