     1	// =============================================================================
     2	// core.v — Lab08e 4-stage pipeline RV32IMC + CSR + IRQ + BP (2-way) + RAS
     3	//          (lab08d base + pre-fetch buffer eliminates cross-boundary stall)
     4	// -----------------------------------------------------------------------------
     5	// lab08d 加 cross_assemble/residue pre-fetch buffer：
     6	//   - Sequential 16-bit → 32-bit cross-boundary：0-cycle penalty (pre-fetch path)
     7	//   - Post-stall/redirect cross-boundary：1-cycle fallback (= lab08d 同)
     8	//   - any_stall 不再含 is_cross_boundary，只含 load-use/muldiv stall + warmup
     9	//
    10	// 預期：
    11	//   - clock: 75 MHz target (IF stage secondary path 消除，worst path 仍 d_mem store)
    12	//   - IPC: 36+ LED (cross-boundary stall 消除，lab08d firmware hot loop中)
    13	//   - Wall-clock: 75/65 × lab08d ≈ 1.55× lab07
    14	// =============================================================================
    15	
    16	`include "def.vh"
    17	
    18	module core #(
    19	    parameter [31:0] RESET_PC = `PC_RESET
    20	) (
    21	    input             clk,
    22	    input             resetn,
    23	    output            trap,
    24	    input             mem_stall,
    25	
    26	    // I-port (instr fetch, sync read-only)
    27	    output     [31:0] i_mem_addr,
    28	    output            i_mem_en,        // gates BRAM update; =!stall (lab06 新加)
    29	    input      [31:0] i_mem_rdata,
    30	
    31	    // D-port (data load/store)
    32	    output            d_mem_valid,
    33	    output     [31:0] d_mem_addr,
    34	    output     [31:0] d_mem_wdata,
    35	    output     [ 3:0] d_mem_wstrb,
    36	    input      [31:0] d_mem_rdata,
    37	
    38	    // External IRQ
    39	    input             irq_external_pulse,
    40	
    41	    // Debug
    42	    output     [31:0] dbg_pc,
    43	    output     [31:0] dbg_instr,
    44	    output     [ 2:0] dbg_state
    45	);
    46	
    47	    // =========================================================================
    48	    // Reset / redirect warmup
    49	    // =========================================================================
    50	    reg warmup;
    51	    always @(posedge clk) begin
    52	        if (!resetn) warmup <= 1'b1;
    53	        else         warmup <= 1'b0;   // 1 cycle bubble after reset (BRAM warm)
    54	    end
    55	
    56	    // =========================================================================
    57	    // IF stage : ifu + BP + RAS + cdec + cross-boundary fetch (RV32C)
    58	    // -------------------------------------------------------------------------
    59	    // Lab08e 改進自 lab08d：消除 cross-boundary 1-cycle stall。
    60	    //
    61	    // 舊設計 (lab08d)：在 cross-boundary detect cycle 插入 stall，下拍 assemble。
    62	    // 新設計 (lab08e)：在上一拍偵測到「下一條 instr 是 cross-boundary 32-bit」時
    63	    //   1. 提前 override i_mem_addr = if_pc+4 (= 下一個 word)
    64	    //   2. 保存 residue ← cur_half_hi (= 32-bit instr 的前 16 bits)
    65	    //   3. 設定 cross_assemble
    66	    //   下一拍直接用 {i_mem_rdata[15:0], residue} assemble，0 cycle penalty。
    67	    //
    68	    // 只有在 upcoming_cross 前一拍有 stall/redirect 時才退回 at_cross_boundary 路徑
    69	    // (= lab08d fallback，仍 1-cycle stall)。熱迴圈無 stall 前置 → 0-cycle。
    70	    // =========================================================================
    71	    wire [31:0] if_pc;        // = pc_reg (current decode PC)
    72	    wire [31:0] next_pc_w;    // combinational from ifu
    73	    reg         pc_redirect;
    74	    reg  [31:0] redirect_target;
    75	    wire        stall;         // load-use / muldiv stall (existing)
    76	    wire        flush_if_next; // bubble next-cycle IF/EX
    77	    reg         redirect_warmup; // 1-cycle refetch bubble after redirect
    78	
    79	    always @(posedge clk) begin
    80	        if (!resetn) redirect_warmup <= 1'b0;
    81	        else         redirect_warmup <= pc_redirect;
    82	    end
    83	
    84	    // Lab08c: BP (64-entry 2-way) + RAS (8-entry)
    85	    wire        bp_predict_taken;
    86	    wire [31:0] bp_predict_target;
    87	    wire        bp_upd_valid;
    88	    wire [31:0] bp_upd_pc;
    89	    wire        bp_upd_taken;
    90	    wire [31:0] bp_upd_target;
    91	
    92	    wire [31:0] ras_top;
    93	    wire        ras_push;
    94	    wire [31:0] ras_push_val;
    95	    wire        ras_pop;
    96	    wire        ras_predict_ret;
    97	
    98	    // Lab08e: residue-based pre-fetch (replaces wait_high + high_buf)
    99	    reg [15:0]  residue;        // saved high-half for upcoming cross-boundary assemble
   100	    reg         cross_assemble; // 1 = this cycle: assemble {i_mem_rdata[15:0], residue}
   101	
   102	    // ---- Pre-decode i_mem_rdata for instruction length ----
   103	    wire [15:0] cur_half_lo = i_mem_rdata[15:0];
   104	    wire [15:0] cur_half_hi = i_mem_rdata[31:16];
   105	    wire        is_comp_lo  = (cur_half_lo[1:0] != 2'b11);
   106	    wire        is_comp_hi  = (cur_half_hi[1:0] != 2'b11);
   107	
   108	    wire        cur_at_high = if_pc[1];   // current instr at high half of fetched word
   109	
   110	    // at_cross_boundary: fallback — arrived at cross-boundary without pre-setup
   111	    // (happens after stall / redirect blocked upcoming_cross the previous cycle)
   112	    wire        at_cross_boundary = cur_at_high && !is_comp_hi && !cross_assemble;
   113	
   114	    // upcoming_cross: sequential 16-bit at low half, FOLLOWED BY 32-bit at high half
   115	    // Only fires when current instr is 16-bit at low half AND high half is 32-bit start,
   116	    // with no prediction override or stall this cycle. Guarantees residue = correct high-half.
   117	    wire        upcoming_cross = !cur_at_high && is_comp_lo && !is_comp_hi &&
   118	                                  !cross_assemble && !stall && !warmup && !redirect_warmup && !pc_redirect &&
   119	                                  !mem_stall &&
   120	                                  !bp_predict_taken && !ras_predict_ret;
   121	
   122	    // Consecutive high-half 32-bit instructions remain cross-boundary.  While
   123	    // consuming the current assembled instruction, save this word's high half
   124	    // and fetch the next word so the following instruction also has 0-cycle
   125	    // assembly.
   126	    wire        consecutive_cross = cross_assemble && cur_at_high && !is_comp_hi &&
   127	                                     !stall && !warmup && !redirect_warmup && !pc_redirect && !mem_stall &&
   128	                                     !bp_predict_taken && !ras_predict_ret;
   129	
   130	    // is_16bit signal (drives ifu pc_inc)
   131	    wire        is_16bit_w = cross_assemble  ? 1'b0 :       // assembled cross = 32-bit
   132	                              cur_at_high    ? is_comp_hi :
   133	                                               is_comp_lo;
   134	
   135	    // fetch_stall: only fallback cross-boundary detection (not upcoming_cross path)
   136	    wire        fetch_stall = at_cross_boundary;
   137	    wire        any_stall   = stall | fetch_stall | warmup | redirect_warmup | mem_stall;
   138	
   139	    // ---- Compressed expander ----
   140	    wire [15:0] cinstr   = cur_at_high ? cur_half_hi : cur_half_lo;
   141	    wire [31:0] cdec_expanded;
   142	    wire        cdec_illegal;
   143	    cdec u_cdec (
   144	        .cinstr   (cinstr),
   145	        .expanded (cdec_expanded),
   146	        .illegal  (cdec_illegal)
   147	    );
   148	
   149	    // ---- Assembled 32-bit instruction (output to if_ex) ----
   150	    // cross_assemble: {new_word[15:0], residue} — both from registers (short path)
   151	    // compressed: cdec output
   152	    // aligned 32-bit (PC[1]=0): i_mem_rdata directly
   153	    // (at_cross_boundary case produces garbage but any_stall=1 prevents latching)
   154	    wire [31:0] instr_assembled =
   155	        cross_assemble  ? {cur_half_lo, residue} :
   156	        is_16bit_w      ? cdec_expanded :
   157	                          i_mem_rdata;
   158	
   159	    // ---- RET detection (for RAS pop) ----
   160	    // lab08e v3: check only opcode+rd+funct3+rs1, not imm bits [31:20].
   161	    // Full equality (== 32'h00008067) pulled cdec_expanded[23] (imm[11]) into the
   162	    // ras_predict_ret→next_pc→i_mem_addr path via CDec case-select (cinstr[14], fo=44,
   163	    // 6 LUT levels) → fo=26 routing bottleneck.  Imm is irrelevant for RAS prediction.
   164	    wire if_is_ret_32  = (instr_assembled[6:0]  == 7'b1100111) &&  // JALR opcode
   165	                         (instr_assembled[11:7]  == 5'b00000)   &&  // rd = x0
   166	                         (instr_assembled[14:12] == 3'b000)     &&  // funct3 = 0
   167	                         (instr_assembled[19:15] == 5'b00001);      // rs1 = ra (x1)
   168	    wire if_is_ret_16  = is_16bit_w && (cinstr == 16'h8082);
   169	    wire if_is_ret     = if_is_ret_32 || if_is_ret_16;
   170	
   171	    wire        ras_valid      = (ras_top != 32'h0);
   172	    assign      ras_predict_ret = if_is_ret && ras_valid && !any_stall && !pc_redirect;
   173	    // VCS-compatible split declaration for: wire        ras_predict_ret = if_is_ret && ras_valid && !any_stall && !pc_redirect;
   174	
   175	    assign ras_pop = ras_predict_ret;
   176	
   177	    // ---- BP / RAS / ifu instantiation ----
   178	    bp u_bp (
   179	        .clk               (clk),
   180	        .resetn            (resetn),
   181	        .if_pc             (if_pc),
   182	        .bp_predict_taken  (bp_predict_taken),
   183	        .bp_predict_target (bp_predict_target),
   184	        .upd_valid         (bp_upd_valid),
   185	        .upd_pc            (bp_upd_pc),
   186	        .upd_taken         (bp_upd_taken),
   187	        .upd_target        (bp_upd_target)
   188	    );
   189	
   190	    ras u_ras (
   191	        .clk      (clk),
   192	        .resetn   (resetn),
   193	        .ras_top  (ras_top),
   194	        .push     (ras_push),
   195	        .push_val (ras_push_val),
   196	        .pop      (ras_pop)
   197	    );
   198	
   199	    ifu #(
   200	        .RESET_PC(RESET_PC)
   201	    ) u_ifu (
   202	        .clk                (clk),
   203	        .resetn             (resetn),
   204	        .pc_stall           (any_stall),
   205	        .pc_redirect        (pc_redirect),
   206	        .redirect_target    (redirect_target),
   207	        .ras_predict_ret    (ras_predict_ret),
   208	        .ras_predict_target (ras_top),
   209	        .bp_predict_taken   (bp_predict_taken),
   210	        .bp_predict_target  (bp_predict_target),
   211	        .is_16bit           (is_16bit_w),
   212	        .pc                 (if_pc),
   213	        .next_pc            (next_pc_w)
   214	    );
   215	
   216	    // i_mem_addr drive:
   217	    //   at_cross_boundary: fetch next word (fallback, same as lab08d)
   218	    //   consecutive_cross: keep pre-fetching for runs of high-half 32-bit instrs
   219	    //   upcoming_cross:    pre-fetch next word one cycle early (if_pc[1]=0 → +4 = next word)
   220	    //   else:              look-ahead via next_pc_w (normal)
   221	    assign i_mem_addr = at_cross_boundary ? (if_pc + 32'd2) :
   222	                        consecutive_cross ? (if_pc + 32'd6) :
   223	                        upcoming_cross    ? (if_pc + 32'd4) :
   224	                                            next_pc_w;
   225	    // Keep BRAM active during at_cross_boundary even if lu/md stall fires simultaneously.
   226	    // (same fix as lab08d §problems_log 1, but now only needed for fallback path)
   227	    assign i_mem_en   = (pc_redirect || redirect_warmup || !stall || at_cross_boundary) && !mem_stall;
   228	
   229	    // ---- Cross-boundary state machine ----
   230	    always @(posedge clk) begin
   231	        if (!resetn || pc_redirect) begin
   232	            cross_assemble <= 1'b0;
   233	            residue        <= 16'h0;
   234	        end else if (consecutive_cross) begin
   235	            // Back-to-back high-half 32-bit: consume current and arm next.
   236	            cross_assemble <= 1'b1;
   237	            residue        <= cur_half_hi;
   238	        end else if (upcoming_cross) begin
   239	            // Pre-fetch path: no stall, save high-half for next cycle assembly
   240	            cross_assemble <= 1'b1;
   241	            residue        <= cur_half_hi;
   242	        end else if (at_cross_boundary && !warmup && !mem_stall) begin
   243	            // Fallback path: stall this cycle, set up for stall-free assembly next cycle
   244	            cross_assemble <= 1'b1;
   245	            residue        <= cur_half_hi;
   246	        end else if (!any_stall) begin
   247	            // Only clear when pipeline can advance; hold through stalls so BRAM data stays valid
   248	            cross_assemble <= 1'b0;
   249	        end
   250	    end
   251	
   252	    // =========================================================================
   253	    // IF/EX pipeline register
   254	    // =========================================================================
   255	    reg [31:0] if_ex_instr;
   256	    reg [31:0] if_ex_pc;
   257	    reg        if_ex_valid;
   258	    reg        if_ex_pred_taken;
   259	    reg        if_ex_pred_ras;
   260	    reg [31:0] if_ex_pred_target;
   261	    reg [31:0] if_ex_pred_ras_target;
   262	    reg        if_ex_is_16bit;  // instruction size flag for correct mepc / link-addr
   263	
   264	    always @(posedge clk) begin
   265	        if (!resetn) begin
   266	            if_ex_instr      <= 32'h0;
   267	            if_ex_pc         <= 32'h0;
   268	            if_ex_valid      <= 1'b0;
   269	            if_ex_pred_taken <= 1'b0;
   270	            if_ex_pred_ras   <= 1'b0;
   271	            if_ex_pred_target <= 32'h0;
   272	            if_ex_pred_ras_target <= 32'h0;
   273	            if_ex_is_16bit   <= 1'b0;
   274	        end else if (flush_if_next || warmup || redirect_warmup) begin
   275	            // Redirect must beat ordinary lu/md/fetch stalls; otherwise a
   276	            // wrong-path stalled instruction can survive and retire.  The
   277	            // extra redirect_warmup cycle lets sync i_mem_rdata catch up to
   278	            // the redirected PC before IF/EX latches again.
   279	            if_ex_instr      <= 32'h0;
   280	            if_ex_pc         <= 32'h0;
   281	            if_ex_valid      <= 1'b0;
   282	            if_ex_pred_taken <= 1'b0;
   283	            if_ex_pred_ras   <= 1'b0;
   284	            if_ex_pred_target <= 32'h0;
   285	            if_ex_pred_ras_target <= 32'h0;
