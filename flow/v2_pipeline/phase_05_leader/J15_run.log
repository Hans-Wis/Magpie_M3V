    33	    input             resetn,
    34	
    35	    // CSR read port (combinational, ID/EX stage 用)
    36	    input  [11:0]     csr_raddr,
    37	    output reg [31:0] csr_rdata,
    38	
    39	    // CSR write port (sync, EX/WB stage 用；可與 raddr 不同)
