    41	    input  [11:0]     csr_waddr,
    42	    input  [ 1:0]     csr_op,        // CSR_OP_W/S/C
    43	    input  [31:0]     csr_wdata,     // 直接寫入用 / set 用 mask / clear 用 mask
    44	    input  [31:0]     csr_old_val,   // = ex_wb 階段已 latch 的 OLD 值 (pipeline 用)
    45	
    46	    // Counter input
    47	    input             instr_retired,
    48	
    49	    // Trap entry (from core, single-cycle pulse in WB)
    50	    input             trap_enter,
    51	    input  [31:0]     trap_pc,       // pc to save in mepc (next_pc that would have executed)
    52	    input  [31:0]     trap_cause,
    53	    input  [31:0]     trap_mtval,
    54	
    55	    // Trap exit (mret)
    56	    input             trap_exit,
    57	
    58	    // External IRQ source (single-cycle pulse from debouncer)
