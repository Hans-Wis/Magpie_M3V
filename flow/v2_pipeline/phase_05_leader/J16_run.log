from __future__ import annotations

import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
PHASE = ROOT / "flow/v2_pipeline/phase_03_09_riscvdv_lockstep"
SUMMARY = PHASE / "riscvdv_lockstep_summary.json"
RESULTS = [
