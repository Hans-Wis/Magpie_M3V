proc first_regexp_match {path pattern default_value} {
    if {![file exists $path]} {
        return $default_value
    }
    set fp [open $path r]
    set text [read $fp]
    close $fp
    if {[regexp -line -- $pattern $text -> value]} {
        return $value
    }
    return $default_value
}
