   889	    reg [31:0] wb_data_mux;
   890	    always @* begin
   891	        case (ex_wb_wb_sel_r)
   892	            `WB_SEL_PCIMM: wb_data_mux = ex_wb_pc_plus_imm_r;
   893	            `WB_SEL_PC4  : wb_data_mux = ex_wb_pc_plus_4_r;
   894	            `WB_SEL_LSU  : wb_data_mux = lsu_ld_result_wb;
   895	            `WB_SEL_CSR  : wb_data_mux = ex_wb_csr_rdata_r;
   896	            `WB_SEL_MD   : wb_data_mux = ex_wb_md_result_r;
   897	            default      : wb_data_mux = ex_wb_alu_result_r;
   898	        endcase
   899	    end
   900	    assign wb_data = wb_data_mux;
   901	
   902	    // IRQ / precise load/store exception entry (在 WB commit boundary)
   903	    wire wb_take_data_trap = ex_wb_valid_r && ex_wb_is_misaligned_r;
   904	    assign wb_take_irq = ex_wb_valid_r && irq_pending && !ex_wb_illegal_r && !wb_take_data_trap && !mem_stall;
   905	    assign wb_trap_cause = wb_take_data_trap ?
   906	                           (ex_wb_is_misaligned_store_r ? `MCAUSE_STORE_ADDR_MISALIGNED :
   907	                                                          `MCAUSE_LOAD_ADDR_MISALIGNED) :
   908	                           `MCAUSE_EXT_IRQ;
   909	    assign wb_trap_mtval  = ex_wb_alu_result_r;
   910	
   911	    // RFU write
   912	    assign rfu_we      = ex_wb_valid_r && ex_wb_rd_we_r && !ex_wb_illegal_r && !wb_take_irq && !wb_take_data_trap && !mem_stall;
   913	    assign rfu_wr_idx  = ex_wb_rd_idx_r;
   914	    assign rfu_wr_data = wb_data;
   915	
   916	    // PC redirect decision (lab08b: 只在 mispredict 時 redirect)
   917	    //   優先級 (lab08c):
   918	    //     1. IRQ entry → mtvec     (從 ex_wb)
   919	    //     2. MRET → mepc           (從 ex_wb)
   920	    //     3. MEM-stage RAS target mispredict (= RAS 預測 target 跟 alu 算的不一致)
   921	    //     4. ex_mem mispredict (= lab08b 的 direction mispredict) — RAS-predicted 已自動
   922	    //        滿足 direction 比對 (pred_taken=1 + actual_taken=1)，不會在這分支 fire
   923	    //
   924	    //   RAS 預測對且 target 也對：mem_ras_mispredict=0、ex_mem_mispredict_r=0 → 不 redirect，
   925	    //   pipeline 順利往下走（IF 階段已從 RAS target fetch 完成）。
   926	    always @* begin
   927	        pc_redirect     = 1'b0;
   928	        redirect_target = 32'h0;
