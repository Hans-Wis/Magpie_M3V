   134	            end else if (d_busy & dbus_ready) begin
   135	                d_busy    <= 1'b0;
   136	            end
   137	        end
   138	        if (d_xfer) d_rdata_q <= dbus_rdata;
   139	    end
   140	
   141	    // ---- core ----
   142	    core u_core(
   143	        .clk                (clk),
   144	        .resetn             (resetn),
   145	        .trap               (trap),
   146	        .mem_stall          (mem_stall),
