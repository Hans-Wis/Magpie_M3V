   930	        if (mem_stall) begin
   931	            // ADR-0005 freeze: no PC redirect while waiting on memory
   932	        end else if (wb_take_irq) begin
   933	            pc_redirect     = 1'b1;
   934	            redirect_target = mtvec_o;
   935	        end else if (ex_wb_valid_r && ex_wb_is_mret_r) begin
   936	            pc_redirect     = 1'b1;
   937	            redirect_target = mepc_o;
   938	        end else if (mem_ras_mispredict) begin
   939	            // RAS 預測 target 跟 actual jalr target 不一致 — recovery 到 actual target
   940	            pc_redirect     = 1'b1;
   941	            redirect_target = mem_ras_actual_target;
   942	        end else if (ex_mem_valid_r && ex_mem_mispredict_r) begin
   943	            pc_redirect     = 1'b1;
   944	            // Recovery target combinational from ex_mem.Q registers (no alu_result on path)
   945	            //   is_jalr      → alu_result_r & ~1
   946	            //   branch_taken → pc_plus_imm_r
   947	            //   is_jal       → pc_plus_imm_r
   948	            //   else (branch not-taken mispredict) → pc_plus_4_r
   949	            redirect_target = ex_mem_is_jalr_r          ? (ex_mem_alu_result_r & ~32'd1) :
   950	                              ex_mem_is_branch_taken_r  ? ex_mem_pc_plus_imm_r :
   951	                              ex_mem_is_jal_r           ? ex_mem_pc_plus_imm_r :
   952	                                                          ex_mem_pc_plus_4_r;
   953	        end
   954	    end
   955	
   956	    // CSR / trap / instret 訊號
   957	    assign wb_trap_enter        = (wb_take_irq || wb_take_data_trap) && !mem_stall;
   958	    assign wb_trap_exit          = ex_wb_valid_r && ex_wb_is_mret_r && !mem_stall;
   959	    // trap_pc_for_mepc = 中斷時要保存的「下一條 PC」
   960	    //   被中斷的指令本身已 commit (rd_we=0 但 pc 已 +4 等概念)，所以存的是 next_pc
   961	    //   normal next_pc = pc+4；如果同時是 branch taken → pc+imm 之類
   962	    assign wb_trap_pc_for_mepc = ex_wb_is_branch_taken_r ? ex_wb_pc_plus_imm_r :
   963	                                  ex_wb_is_jal_r          ? ex_wb_pc_plus_imm_r :
