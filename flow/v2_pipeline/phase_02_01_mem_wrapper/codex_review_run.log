    47	    input             instr_retired,
    48	
    49	    // Trap entry (from core, single-cycle pulse in WB)
    50	    input             trap_enter,
    51	    input  [31:0]     trap_pc,       // pc to save in mepc (next_pc that would have executed)
    52	    input  [31:0]     trap_cause,
    53	    input  [31:0]     trap_mtval,
    54	
    55	    // Trap exit (mret)
    56	    input             trap_exit,
    57	
    58	    // External IRQ source (single-cycle pulse from debouncer)
    59	    input             irq_external_pulse,
    60	
    61	    // To IFU / core
    62	    output [31:0]     mtvec_o,
    63	    output [31:0]     mepc_o,
    64	    output            irq_pending
    65	);
    66	
    67	    // -------------------------------------------------------------------------
    68	    // 1. CSR register storage
    69	    // -------------------------------------------------------------------------
    70	    reg        mie_meie;        // mie[11]
    71	    reg        mstatus_mie;     // mstatus[3]
    72	    reg        mstatus_mpie;    // mstatus[7]
    73	    reg [31:2] mtvec_base;      // mtvec[31:2] (MODE 永遠 0)
    74	    reg [31:0] mscratch;
    75	    reg [31:0] mepc_reg;
    76	    reg [31:0] mcause_reg;
    77	    reg [31:0] mtval_reg;
    78	    reg        ext_pending;     // mip[11], hardware managed
    79	
    80	    // Counters
    81	    reg [63:0] cycle_cnt;
    82	    reg [63:0] instret_cnt;
    83	
    84	    // -------------------------------------------------------------------------
    85	    // 2. Read mux (組合)
    86	    //   未列出的位址回 0 (mhartid / misa / mvendorid 等)
    87	    // -------------------------------------------------------------------------
    88	    // mstatus layout: [31:8]=0, [7]=MPIE, [6:4]=0, [3]=MIE, [2:0]=0
    89	    wire [31:0] mstatus_val = {24'b0, mstatus_mpie, 3'b0, mstatus_mie, 3'b0};
    90	    wire [31:0] mie_val     = {20'b0, mie_meie, 11'b0};
    91	    wire [31:0] mip_val     = {20'b0, ext_pending, 11'b0};
    92	    wire [31:0] mtvec_val   = {mtvec_base, 2'b00};
    93	    wire [31:0] mtval_val   = mtval_reg;
    94	
    95	    always @* begin
    96	        case (csr_raddr)
    97	            `CSR_MSTATUS : csr_rdata = mstatus_val;
    98	            `CSR_MIE     : csr_rdata = mie_val;
    99	            `CSR_MTVEC   : csr_rdata = mtvec_val;
   100	            `CSR_MSCRATCH: csr_rdata = mscratch;
   101	            `CSR_MEPC    : csr_rdata = mepc_reg;
   102	            `CSR_MCAUSE  : csr_rdata = mcause_reg;
   103	            `CSR_MTVAL   : csr_rdata = mtval_val;
   104	            `CSR_MIP     : csr_rdata = mip_val;
   105	            `CSR_CYCLE   : csr_rdata = cycle_cnt[31:0];
   106	            `CSR_CYCLEH  : csr_rdata = cycle_cnt[63:32];
   107	            `CSR_INSTRET : csr_rdata = instret_cnt[31:0];
   108	            `CSR_INSTRETH: csr_rdata = instret_cnt[63:32];
   109	            default      : csr_rdata = 32'h0;
   110	        endcase
   111	    end
   112	
   113	    // -------------------------------------------------------------------------
   114	    // 3. Compute "next value" for whichever CSR is being written this cycle
   115	    //    (CSRRW/RS/RC 對任何 CSR 行為一致，只是 set/clear/swap 差異)
   116	    // -------------------------------------------------------------------------
   117	    reg [31:0] new_val;
   118	    always @* begin
   119	        case (csr_op)
   120	            `CSR_OP_W : new_val = csr_wdata;
   121	            `CSR_OP_S : new_val = csr_old_val | csr_wdata;
   122	            `CSR_OP_C : new_val = csr_old_val & ~csr_wdata;
   123	            default   : new_val = csr_old_val;
   124	        endcase
   125	    end
   126	
   127	    // -------------------------------------------------------------------------
   128	    // 4. Sync write logic (CSR* 指令、trap 進入/退出、counter increment)
   129	    // -------------------------------------------------------------------------
   130	    always @(posedge clk) begin
   131	        if (!resetn) begin
   132	            mie_meie     <= 1'b0;
   133	            mstatus_mie  <= 1'b0;          // 重置時 IRQ 關閉，要靠軟體開
   134	            mstatus_mpie <= 1'b0;
   135	            mtvec_base   <= 30'b0;
   136	            mscratch     <= 32'b0;
   137	            mepc_reg     <= 32'b0;
   138	            mcause_reg   <= 32'b0;
   139	            mtval_reg    <= 32'b0;
   140	            ext_pending  <= 1'b0;
   141	            cycle_cnt    <= 64'b0;
   142	            instret_cnt  <= 64'b0;
   143	        end else begin
   144	            // 4.1 cycle 永遠 +1 (CSR write 不影響)
   145	            cycle_cnt <= cycle_cnt + 1'b1;
   146	
   147	            // 4.2 instret 在每條完成 +1
   148	            if (instr_retired)
   149	                instret_cnt <= instret_cnt + 1'b1;
   150	
   151	            // 4.3 軟體 CSR 寫入 (CSR* 指令)
   152	            //     只 patch 對應位址的 register；RO 位址寫入忽略
   153	            if (csr_we) begin
   154	                case (csr_waddr)
   155	                    `CSR_MSTATUS : begin
   156	                        mstatus_mie  <= new_val[`MSTATUS_MIE_BIT];
   157	                        mstatus_mpie <= new_val[`MSTATUS_MPIE_BIT];
   158	                    end
   159	                    `CSR_MIE     : mie_meie    <= new_val[`MIE_MEIE_BIT];
   160	                    `CSR_MTVEC   : mtvec_base  <= new_val[31:2];
   161	                    `CSR_MSCRATCH: mscratch    <= new_val;
   162	                    `CSR_MEPC    : mepc_reg    <= new_val;
   163	                    `CSR_MCAUSE  : mcause_reg  <= new_val;
   164	                    `CSR_MTVAL   : mtval_reg   <= new_val;
   165	                    // 其他 (MIP / counters / unknown) 忽略
   166	                    default      : ;
   167	                endcase
   168	            end
   169	
   170	            // 4.4 硬體 trap entry / exit
   171	            //     core.v 保證 trap_enter / trap_exit / csr_we 三者互斥；
   172	            //     不過 trap_enter 在源碼順序上放在 csr_we 後面，
   173	            //     就算同 cycle 都 fire 也是 trap_enter 路徑的 NBA 寫贏。
   174	            if (trap_enter) begin
   175	                mepc_reg     <= trap_pc;
   176	                mcause_reg   <= trap_cause;
   177	                mtval_reg    <= trap_mtval;
   178	                mstatus_mpie <= mstatus_mie;
   179	                mstatus_mie  <= 1'b0;
   180	            end else if (trap_exit) begin
   181	                mstatus_mie  <= mstatus_mpie;
   182	                mstatus_mpie <= 1'b1;            // spec: MPIE <- 1 after mret
   183	            end
   184	
   185	            // 4.5 ext_pending 三優先級邏輯 (trap_enter > pulse > hold)
   186	            //     - trap_enter → clear (hardware ack)
   187	            //     - 新 pulse 進來且沒有同拍 trap_enter → set
   188	            //     - 其他保持
   189	            //     寫成一條 mux 而不是兩個 if，邏輯 + timing 都比較乾淨
   190	            ext_pending <=
   191	                trap_enter         ? 1'b0 :
   192	                irq_external_pulse ? 1'b1 :
   193	                                     ext_pending;
   194	        end
   195	    end
   196	
   197	    // -------------------------------------------------------------------------
   198	    // 5. 輸出
   199	    // -------------------------------------------------------------------------
   200	    assign mtvec_o     = mtvec_val;
   201	    assign mepc_o      = mepc_reg;
   202	    assign irq_pending = ext_pending & mie_meie & mstatus_mie;
   203	
   204	endmodule

