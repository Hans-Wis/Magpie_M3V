    57	    reg [1:0]           counter0 [0:N_SETS-1];
    58	
    59	    reg                 valid1   [0:N_SETS-1];
    60	    reg [TAG_BITS-1:0]  tag1     [0:N_SETS-1];
    61	    reg [31:0]          target1  [0:N_SETS-1];
    62	    reg [1:0]           counter1 [0:N_SETS-1];
