   967	
   968	    // =========================================================================
   969	    // Trap output (illegal 進 TRAP 簡化版：直接卡死，不像 lab05 那麼正式)
   970	    // 為了維持 ebreak 行為，遇到 illegal 時 PC 永遠 redirect 到 PC（自鎖）
   971	    // =========================================================================
   972	    reg trap_latched;
   973	    always @(posedge clk) begin
   974	        if (!resetn) trap_latched <= 1'b0;
   975	        else if (ex_wb_valid_r && ex_wb_illegal_r && !mem_stall) trap_latched <= 1'b1;
   976	    end
   977	    assign trap = trap_latched;
   978	
   979	    // =========================================================================
   980	    // Debug
   981	    // =========================================================================
   982	    assign dbg_pc    = if_ex_pc;
   983	    assign dbg_instr = if_ex_instr;
   984	    assign dbg_state = {stall, wb_take_irq, ex_wb_valid_r};
   985	
   986	endmodule

