     1	// =============================================================================
     2	// ras.v — Lab08c Return Address Stack (8-entry circular)
     3	// -----------------------------------------------------------------------------
     4	// 設計：
     5	//   - 8-entry stack (3-bit pointer)，environments register array
     6	//   - Push value: 由 IF/EX 階段算 (= if_ex_pc + 4)，當 instruction 被偵測為 JAL ra
     7	//     (id_is_jal && id_rd_idx == x1) 時 push
     8	//   - Pop:  由 IF 階段 pre-decode i_mem_rdata 偵測 RET (jalr x0, ra, 0) 時 pop
     9	//   - Predict 輸出：ras_predict_taken = 1 + ras_predict_target = top
    10	//     (caller 用 if_is_ret 來決定要不要用此 predict — 模組本身只負責「目前 top 是什麼」)
    11	//
    12	// 行為：
    13	//   - Reset：pointer = 0 (empty)
    14	//   - Push：stack[ptr] ← push_val；ptr ← ptr+1 (saturate at 8 → 從頭覆寫 ring buffer)
    15	//   - Pop：top = stack[ptr-1]；ptr ← ptr-1 (saturate at 0)
    16	//   - 同 cycle push + pop：可以 (push to ptr, pop from ptr-1，dependent on order)
    17	//     此處用 sequential semantics：先 pop 再 push (= 取代 stack top)
    18	//     但 firmware 不會這樣 (JAL ra 跟 RET 不會 IF 同 cycle 出現)，所以邊界 case
    19	//     不重要，priority 就是行為定義即可。
    20	//
    21	// firmware impact 警告：
    22	//   目前 lab08c 的 firmware (LED counter) 只有一個 `jal ra, main` 在 startup，
    23	//   main 永不返回 (while(1))。所以 RAS push 一次後永遠 dormant，pop 永不發生。
    24	//   RAS 是「為未來 firmware 準備」的設計，當前 firmware 不會觸發 → IPC 無變化。
    25	// =============================================================================
    26	
    27	`include "def.vh"
    28	
    29	module ras (
    30	    input             clk,
    31	    input             resetn,
    32	
    33	    // ---- Predict read (combinational) ----
    34	    output     [31:0] ras_top,         // 目前 stack top (給 caller 在 IF 用)
    35	
    36	    // ---- Push/Pop control (synchronous) ----
    37	    input             push,            // 1 = end of this cycle push
    38	    input      [31:0] push_val,
    39	    input             pop              // 1 = end of this cycle pop
    40	);
    41	
    42	    localparam DEPTH = 8;
    43	    localparam PTR_BITS = 3;
    44	
    45	    reg [31:0]         stack [0:DEPTH-1];
    46	    reg [PTR_BITS-1:0] ptr;            // points to *next empty slot* (=stack size)
    47	
    48	    // ras_top = stack[ptr-1]，empty 時 (ptr=0) 輸出 0
    49	    wire [PTR_BITS-1:0] top_idx = ptr - 3'd1;
    50	    assign ras_top = (ptr == 0) ? 32'h0 : stack[top_idx];
    51	
    52	    integer i;
    53	    always @(posedge clk) begin
    54	        if (!resetn) begin
    55	            ptr <= 3'd0;
    56	            for (i = 0; i < DEPTH; i = i + 1) stack[i] <= 32'h0;
    57	        end else begin
    58	            // Same-cycle push+pop = net push (取代 top)
    59	            // 只 push: ptr++ (wrap)，stack[ptr] <= val
    60	            // 只 pop:  ptr--
    61	            // Both 同時：先 pop 再 push → stack[ptr-1] <= val，ptr 不變
    62	            //          (即「replace top」semantics)
    63	            if (push && pop) begin
    64	                if (ptr != 0)
    65	                    stack[top_idx] <= push_val;
    66	                else
    67	                    stack[0]       <= push_val;       // empty 時就視為 push 到 slot 0
    68	                // ptr 不變
    69	            end else if (push) begin
    70	                stack[ptr] <= push_val;
    71	                ptr <= ptr + 3'd1;                    // 3-bit 加法自動 wrap (覆寫底)
    72	            end else if (pop) begin
    73	                if (ptr != 0) ptr <= ptr - 3'd1;
    74	                // empty 時 pop 是 no-op (預測結果是 garbage but 會 mispredict 被 recover)
    75	            end
    76	        end
    77	    end
    78	
    79	endmodule

