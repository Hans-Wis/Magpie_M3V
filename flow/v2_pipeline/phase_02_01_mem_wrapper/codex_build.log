     1	// =============================================================================
     2	// cpu_m1_top
     3	//
     4	// Magpie_M1 CPU IP wrapper (Phase 2.1 mem-wrapper).
     5	// Presents Harvard valid/ready I/D busses with single-outstanding request hold.
     6	//
     7	// Contract:
     8	//  - ibus_req/dbus_req stay high until ready=1.
     9	//  - no new I/D request is issued while either I or D request is outstanding.
    10	//  - commit/debug visibility is passed through from the core.
    11	//
    12	// mem_stall = any outstanding request waiting for ready (not a generic ready
    13	// delay signal). The fixed-latency core is frozen through `mem_stall`.
    14	// =============================================================================
    15	
    16	module cpu_m1_top(
    17	    input             clk,
    18	    input             resetn,
    19	
    20	    // Core trap output
    21	    output            trap,
    22	
    23	    // I-side valid/ready interface (1 outstanding, Harvard)
    24	    output            ibus_req,
    25	    output [31:0]     ibus_addr,
    26	    input             ibus_ready,
    27	    input  [31:0]     ibus_rdata,
    28	
    29	    // D-side valid/ready interface (1 outstanding, Harvard)
    30	    output            dbus_req,
    31	    output [31:0]     dbus_addr,
    32	    output            dbus_we,
    33	    output [3:0]      dbus_wstrb,
    34	    output [31:0]     dbus_wdata,
    35	    input             dbus_ready,
    36	    input  [31:0]     dbus_rdata,
    37	
    38	    // External IRQ
    39	    input             irq_external_pulse,
    40	
    41	    // Debug pass-through
    42	    output [31:0]     dbg_pc,
    43	    output [31:0]     dbg_instr,
    44	    output [ 2:0]     dbg_state
    45	);
    46	
    47	    // ---------------------------------------------------------------------
    48	    // Core interface
    49	    // ---------------------------------------------------------------------
    50	    wire        core_i_mem_en;
    51	    wire [31:0] core_i_mem_addr;
    52	    wire        core_d_mem_valid;
    53	    wire [31:0] core_d_mem_addr;
    54	    wire [31:0] core_d_mem_wdata;
    55	    wire [ 3:0] core_d_mem_wstrb;
    56	
    57	    // Hold-one-bus-transaction state for each port
    58	    reg  i_hold;
    59	    reg  [31:0] i_hold_addr;
    60	
    61	    reg  d_hold;
    62	    reg  [31:0] d_hold_addr;
    63	    reg  [31:0] d_hold_wdata;
    64	    reg  [ 3:0] d_hold_wstrb;
    65	
    66	    // Stall when either core-facing request is outstanding and not yet ready.
    67	    wire mem_stall;
    68	    assign mem_stall = (i_hold && !ibus_ready) || (d_hold && !dbus_ready);
    69	
    70	    // ---------------------------------------------------------------------
    71	    // I-port hold semantics
    72	    //  - launch with new core request when no hold
    73	    //  - keep req/data stable while ready stays low
    74	    // ---------------------------------------------------------------------
    75	    assign ibus_req  = i_hold || core_i_mem_en;
    76	    assign ibus_addr = i_hold ? i_hold_addr : core_i_mem_addr;
    77	
    78	    always @(posedge clk) begin
    79	        if (!resetn) begin
    80	            i_hold     <= 1'b0;
    81	            i_hold_addr <= 32'h0;
    82	        end else begin
    83	            if (i_hold) begin
    84	                if (ibus_ready)
    85	                    i_hold <= 1'b0;
    86	            end else if (core_i_mem_en) begin
    87	                i_hold_addr <= core_i_mem_addr;
    88	                if (!ibus_ready)
    89	                    i_hold <= 1'b1;
    90	            end
    91	        end
    92	    end
    93	
    94	    // ---------------------------------------------------------------------
    95	    // D-port hold semantics
    96	    // ---------------------------------------------------------------------
    97	    assign dbus_req   = d_hold || core_d_mem_valid;
    98	    assign dbus_addr  = d_hold ? d_hold_addr : core_d_mem_addr;
    99	    assign dbus_wdata = d_hold ? d_hold_wdata : core_d_mem_wdata;
   100	    assign dbus_wstrb = d_hold ? d_hold_wstrb : core_d_mem_wstrb;
   101	    assign dbus_we    = |dbus_wstrb;
   102	
   103	    always @(posedge clk) begin
   104	        if (!resetn) begin
   105	            d_hold      <= 1'b0;
   106	            d_hold_addr <= 32'h0;
