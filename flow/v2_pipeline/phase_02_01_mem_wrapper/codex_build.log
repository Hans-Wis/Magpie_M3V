csr.v:98:            `CSR_MIE     : csr_rdata = mie_val;
csr.v:99:            `CSR_MTVEC   : csr_rdata = mtvec_val;
csr.v:104:            `CSR_MIP     : csr_rdata = mip_val;
csr.v:132:            mie_meie     <= 1'b0;
csr.v:133:            mstatus_mie  <= 1'b0;          // 重置時 IRQ 關閉，要靠軟體開
csr.v:134:            mstatus_mpie <= 1'b0;
csr.v:135:            mtvec_base   <= 30'b0;
csr.v:156:                        mstatus_mie  <= new_val[`MSTATUS_MIE_BIT];
csr.v:157:                        mstatus_mpie <= new_val[`MSTATUS_MPIE_BIT];
csr.v:159:                    `CSR_MIE     : mie_meie    <= new_val[`MIE_MEIE_BIT];
csr.v:160:                    `CSR_MTVEC   : mtvec_base  <= new_val[31:2];
csr.v:178:                mstatus_mpie <= mstatus_mie;
csr.v:179:                mstatus_mie  <= 1'b0;
csr.v:181:                mstatus_mie  <= mstatus_mpie;
csr.v:182:                mstatus_mpie <= 1'b1;            // spec: MPIE <- 1 after mret
csr.v:192:                irq_external_pulse ? 1'b1 :
csr.v:200:    assign mtvec_o     = mtvec_val;
csr.v:202:    assign irq_pending = ext_pending & mie_meie & mstatus_mie;

