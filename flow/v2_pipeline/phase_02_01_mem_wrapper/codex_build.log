/bin/bash -lc "cat > flow/v2_pipeline/phase_02_01_mem_wrapper/firmware_misalign.S <<'EOF'
.section .init
.global _start
_start:
    li    x1, 0x00000100
    la    x2, trap_handler
    csrw  mtvec, x2

    li    x3, 0xa5a5a5a5

    # ---- four misaligned accesses, each must trap ----
    lw    x4, 1(x1)
    sw    x3, 1(x1)
    lh    x5, 1(x1)
    sh    x3, 3(x1)

    ebreak

.section .text
.align 4
trap_handler:
    csrr x6, mcause
    csrr x7, mtval

    # event counter at fixed mmio data slot
    li    x8, 0x10000000
    li    x9, 0x0
    lw    x10, 0(x8)
    blt   x10, 4, 1f
    mret
1:
    slli  x11, x10, 3      # offset = event * 8
    add   x11, x11, x8

    sw    x6, 0(x11)       # cause
    sw    x7, 4(x11)       # mtval

    addi  x10, x10, 1
    sw    x10, 0(x8)

    mret
EOF" in /home/edauser/project/SOC/Magpie_M1
