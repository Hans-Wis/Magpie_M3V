    assign wb_data = wb_data_mux;

    // IRQ entry / MRET decision (在 WB commit boundary) — wb_take_irq forward-declared 上面
    assign wb_take_irq = ex_wb_valid_r && irq_pending && !ex_wb_illegal_r;

