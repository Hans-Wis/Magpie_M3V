                     // 其他 (MIP / counters / unknown) 忽略
                     default      : ;
                 endcase
@@ -166,7 +173,8 @@
             //     就算同 cycle 都 fire 也是 trap_enter 路徑的 NBA 寫贏。
             if (trap_enter) begin
                 mepc_reg     <= trap_pc;
-                mcause_reg   <= `MCAUSE_EXT_IRQ;
