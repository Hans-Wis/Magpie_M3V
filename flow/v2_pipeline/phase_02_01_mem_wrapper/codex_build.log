Makefile
codex_build.log
dispatch_prompt.txt
files.f
firmware.S
firmware.disasm
firmware.elf
firmware.hex
firmware.lds
firmware_misalign.S
firmware_misalign.elf
firmware_misalign.hex
firmware_spike.elf
firmware_spike.lds
mem_wrapper_lockstep.py
obj_dir
tb_mem_wrapper.v

