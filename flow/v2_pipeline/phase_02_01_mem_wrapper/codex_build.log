csr.v:18://   irq_pending           ← 給 core 在 WB 判斷是否要 trap entry
csr.v:24://   * mtvec direct mode only (MODE bits 寫入被遮蔽成 0)
csr.v:25://   * mip[11] 是「外部中斷已發生但尚未進 ISR」的硬體 sticky bit；
csr.v:59:    input             irq_external_pulse,
csr.v:62:    output [31:0]     mtvec_o,
csr.v:64:    output            irq_pending
csr.v:70:    reg        mie_meie;        // mie[11]
csr.v:71:    reg        mstatus_mie;     // mstatus[3]
csr.v:72:    reg        mstatus_mpie;    // mstatus[7]
csr.v:73:    reg [31:2] mtvec_base;      // mtvec[31:2] (MODE 永遠 0)
csr.v:78:    reg        ext_pending;     // mip[11], hardware managed
csr.v:88:    // mstatus layout: [31:8]=0, [7]=MPIE, [6:4]=0, [3]=MIE, [2:0]=0
csr.v:89:    wire [31:0] mstatus_val = {24'b0, mstatus_mpie, 3'b0, mstatus_mie, 3'b0};
csr.v:90:    wire [31:0] mie_val     = {20'b0, mie_meie, 11'b0};
csr.v:91:    wire [31:0] mip_val     = {20'b0, ext_pending, 11'b0};
csr.v:92:    wire [31:0] mtvec_val   = {mtvec_base, 2'b00};
