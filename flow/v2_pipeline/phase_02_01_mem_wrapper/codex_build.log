 succeeded in 0ms:
     1	// =============================================================================
     2	// core.v — Lab08e 4-stage pipeline RV32IMC + CSR + IRQ + BP (2-way) + RAS
     3	//          (lab08d base + pre-fetch buffer eliminates cross-boundary stall)
     4	// -----------------------------------------------------------------------------
     5	// lab08d 加 cross_assemble/residue pre-fetch buffer：
     6	//   - Sequential 16-bit → 32-bit cross-boundary：0-cycle penalty (pre-fetch path)
     7	//   - Post-stall/redirect cross-boundary：1-cycle fallback (= lab08d 同)
     8	//   - any_stall 不再含 is_cross_boundary，只含 load-use/muldiv stall + warmup
     9	//
    10	// 預期：
    11	//   - clock: 75 MHz target (IF stage secondary path 消除，worst path 仍 d_mem store)
    12	//   - IPC: 36+ LED (cross-boundary stall 消除，lab08d firmware hot loop中)
    13	//   - Wall-clock: 75/65 × lab08d ≈ 1.55× lab07
    14	// =============================================================================
    15	
    16	`include "def.vh"
    17	
    18	module core (
    19	    input             clk,
    20	    input             resetn,
    21	    output            trap,
    22	    input             mem_stall,
    23	
    24	    // I-port (instr fetch, sync read-only)
    25	    output     [31:0] i_mem_addr,
    26	    output            i_mem_en,        // gates BRAM update; =!stall (lab06 新加)
    27	    input      [31:0] i_mem_rdata,
    28	
    29	    // D-port (data load/store)
    30	    output            d_mem_valid,
    31	    output     [31:0] d_mem_addr,
    32	    output     [31:0] d_mem_wdata,
    33	    output     [ 3:0] d_mem_wstrb,
    34	    input      [31:0] d_mem_rdata,
    35	
    36	    // External IRQ
    37	    input             irq_external_pulse,
    38	
    39	    // Debug
    40	    output     [31:0] dbg_pc,
    41	    output     [31:0] dbg_instr,
    42	    output     [ 2:0] dbg_state
    43	);
    44	
    45	    // =========================================================================
    46	    // Reset / warmup
    47	    // =========================================================================
    48	    reg warmup;
    49	    always @(posedge clk) begin
    50	        if (!resetn) warmup <= 1'b1;
    51	        else         warmup <= 1'b0;   // 1 cycle bubble after reset (BRAM warm)
    52	    end
    53	
    54	    // =========================================================================
    55	    // IF stage : ifu + BP + RAS + cdec + cross-boundary fetch (RV32C)
    56	    // -------------------------------------------------------------------------
    57	    // Lab08e 改進自 lab08d：消除 cross-boundary 1-cycle stall。
    58	    //
    59	    // 舊設計 (lab08d)：在 cross-boundary detect cycle 插入 stall，下拍 assemble。
    60	    // 新設計 (lab08e)：在上一拍偵測到「下一條 instr 是 cross-boundary 32-bit」時
    61	    //   1. 提前 override i_mem_addr = if_pc+4 (= 下一個 word)
    62	    //   2. 保存 residue ← cur_half_hi (= 32-bit instr 的前 16 bits)
    63	    //   3. 設定 cross_assemble
    64	    //   下一拍直接用 {i_mem_rdata[15:0], residue} assemble，0 cycle penalty。
    65	    //
    66	    // 只有在 upcoming_cross 前一拍有 stall/redirect 時才退回 at_cross_boundary 路徑
    67	    // (= lab08d fallback，仍 1-cycle stall)。熱迴圈無 stall 前置 → 0-cycle。
    68	    // =========================================================================
    69	    wire [31:0] if_pc;        // = pc_reg (current decode PC)
    70	    wire [31:0] next_pc_w;    // combinational from ifu
    71	    reg         pc_redirect;
    72	    reg  [31:0] redirect_target;
    73	    wire        stall;         // load-use / muldiv stall (existing)
    74	    wire        flush_if_next; // bubble next-cycle IF/EX
    75	
    76	    // Lab08c: BP (64-entry 2-way) + RAS (8-entry)
    77	    wire        bp_predict_taken;
    78	    wire [31:0] bp_predict_target;
    79	    wire        bp_upd_valid;
    80	    wire [31:0] bp_upd_pc;
    81	    wire        bp_upd_taken;
    82	    wire [31:0] bp_upd_target;
    83	
    84	    wire [31:0] ras_top;
    85	    wire        ras_push;
    86	    wire [31:0] ras_push_val;
    87	    wire        ras_pop;
    88	
    89	    // Lab08e: residue-based pre-fetch (replaces wait_high + high_buf)
    90	    reg [15:0]  residue;        // saved high-half for upcoming cross-boundary assemble
    91	    reg         cross_assemble; // 1 = this cycle: assemble {i_mem_rdata[15:0], residue}
    92	
    93	    // ---- Pre-decode i_mem_rdata for instruction length ----
    94	    wire [15:0] cur_half_lo = i_mem_rdata[15:0];
    95	    wire [15:0] cur_half_hi = i_mem_rdata[31:16];
    96	    wire        is_comp_lo  = (cur_half_lo[1:0] != 2'b11);
    97	    wire        is_comp_hi  = (cur_half_hi[1:0] != 2'b11);
    98	
    99	    wire        cur_at_high = if_pc[1];   // current instr at high half of fetched word
   100	
   101	    // at_cross_boundary: fallback — arrived at cross-boundary without pre-setup
   102	    // (happens after stall / redirect blocked upcoming_cross the previous cycle)
   103	    wire        at_cross_boundary = cur_at_high && !is_comp_hi && !cross_assemble;
   104	
   105	    // upcoming_cross: sequential 16-bit at low half, FOLLOWED BY 32-bit at high half
   106	    // Only fires when current instr is 16-bit at low half AND high half is 32-bit start,
   107	    // with no prediction override or stall this cycle. Guarantees residue = correct high-half.
   108	    wire        upcoming_cross = !cur_at_high && is_comp_lo && !is_comp_hi &&
   109	                                  !cross_assemble && !stall && !warmup && !pc_redirect &&
   110	                                  !bp_predict_taken && !ras_predict_ret;
   111	
   112	    // is_16bit signal (drives ifu pc_inc)
   113	    wire        is_16bit_w = cross_assemble  ? 1'b0 :       // assembled cross = 32-bit
   114	                              cur_at_high    ? is_comp_hi :
   115	                                               is_comp_lo;
   116	
   117	    // fetch_stall: only fallback cross-boundary detection (not upcoming_cross path)
   118	    wire        fetch_stall = at_cross_boundary;
   119	    wire        any_stall   = stall | fetch_stall | warmup | mem_stall;
   120	
   121	    // ---- Compressed expander ----
   122	    wire [15:0] cinstr   = cur_at_high ? cur_half_hi : cur_half_lo;
   123	    wire [31:0] cdec_expanded;
   124	    wire        cdec_illegal;
   125	    cdec u_cdec (
   126	        .cinstr   (cinstr),
   127	        .expanded (cdec_expanded),
   128	        .illegal  (cdec_illegal)
   129	    );
   130	
   131	    // ---- Assembled 32-bit instruction (output to if_ex) ----
   132	    // cross_assemble: {new_word[15:0], residue} — both from registers (short path)
   133	    // compressed: cdec output
   134	    // aligned 32-bit (PC[1]=0): i_mem_rdata directly
   135	    // (at_cross_boundary case produces garbage but any_stall=1 prevents latching)
   136	    wire [31:0] instr_assembled =
   137	        cross_assemble  ? {cur_half_lo, residue} :
   138	        is_16bit_w      ? cdec_expanded :
   139	                          i_mem_rdata;
   140	
   141	    // ---- RET detection (for RAS pop) ----
   142	    // lab08e v3: check only opcode+rd+funct3+rs1, not imm bits [31:20].
   143	    // Full equality (== 32'h00008067) pulled cdec_expanded[23] (imm[11]) into the
   144	    // ras_predict_ret→next_pc→i_mem_addr path via CDec case-select (cinstr[14], fo=44,
   145	    // 6 LUT levels) → fo=26 routing bottleneck.  Imm is irrelevant for RAS prediction.
   146	    wire if_is_ret_32  = (instr_assembled[6:0]  == 7'b1100111) &&  // JALR opcode
   147	                         (instr_assembled[11:7]  == 5'b00000)   &&  // rd = x0
   148	                         (instr_assembled[14:12] == 3'b000)     &&  // funct3 = 0
   149	                         (instr_assembled[19:15] == 5'b00001);      // rs1 = ra (x1)
   150	    wire if_is_ret_16  = is_16bit_w && (cinstr == 16'h8082);
   151	    wire if_is_ret     = if_is_ret_32 || if_is_ret_16;
   152	
   153	    wire        ras_valid      = (ras_top != 32'h0);
   154	    wire        ras_predict_ret = if_is_ret && ras_valid && !any_stall && !pc_redirect;
   155	
   156	    assign ras_pop = ras_predict_ret;
   157	
   158	    // ---- BP / RAS / ifu instantiation ----
   159	    bp u_bp (
   160	        .clk               (clk),
   161	        .resetn            (resetn),
   162	        .if_pc             (if_pc),
   163	        .bp_predict_taken  (bp_predict_taken),
   164	        .bp_predict_target (bp_predict_target),
   165	        .upd_valid         (bp_upd_valid),
   166	        .upd_pc            (bp_upd_pc),
   167	        .upd_taken         (bp_upd_taken),
   168	        .upd_target        (bp_upd_target)
   169	    );
   170	
   171	    ras u_ras (
   172	        .clk      (clk),
   173	        .resetn   (resetn),
   174	        .ras_top  (ras_top),
   175	        .push     (ras_push),
   176	        .push_val (ras_push_val),
   177	        .pop      (ras_pop)
   178	    );
   179	
   180	    ifu u_ifu (
   181	        .clk                (clk),
   182	        .resetn             (resetn),
   183	        .pc_stall           (any_stall),
   184	        .pc_redirect        (pc_redirect),
   185	        .redirect_target    (redirect_target),
   186	        .ras_predict_ret    (ras_predict_ret),
   187	        .ras_predict_target (ras_top),
   188	        .bp_predict_taken   (bp_predict_taken),
   189	        .bp_predict_target  (bp_predict_target),
   190	        .is_16bit           (is_16bit_w),
   191	        .pc                 (if_pc),
   192	        .next_pc            (next_pc_w)
   193	    );
   194	
   195	    // i_mem_addr drive:
   196	    //   at_cross_boundary: fetch next word (fallback, same as lab08d)
   197	    //   upcoming_cross:    pre-fetch next word one cycle early (if_pc[1]=0 → +4 = next word)
   198	    //   else:              look-ahead via next_pc_w (normal)
   199	    assign i_mem_addr = at_cross_boundary ? (if_pc + 32'd2) :
   200	                        upcoming_cross    ? (if_pc + 32'd4) :
   201	                                            next_pc_w;
   202	    // Keep BRAM active during at_cross_boundary even if lu/md stall fires simultaneously.
   203	    // (same fix as lab08d §problems_log 1, but now only needed for fallback path)
   204	    assign i_mem_en   = !any_stall || at_cross_boundary;
   205	
   206	    // ---- Cross-boundary state machine ----
   207	    always @(posedge clk) begin
   208	        if (!resetn || pc_redirect) begin
   209	            cross_assemble <= 1'b0;
   210	            residue        <= 16'h0;
   211	        end else if (upcoming_cross) begin
   212	            // Pre-fetch path: no stall, save high-half for next cycle assembly
   213	            cross_assemble <= 1'b1;
   214	            residue        <= cur_half_hi;
   215	        end else if (at_cross_boundary && !warmup) begin
   216	            // Fallback path: stall this cycle, set up for stall-free assembly next cycle
   217	            cross_assemble <= 1'b1;
   218	            residue        <= cur_half_hi;
   219	        end else if (!any_stall) begin
   220	            // Only clear when pipeline can advance; hold through stalls so BRAM data stays valid
   221	            cross_assemble <= 1'b0;
   222	        end
   223	    end
   224	
   225	    // =========================================================================
   226	    // IF/EX pipeline register
   227	    // =========================================================================
   228	    reg [31:0] if_ex_instr;
   229	    reg [31:0] if_ex_pc;
   230	    reg        if_ex_valid;
   231	    reg        if_ex_pred_taken;
   232	    reg        if_ex_pred_ras;
   233	    reg [31:0] if_ex_pred_ras_target;
   234	    reg        if_ex_is_16bit;  // instruction size flag for correct mepc / link-addr
   235	
   236	    always @(posedge clk) begin
   237	        if (!resetn) begin
   238	            if_ex_instr      <= 32'h0;
   239	            if_ex_pc         <= 32'h0;
   240	            if_ex_valid      <= 1'b0;

