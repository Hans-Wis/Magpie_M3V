    localparam int WAIT_MODE_1      = 1;
    localparam int WAIT_MODE_3      = 3;
    localparam int WAIT_MODE_RANDOM = 4;
    localparam int MAX_WAIT_CYCLES  = 22000;

    wire        ibus_req;
    wire [31:0] ibus_addr;
    wire        ibus_ready;
    reg  [31:0] ibus_rdata;

