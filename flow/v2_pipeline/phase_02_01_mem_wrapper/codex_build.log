            `WB_SEL_CSR  : ex_mem_fwd_val = ex_mem_csr_rdata_r;
            `WB_SEL_MD   : ex_mem_fwd_val = ex_mem_md_result_r;
            default      : ex_mem_fwd_val = ex_mem_alu_result_r;
