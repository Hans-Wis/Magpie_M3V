    );

    wire [ADDR_BITS-1:0] ref_i_word_idx = ref_i_mem_addr[ADDR_BITS+1:2];
    wire [ADDR_BITS-1:0] ref_d_word_idx = ref_d_mem_addr[ADDR_BITS+1:2];
    wire [ADDR_BITS-1:0] top_i_word_idx = ibus_addr[ADDR_BITS+1:2];
    wire [ADDR_BITS-1:0] top_d_word_idx = dbus_addr[ADDR_BITS+1:2];

