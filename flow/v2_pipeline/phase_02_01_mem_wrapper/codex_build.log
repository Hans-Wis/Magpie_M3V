    );

    // ------------------------------------------------------------------
    // Shared-memory wrappers for DUT + reference
    // ------------------------------------------------------------------
    wire [11:0] ref_i_word_idx = ref_i_mem_addr[13:2];
    wire [11:0] ref_d_word_idx = ref_d_mem_addr[13:2];
    wire [11:0] top_i_word_idx = ibus_addr[13:2];
    wire [11:0] top_d_word_idx = dbus_addr[13:2];

    wire ref_d_is_mmio = ref_d_word_idx[31];

    always @(posedge clk) begin
        if (run_ref) begin
            if (ref_i_mem_en)
                ref_i_mem_rdata <= mem_ref[ref_i_word_idx];

            if (ref_d_mem_valid) begin
                ref_d_mem_rdata <= mem_ref[ref_d_word_idx];
                if (|ref_d_mem_wstrb)
                    mem_ref[ref_d_word_idx] <= (ref_d_mem_wdata & {4{ref_d_mem_wstrb[0]}}) |
                                               (mem_ref[ref_d_word_idx] & ~{4{ref_d_mem_wstrb[0]}});
            end
        end
    end

    integer mmio_idx;
    always @(posedge clk) begin
        if (run_top) begin
            if (ibus_req && ibus_ready)
                top_i_mem_rdata <= mem_top[top_i_word_idx];

            if (dbus_req && dbus_ready) begin
                if (dbus_addr[31:28] == 4'h1) begin
                    mmio_idx = (dbus_addr - 32'h1000_0000) >> 2;
                    if (dbus_we && mmio_idx < 8) begin
                        if ((mmio_idx[0] == 1'b0))
                            misaligned_cause[mmio_idx[2:1]] <= dbus_wdata;
                        else
                            misaligned_mtval[mmio_idx[2:1]] <= dbus_wdata;
                    end
                end else begin
                    top_d_mem_rdata <= mem_top[top_d_word_idx];
                    if (|dbus_wstrb) begin
                        mem_top[top_d_word_idx] <=
                            (dbus_wdata & {4{dbus_wstrb[0]}}) |
                            (mem_top[top_d_word_idx] & ~{4{dbus_wstrb[0]}});
                    end
                end
            end

            if (run_top && dbus_req && !dbus_addr[28] && (dbus_addr[11:2] < MEM_SIZE)) begin
                if (dbus_we)
                    mem_top[top_d_word_idx] <=
                        (dbus_wdata & {4{dbus_wstrb[0]}}) |
                        (mem_top[top_d_word_idx] & ~{4{dbus_wstrb[0]}});
            end
        end
    end

    // ------------------------------------------------------------------
    // Instruction fetch decode helper for trace/compare checks.
    // ------------------------------------------------------------------
    function automatic [31:0] instr_at_pc_ref(input [31:0] pc);
        reg [31:0] word0;
        reg [31:0] word1;
        reg [15:0] half0;
        reg [15:0] half1;
        begin
            word0 = mem_ref[pc[13:2]];
            half0 = word0[15:0];
            half1 = word0[31:16];
            if (pc[1:0] == 2'b00) begin
                if (half0[1:0] == 2'b11)
                    instr_at_pc_ref = {16'h0, half0};
                else if (pc[1] == 1'b0)
                    instr_at_pc_ref = word0;
                else begin
                    word1 = mem_ref[pc[13:2] + 1'b1];
                    instr_at_pc_ref = {word1[15:0], half0};
                end
            end else begin
                if (half1[1:0] == 2'b11)
                    instr_at_pc_ref = {16'h0, half1};
                else begin
                    word1 = mem_ref[pc[13:2] + 1'b1];
                    instr_at_pc_ref = {word1[15:0], half1};
                end
            end
        end
    endfunction

    function automatic [31:0] instr_at_pc_top(input [31:0] pc);
        reg [31:0] word0;
        reg [31:0] word1;
        reg [15:0] half0;
        reg [15:0] half1;
        begin
            word0 = mem_top[pc[13:2]];
            half0 = word0[15:0];
            half1 = word0[31:16];
            if (pc[1:0] == 2'b00) begin
                if (half0[1:0] == 2'b11)
                    instr_at_pc_top = {16'h0, half0};
                else if (pc[1] == 1'b0)
                    instr_at_pc_top = word0;
                else begin
                    word1 = mem_top[pc[13:2] + 1'b1];
                    instr_at_pc_top = {word1[15:0], half0};
                end
            end else begin
                if (half1[1:0] == 2'b11)
                    instr_at_pc_top = {16'h0, half1};
                else begin
                    word1 = mem_top[pc[13:2] + 1'b1];
                    instr_at_pc_top = {word1[15:0], half1};
                end
            end
        end
    endfunction

    // ------------------------------------------------------------------
    task automatic load_memory(input [1023:0] path, input int mem_sel);
        integer i;
        begin
            for (i = 0; i < MEM_SIZE; i = i + 1) begin
                case (mem_sel)
                    0: mem_ref[i] <= 32'h0;
                    1: mem_top[i] <= 32'h0;
                    default: begin
                        mem_ref[i] <= 32'h0;
                        mem_top[i] <= 32'h0;
                    end
                endcase
            end

            $readmemh(path, (mem_sel == 0) ? mem_ref : mem_top);

            if (mem_sel == 0) begin
                if (path == "firmware.hex") $readmemh(path, mem_ref);
            end
        end
    end
    endtask

    task automatic do_reset;
        begin
            resetn <= 1'b0;
            run_ref <= 1'b0;
            run_top <= 1'b0;
            i_cycle <= 32'h0;
            d_cycle <= 32'h0;
            i_lfsr <= 16'hACE1;
            d_lfsr <= 16'h1ACE;
            top_commit_count <= 0;
            saw_misaligned_bus <= 1'b0;
            misaligned_event_count <= 0;
            misaligned_cause[0] <= 32'h0;
            misaligned_cause[1] <= 32'h0;
            misaligned_cause[2] <= 32'h0;
            misaligned_cause[3] <= 32'h0;
            misaligned_mtval[0] <= 32'h0;
            misaligned_mtval[1] <= 32'h0;
            misaligned_mtval[2] <= 32'h0;
            misaligned_mtval[3] <= 32'h0;
            repeat (6) @(posedge clk);
            resetn <= 1'b1;
        end
    endtask

    task automatic run_baseline_ref_top;
        input string label;
        integer timeout;
        integer cycles;
        integer ref_idx;
        integer top_idx;
        integer ref_fd;
        reg [31:0] exp_pc;
        reg [31:0] exp_instr;
        reg [4:0]  exp_rd;
        reg [31:0] exp_wdata;
        begin
            do_reset();
            run_ref = 1'b1;
            run_top = 1'b1;
            i_wait_mode = WAIT_MODE_0;
            d_wait_mode = WAIT_MODE_0;

            ref_commit_count = 0;
            top_idx = 0;
            cycles = 0;
            ref_fd = $fopen("baseline_commit.trace", "w");
            $fdisplay(ref_fd, "idx,pc,instr,rd,wdata");

            forever begin
                @(posedge clk);
                cycles = cycles + 1;

                if (dut_trap_violation()) begin
                    $display("%s fail: illegal mismatch", label);
                    $fatal(1);
                end

                if (run_ref && ref_core.wb_instr_retired) begin
                    exp_pc = ref_core.ex_wb_pc_r;
                    exp_instr = instr_at_pc_ref(exp_pc);
                    exp_rd = (ref_core.rfu_wr_idx != 5'h0 && ref_core.rfu_we) ? ref_core.rfu_wr_idx : 5'h0;
                    exp_wdata = (ref_core.rfu_wr_idx != 5'h0 && ref_core.rfu_we) ? ref_core.rfu_wr_data : 32'h0;

                    if (ref_commit_count >= MAX_COMMITS) begin
                        $display("%s fail: ref commit count overflow", label);
                        $fatal(1);
                    end

                    ref_pc[ref_commit_count]    <= exp_pc;
                    ref_instr[ref_commit_count] <= exp_instr;
                    ref_rd[ref_commit_count]    <= exp_rd;
                    ref_wdata[ref_commit_count] <= exp_wdata;
                    $fdisplay(ref_fd, "%0d,%08x,%08x,%0d,%08x", ref_commit_count, exp_pc, exp_instr, exp_rd, exp_wdata);
                    ref_commit_count = ref_commit_count + 1;
                end

                if (run_top && uut.u_core.wb_instr_retired) begin
                    if (top_idx >= ref_commit_count) begin
                        $display("%s fail: top commit before ref commit", label);
                        $fatal(1);
                    end
                    if (uut.u_core.ex_wb_pc_r != ref_pc[top_idx]) begin
                        $display("%s fail: pc mismatch idx=%0d ref=%08x dut=%08x",
                                 label, top_idx, ref_pc[top_idx], uut.u_core.ex_wb_pc_r);
                        $fatal(1);
                    end
                    if (instr_at_pc_top(uut.u_core.ex_wb_pc_r) != ref_instr[top_idx]) begin
                        $display("%s fail: instr mismatch idx=%0d", label, top_idx);
                        $fatal(1);
                    end
                    if (((uut.u_core.rfu_wr_idx != 5'h0 && uut.u_core.rfu_we) ? uut.u_core.rfu_wr_idx : 5'h0) != ref_rd[top_idx]) begin
                        $display("%s fail: rd mismatch idx=%0d", label, top_idx);
                        $fatal(1);
                    end
                    if (((uut.u_core.rfu_wr_idx != 5'h0 && uut.u_core.rfu_we) ? uut.u_core.rfu_wr_data : 32'h0) != ref_wdata[top_idx]) begin
                        $display("%s fail: wdata mismatch idx=%0d", label, top_idx);
                        $fatal(1);
                    end
                    top_idx = top_idx + 1;
                end

                if (top_idx > ref_commit_count)
                    ;

                if (ref_core.ex_wb_valid_r && ref_core.ex_wb_illegal_r)
                    break;

                if (cycles > timeout) begin
                    $display("%s fail: timeout", label);
                    $fatal(1);
                end
            end

            if (!uut.u_core.ex_wb_valid_r || !uut.u_core.ex_wb_illegal_r) begin
                $display("%s fail: top did not reach terminal illegal", label);
                $fatal(1);
            end
            if (top_idx != ref_commit_count) begin
                $display("%s fail: commit count mismatch idx=%0d ref=%0d", label, top_idx, ref_commit_count);
                $fatal(1);
            end
            $fclose(ref_fd);
            $display("%s pass: %0d commits", label, ref_commit_count);
        end
    endtask

    function automatic bit dut_trap_violation;
        begin
            dut_trap_violation = ((ref_core.ex_wb_valid_r && ref_core.ex_wb_illegal_r) != (uut.u_core.ex_wb_valid_r && uut.u_core.ex_wb_illegal_r));
        end
    endfunction

    task automatic run_top_waits;
        input string label;
        input int wait_i;
        input int wait_d;
        input int check_trace;
        input string mode_tag;
        integer cycles;
        integer fd;
        integer idx;
        reg [31:0] exp_pc;
        reg [31:0] exp_instr;
        reg [4:0]  exp_rd;
        reg [31:0] exp_wdata;
        begin
            do_reset();
            run_ref = 1'b0;
            run_top = 1'b1;
            i_wait_mode = wait_i;
            d_wait_mode = wait_d;

            top_commit_count = 0;
            cycles = 0;

            if (check_trace) begin
                fd = $fopen("dut_commit.trace", "w");
                $fdisplay(fd, "idx,pc,instr,rd,wdata");
            end

            forever begin
                @(posedge clk);
                cycles = cycles + 1;

                if (uut.u_core.wb_instr_retired) begin
                    if (top_commit_count >= MAX_COMMITS) begin
                        $display("%s[%s] fail: commit overflow", label, mode_tag);
                        $fatal(1);
                    end

                    if (top_commit_count >= ref_commit_count) begin
                        $display("%s[%s] fail: no baseline entry", label, mode_tag);
                        $fatal(1);
                    end

                    exp_pc = ref_pc[top_commit_count];
                    exp_instr = ref_instr[top_commit_count];
                    exp_rd = ref_rd[top_commit_count];
                    exp_wdata = ref_wdata[top_commit_count];

                    if (uut.u_core.ex_wb_pc_r != exp_pc) begin
                        $display("%s[%s] fail: commit idx=%0d pc mismatch ref=%08x dut=%08x",
                                 label, mode_tag, top_commit_count, exp_pc, uut.u_core.ex_wb_pc_r);
                        $fatal(1);
                    end
                    if (instr_at_pc_top(uut.u_core.ex_wb_pc_r) != exp_instr) begin
                        $display("%s[%s] fail: commit idx=%0d instr mismatch", label, mode_tag, top_commit_count);
                        $fatal(1);
                    end
                    if (((uut.u_core.rfu_wr_idx != 5'h0 && uut.u_core.rfu_we) ? uut.u_core.rfu_wr_idx : 5'h0) != exp_rd) begin
                        $display("%s[%s] fail: commit idx=%0d rd mismatch", label, mode_tag, top_commit_count);
                        $fatal(1);
                    end
                    if (((uut.u_core.rfu_wr_idx != 5'h0 && uut.u_core.rfu_we) ? uut.u_core.rfu_wr_data : 32'h0) != exp_wdata) begin
                        $display("%s[%s] fail: commit idx=%0d wdata mismatch", label, mode_tag, top_commit_idxx);
                        $fatal(1);
                    end

                    if (check_trace)
                        $fdisplay(fd, "%0d,%08x,%08x,%0d,%08x",
                                  top_commit_count,
                                  uut.u_core.ex_wb_pc_r,
                                  instr_at_pc_top(uut.u_core.ex_wb_pc_r),
                                  (uut.u_core.rfu_wr_idx != 5'h0 && uut.u_core.rfu_we) ? uut.u_core.rfu_wr_idx : 5'h0,
                                  (uut.u_core.rfu_wr_idx != 5'h0 && uut.u_core.rfu_we) ? uut.u_core.rfu_wdata : 32'h0);
                    top_commit_count = top_commit_count + 1;
                end

                if (uut.u_core.ex_wb_valid_r && uut.u_core.ex_wb_illegal_r)
                    break;

                if (cycles > MAX_WAIT_CYCLES) begin
                    $display("%s[%s] fail: timeout", label, mode_tag);
                    $fatal(1);
                end
            end

            if (top_commit_count != ref_commit_count) begin
                $display("%s[%s] fail: commit count mismatch ref=%0d dut=%0d", label, mode_tag, ref_commit_count, top_commit_count);
                $fatal(1);
            end

            if (check_trace)
                $fclose(fd);
            $display("%s[%s] pass: %0d commits", label, mode_tag, top_commit_count);
        end
    endtask

    task automatic run_misaligned_tb;
        integer cycles;
        begin
            load_memory("firmware_misalign.hex", 1);
            do_reset();
            run_ref = 1'b0;
            run_top = 1'b1;
            i_wait_mode = WAIT_MODE_0;
            d_wait_mode = WAIT_MODE_0;

            cycles = 0;
            top_commit_count = 0;

            forever begin
                @(posedge clk);
                cycles = cycles + 1;

                if (dbus_req && !dbus_addr[28] && (dbus_addr[1:0] != 2'b00))
                    saw_misaligned_bus <= 1'b1;

                if (uut.u_core.wb_instr_retired)
                    top_commit_count = top_commit_count + 1;

                if (uut.u_core.ex_wb_valid_r && uut.u_core.ex_wb_illegal_r)
                    break;

                if (cycles > MAX_WAIT_CYCLES) begin
                    $display("misalign fail: timeout");
                    $fatal(1);
                end
            end

            if (saw_misaligned_bus) begin
                $display("misalign fail: misaligned bus request escaped wrapper/core");
                $fatal(1);
            end

            if (misaligned_event_count !== 2'd4) begin
                misaligned_event_count = 0;
                if ((misaligned_cause[0] !== 32'h0) misaligned_event_count = misaligned_event_count + 1;
                if ((misaligned_cause[1] !== 32'h0) misaligned_event_count = misaligned_event_count + 1;
                if ((misaligned_cause[2] !== 32'h0) misaligned_event_count = misaligned_event_count + 1;
                if ((misaligned_cause[3] !== 32'h0) misaligned_event_count = misaligned_event_count + 1;
            end

            if ((misaligned_cause[0] !== 32'h00000004) ||
                (misaligned_cause[1] !== 32'h00000006) ||
                (misaligned_cause[2] !== 32'h00000004) ||
                (misaligned_cause[3] !== 32'h00000006) ||
                (misaligned_mtval[0] !== 32'h00000101) ||
                (misaligned_mtval[1] !== 32'h00000101) ||
                (misaligned_mtval[2] !== 32'h00000101) ||
                (misaligned_mtval[3] !== 32'h00000103)) begin
                $display("misalign fail: cause/mtval mismatch");
                $display("  causes=%08x %08x %08x %08x", misaligned_cause[0], misaligned_cause[1], misaligned_cause[2], misaligned_cause[3]);
                $display("  mtvals=%08x %08x %08x %08x", misaligned_mtval[0], misaligned_mtval[1], misaligned_mtval[2], misaligned_mtval[3]);
                $fatal(1);
            end

            $display("misalign pass: 4 traps with exact mcause/mtval and no misaligned bus req");
        end
    endtask

    // ------------------------------------------------------------------
    // Top-level simulation driver
    // ------------------------------------------------------------------
    integer i;
    integer top_modes_idx;
    initial begin
        mem_top[0]  = 32'h0;
        mem_ref[0]  = 32'h0;

        $readmemh("firmware.hex", mem_ref);
        $readmemh("firmware.hex", mem_top);

        for (i = 0; i < MAX_COMMITS; i = i + 1) begin
            ref_pc[i]    = 32'h0;
            ref_instr[i] = 32'h0;
            ref_rd[i]    = 5'h0;
            ref_wdata[i] = 32'h0;
        end

        run_baseline_ref_top("ASSERT_A_zero_wait_equiv", 5000);

        run_top_waits("ASSERT_B_wait_i", WAIT_MODE_1, WAIT_MODE_0, 1, "i1");
        run_top_waits("ASSERT_B_wait_i", WAIT_MODE_3, WAIT_MODE_0, 1, "i3");
        run_top_waits("ASSERT_B_wait_i", WAIT_MODE_RANDOM, WAIT_MODE_0, 1, "irandom");
        run_top_waits("ASSERT_B_wait_d", WAIT_MODE_0, WAIT_MODE_1, 1, "d1");
        run_top_waits("ASSERT_B_wait_d", WAIT_MODE_0, WAIT_MODE_3, 1, "d3");
        run_top_waits("ASSERT_B_wait_d", WAIT_MODE_0, WAIT_MODE_RANDOM, 1, "drandom");

        run_top_waits("ASSERT_D_lockstep_random", WAIT_MODE_RANDOM, WAIT_MODE_RANDOM, 0, "lockstep-random");

        run_misaligned_tb();

        $write("SUMMARY");
        $display("PASS: mem_wrapper TB checks A/B/C/D complete");
        $display("PASS: ref commits=%0d", ref_commit_count);
        $finish;
    end

    // Clock
    always #5 clk = ~clk;

    // Dumps
    initial begin
        $dumpfile("wave.vcd");
        $dumpvars(0, tb_mem_wrapper);
    end

endmodule
