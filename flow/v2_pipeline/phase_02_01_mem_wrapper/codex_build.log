    // drive bp.v 的 upd port → BP counter_arr.D 跟 target_arr.D path 從 register
    // output 出發 (不再有 alu_result 進 BP write data 路徑)
    wire        ex_bp_upd_valid  = if_ex_valid && (id_is_branch | id_is_jal)
