I confirmed `spike` in this environment doesn’t expose `--misaligned`, so I’ll keep misaligned behavior comparison aligned to this toolchain’s default and explicitly guard the TB to verify DUT mcause/mtval directly during the induced misaligned accesses.
exec
/bin/bash -lc "mkdir -p /tmp/misatest && cat >/tmp/misatest/misaligned_test.S <<'EOF'
.section .init
.global _start
_start:
    la t0, data
    lw t1, 1(t0)
    ebreak
    .balign 4
.data
    .word 0x12345678
.section .text
EOF
cat >/tmp/misatest/misaligned_test.lds <<'EOF'
OUTPUT_ARCH(\"riscv\")
ENTRY(_start)
MEMORY
{
  rom (rx) : ORIGIN = 0x00000000, LENGTH = 4K
}
SECTIONS
{
  . = ORIGIN(rom);
  .text : { *(.init) *(.text*) } > rom
  .rodata : { *(.rodata*) } > rom
  .data : { *(.data*) } > rom
}
EOF
