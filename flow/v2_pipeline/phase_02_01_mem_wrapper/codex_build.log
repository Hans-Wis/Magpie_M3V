                    ref_rd[ref_count]    = (ref_core.rfu_wr_idx != 5'h0 && ref_core.rfu_we) ? ref_core.rfu_wr_idx : 5'h0;
                    ref_wdata[ref_count] = (ref_core.rfu_wr_idx != 5'h0 && ref_core.rfu_we) ? ref_core.rfu_wr_data : 32'h0;
