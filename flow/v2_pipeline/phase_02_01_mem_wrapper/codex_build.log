index 0000000000000000000000000000000000000000..8c04f9ad540f3776c0942eb1fdd5732bc9980cc1
--- /dev/null
+++ b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/cpu_m1_top.v
@@ -0,0 +1,149 @@
+// =============================================================================
+// cpu_m1_top
+//
+// Magpie_M1 CPU IP wrapper (Phase 2.1 mem-wrapper).
+// Presents Harvard valid/ready I/D busses with single-outstanding request hold.
+//
+// Contract:
+//  - ibus_req/dbus_req stay high until ready=1.
+//  - no new I/D request is issued while either I or D request is outstanding.
+//  - commit/debug visibility is passed through from the core.
+//
+// mem_stall = any outstanding request waiting for ready (not a generic ready
+// delay signal). The fixed-latency core is frozen through `mem_stall`.
+// =============================================================================
+
+module cpu_m1_top(
+    input             clk,
+    input             resetn,
+
+    // Core trap output
+    output            trap,
+
+    // I-side valid/ready interface (1 outstanding, Harvard)
+    output            ibus_req,
+    output [31:0]     ibus_addr,
+    input             ibus_ready,
+    input  [31:0]     ibus_rdata,
+
+    // D-side valid/ready interface (1 outstanding, Harvard)
+    output            dbus_req,
+    output [31:0]     dbus_addr,
+    output            dbus_we,
+    output [3:0]      dbus_wstrb,
+    output [31:0]     dbus_wdata,
+    input             dbus_ready,
+    input  [31:0]     dbus_rdata,
+
+    // External IRQ
+    input             irq_external_pulse,
+
+    // Debug pass-through
+    output [31:0]     dbg_pc,
+    output [31:0]     dbg_instr,
+    output [ 2:0]     dbg_state
+);
+
+    // ---------------------------------------------------------------------
+    // Core interface
+    // ---------------------------------------------------------------------
+    wire        core_i_mem_en;
+    wire [31:0] core_i_mem_addr;
+    wire        core_d_mem_valid;
+    wire [31:0] core_d_mem_addr;
+    wire [31:0] core_d_mem_wdata;
+    wire [ 3:0] core_d_mem_wstrb;
+
+    // Hold-one-bus-transaction state for each port
+    reg  i_hold;
+    reg  [31:0] i_hold_addr;
+
+    reg  d_hold;
+    reg  [31:0] d_hold_addr;
+    reg  [31:0] d_hold_wdata;
+    reg  [ 3:0] d_hold_wstrb;
+
+    // Stall when either core-facing request is outstanding and not yet ready.
+    wire mem_stall;
+    assign mem_stall = (i_hold && !ibus_ready) || (d_hold && !dbus_ready);
+
+    // ---------------------------------------------------------------------
+    // I-port hold semantics
+    //  - launch with new core request when no hold
+    //  - keep req/data stable while ready stays low
+    // ---------------------------------------------------------------------
+    assign ibus_req  = i_hold || core_i_mem_en;
+    assign ibus_addr = i_hold ? i_hold_addr : core_i_mem_addr;
+
+    always @(posedge clk) begin
+        if (!resetn) begin
+            i_hold     <= 1'b0;
+            i_hold_addr <= 32'h0;
+        end else begin
+            if (i_hold) begin
+                if (ibus_ready)
+                    i_hold <= 1'b0;
+            end else if (core_i_mem_en) begin
+                i_hold_addr <= core_i_mem_addr;
+                if (!ibus_ready)
+                    i_hold <= 1'b1;
+            end
+        end
+    end
+
+    // ---------------------------------------------------------------------
+    // D-port hold semantics
+    // ---------------------------------------------------------------------
+    assign dbus_req   = d_hold || core_d_mem_valid;
+    assign dbus_addr  = d_hold ? d_hold_addr : core_d_mem_addr;
+    assign dbus_wdata = d_hold ? d_hold_wdata : core_d_mem_wdata;
+    assign dbus_wstrb = d_hold ? d_hold_wstrb : core_d_mem_wstrb;
+    assign dbus_we    = |dbus_wstrb;
+
+    always @(posedge clk) begin
+        if (!resetn) begin
+            d_hold      <= 1'b0;
+            d_hold_addr <= 32'h0;
+            d_hold_wdata<= 32'h0;
+            d_hold_wstrb<= 4'h0;
+        end else begin
+            if (d_hold) begin
+                if (dbus_ready)
+                    d_hold <= 1'b0;
+            end else if (core_d_mem_valid) begin
+                d_hold_addr <= core_d_mem_addr;
+                d_hold_wdata <= core_d_mem_wdata;
+                d_hold_wstrb <= core_d_mem_wstrb;
+                if (!dbus_ready)
+                    d_hold <= 1'b1;
+            end
+        end
+    end
+
+    // ---------------------------------------------------------------------
+    // Core
+    // ---------------------------------------------------------------------
+    core u_core(
+        .clk                (clk),
+        .resetn             (resetn),
+        .trap               (trap),
+        .mem_stall          (mem_stall),
+
+        .i_mem_addr         (core_i_mem_addr),
+        .i_mem_en           (core_i_mem_en),
+        .i_mem_rdata        (ibus_rdata),
+
+        .d_mem_valid        (core_d_mem_valid),
+        .d_mem_addr         (core_d_mem_addr),
+        .d_mem_wdata        (core_d_mem_wdata),
+        .d_mem_wstrb        (core_d_mem_wstrb),
+        .d_mem_rdata        (dbus_rdata),
+
+        .irq_external_pulse (irq_external_pulse),
+
+        .dbg_pc             (dbg_pc),
+        .dbg_instr          (dbg_instr),
+        .dbg_state          (dbg_state)
+    );
+
+endmodule
