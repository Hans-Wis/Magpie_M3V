diff --git a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/def.vh b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/def.vh
index c275236a9b929dbed8a97a54705cd661fbc4b668..5afdb2e9994d8deeeacaa04e5c0fcc8955ea3b11
--- a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/def.vh
