    add   x11, x11, x8

    sw    x6, 0(x11)       # cause
    sw    x7, 4(x11)       # mtval

    addi  x10, x10, 1
    sw    x10, 0(x9)

    mret

.section .bss
.align 4
trap_count:
    .word 0
EOF" in /home/edauser/project/SOC/Magpie_M1
