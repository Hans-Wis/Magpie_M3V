   167	                if (dbus_addr[31:28] == 4'h1) begin
   168	                    mmio_idx = dbus_addr[4:2];
   169	                    if (dbus_we && (mmio_idx < 8)) begin
   170	                        if (mmio_idx[0] == 1'b0)
   171	                            misaligned_cause[mmio_idx >> 1] <= dbus_wdata;
   172	                        else
   173	                            misaligned_mtval[mmio_idx >> 1] <= dbus_wdata;
   174	                    end
   175	                end else if (dbus_we) begin
   176	                    if (dbus_wstrb[0]) mem_top[top_d_word_idx][ 7:0]  <= dbus_wdata[ 7:0];
   177	                    if (dbus_wstrb[1]) mem_top[top_d_word_idx][15:8]  <= dbus_wdata[15:8];
   178	                    if (dbus_wstrb[2]) mem_top[top_d_word_idx][23:16] <= dbus_wdata[23:16];
   179	                    if (dbus_wstrb[3]) mem_top[top_d_word_idx][31:24] <= dbus_wdata[31:24];
   180	                end
   181	            end
   182	        end
   183	    end
   184	
   185	    function automatic [31:0] instr_at_pc_ref(input [31:0] pc);
   186	        reg [31:0] word0;
   187	        reg [31:0] word1;
   188	        reg [15:0] half0;
   189	        reg [15:0] half1;
