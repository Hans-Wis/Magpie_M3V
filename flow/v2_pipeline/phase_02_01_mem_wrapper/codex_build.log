@@ -142,6 +143,8 @@
 // IRQ cause (mcause 內容)
 // -----------------------------------------------------------------------------
 `define MCAUSE_EXT_IRQ 32'h8000_000B  // bit 31 = 1 (interrupt), code 11 = M ext
+`define MCAUSE_LOAD_ADDR_MISALIGNED 32'h0000_0004
