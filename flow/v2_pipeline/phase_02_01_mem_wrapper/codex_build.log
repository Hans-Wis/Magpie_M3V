            ex_mem_bp_upd_pc_r       <= ex_bp_upd_pc;
            ex_mem_bp_upd_taken_r    <= ex_bp_upd_taken;
            ex_mem_bp_upd_target_r   <= ex_bp_upd_target;
            ex_mem_pred_ras_r        <= if_ex_pred_ras;
            ex_mem_pred_ras_target_r <= if_ex_pred_ras_target;
