   228	                else begin
   229	                    word1 = ((pc[ADDR_BITS+1:2] + 1'b1) < MEM_WORDS) ? mem_top[pc[ADDR_BITS+1:2] + 1'b1] : 32'h0;
   230	                    instr_at_pc_top = {word1[15:0], half0};
   231	                end
   232	            end else begin
   233	                if (half1[1:0] == 2'b11)
