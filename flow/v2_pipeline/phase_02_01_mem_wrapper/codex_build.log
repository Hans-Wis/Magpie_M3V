   632	    reg        ex_mem_is_jal_r;
   633	    reg        ex_mem_is_jalr_r;
   634	    reg        ex_mem_illegal_r;
   635	    // Lab08b: BP mispredict 取代「無條件 branch_taken/jal/jalr → redirect」
   636	    // 注意：不 latch recovery_target — 在 MEM stage 用 ex_mem.Q registers 組合算
   637	    //       (避免 alu_result → ex_mem_recovery_target_r.D 的 critical path)
   638	    reg        ex_mem_mispredict_r;
   639	    // Lab08b: BP update path register (避免 alu_result→counter_arr/target_arr.D
   640	    // 的 critical path；多 1 cycle update latency，但對 hot-loop 命中率影響忽略)
   641	    reg        ex_mem_bp_upd_valid_r;
   642	    reg [31:0] ex_mem_bp_upd_pc_r;
   643	    reg        ex_mem_bp_upd_taken_r;
   644	    reg [31:0] ex_mem_bp_upd_target_r;
   645	    // Lab08c: RAS prediction info forwarded to MEM stage for target verify
   646	    reg        ex_mem_pred_ras_r;
   647	    reg [31:0] ex_mem_pred_ras_target_r;
   648	
   649	    // ID/EX → EX/MEM 推進條件
   650	    // Lab08e: !any_stall (= 不在 lu/md/at_cross_boundary/warmup stall 期間)。
   651	    wire id_advance_to_ex_mem = !any_stall && if_ex_valid && !warmup && !pc_redirect;
   652	
   653	    always @(posedge clk) begin
   654	        if (!resetn) begin
   655	            ex_mem_valid_r           <= 1'b0;
   656	            ex_mem_rd_we_r           <= 1'b0;
   657	            ex_mem_is_load_r         <= 1'b0;
   658	            ex_mem_is_store_r        <= 1'b0;
   659	            ex_mem_store_wstrb_r     <= 4'h0;
   660	            ex_mem_is_mret_r         <= 1'b0;
   661	            ex_mem_is_misaligned_r   <= 1'b0;
   662	            ex_mem_is_misaligned_store_r <= 1'b0;
   663	            ex_mem_csr_we_r          <= 1'b0;
   664	            ex_mem_is_branch_taken_r <= 1'b0;
   665	            ex_mem_is_jal_r          <= 1'b0;
   666	            ex_mem_is_jalr_r         <= 1'b0;
   667	            ex_mem_illegal_r         <= 1'b0;
   668	            ex_mem_mispredict_r      <= 1'b0;
   669	            ex_mem_bp_upd_valid_r    <= 1'b0;
   670	            ex_mem_pred_ras_r        <= 1'b0;
   671	        end else if (id_advance_to_ex_mem) begin
   672	            ex_mem_valid_r           <= 1'b1;
   673	            ex_mem_pc_r              <= if_ex_pc;
   674	            ex_mem_alu_result_r      <= alu_result;
   675	            ex_mem_md_result_r       <= md_result;
   676	            ex_mem_pc_plus_4_r       <= if_ex_pc_plus_4;
   677	            ex_mem_pc_plus_imm_r     <= if_ex_pc_plus_imm;
   678	            ex_mem_csr_rdata_r       <= csr_rdata;
   679	            ex_mem_rd_idx_r          <= id_rd_idx;
   680	            ex_mem_rd_we_r           <= id_rd_we;
   681	            ex_mem_wb_sel_r          <= id_wb_sel;
   682	            ex_mem_is_load_r         <= id_is_load;
   683	            ex_mem_is_store_r        <= id_is_store;
   684	            ex_mem_ls_funct3_r       <= id_ls_funct3;
   685	            ex_mem_addr_lo_r         <= alu_result[1:0];
   686	            ex_mem_store_wdata_r     <= lsu_mem_wdata_id;
   687	            ex_mem_store_wstrb_r     <= id_is_store && id_mem_active ? lsu_mem_wstrb_id : 4'h0;
   688	            ex_mem_is_mret_r         <= id_is_mret;
   689	            ex_mem_is_misaligned_r   <= id_mem_misaligned;
   690	            ex_mem_is_misaligned_store_r <= id_is_store;
   691	            ex_mem_csr_we_r          <= id_csr_we_logic;
   692	            ex_mem_csr_addr_r        <= id_csr_addr;
   693	            ex_mem_csr_op_r          <= id_csr_op;
   694	            ex_mem_csr_wdata_r       <= id_csr_wdata;
   695	            ex_mem_is_branch_taken_r <= branch_taken;
   696	            ex_mem_is_jal_r          <= id_is_jal;
   697	            ex_mem_is_jalr_r         <= id_is_jalr;
   698	            ex_mem_illegal_r         <= id_illegal;
   699	            ex_mem_mispredict_r      <= ex_mispredict;
   700	            ex_mem_bp_upd_valid_r    <= ex_bp_upd_valid;
   701	            ex_mem_bp_upd_pc_r       <= ex_bp_upd_pc;
   702	            ex_mem_bp_upd_taken_r    <= ex_bp_upd_taken;
   703	            ex_mem_bp_upd_target_r   <= ex_bp_upd_target;
   704	            ex_mem_pred_ras_r        <= if_ex_pred_ras;
   705	            ex_mem_pred_ras_target_r <= if_ex_pred_ras_target;
   706	        end else begin
   707	            // Stall / wrong-path / warmup: 插 bubble
   708	            ex_mem_valid_r           <= 1'b0;
   709	            ex_mem_rd_we_r           <= 1'b0;
   710	            ex_mem_is_load_r         <= 1'b0;
   711	            ex_mem_is_store_r        <= 1'b0;
   712	            ex_mem_store_wstrb_r     <= 4'h0;
   713	            ex_mem_is_mret_r         <= 1'b0;
   714	            ex_mem_is_misaligned_r   <= 1'b0;
   715	            ex_mem_is_misaligned_store_r <= 1'b0;
   716	            ex_mem_csr_we_r          <= 1'b0;
   717	            ex_mem_is_branch_taken_r <= 1'b0;
   718	            ex_mem_is_jal_r          <= 1'b0;
   719	            ex_mem_is_jalr_r         <= 1'b0;
   720	            ex_mem_illegal_r         <= 1'b0;
   721	            ex_mem_mispredict_r      <= 1'b0;
   722	            ex_mem_bp_upd_valid_r    <= 1'b0;
   723	            ex_mem_pred_ras_r        <= 1'b0;
   724	        end
   725	    end
   726	
   727	    // Lab08c: MEM-stage RAS target verify (combinational from ex_mem.Q)
   728	    //   pred_ras=1 表示 IF 階段 RAS 預測這條 jalr 的 target；現在比對 alu_result 是否相同
   729	    //   alu_result for jalr = rs1 + imm = ra (因為 ret 是 jalr x0, ra, 0)，& ~1 mask LSB
   730	    //   mismatch → fire 額外 redirect (priority 比 ex_mem_mispredict 高)
   731	    wire [31:0] mem_ras_actual_target = ex_mem_alu_result_r & ~32'd1;
   732	    wire        mem_ras_mispredict    = ex_mem_valid_r && ex_mem_pred_ras_r
   733	                                     && (mem_ras_actual_target != ex_mem_pred_ras_target_r);
   734	
   735	    // BP update 用 ex_mem_bp_upd_* register output 驅動 (1 cycle delay)
   736	    assign bp_upd_valid  = ex_mem_bp_upd_valid_r;
   737	    assign bp_upd_pc     = ex_mem_bp_upd_pc_r;
   738	    assign bp_upd_taken  = ex_mem_bp_upd_taken_r;
   739	    assign bp_upd_target = ex_mem_bp_upd_target_r;
   740	
   741	    // =========================================================================
   742	    // EX/WB pipeline register
   743	    //   存：給 WB stage 用的 control + data (從 ex_mem.Q 傳過來)
   744	    //   load 在這 stage 才看到 d_mem_rdata (BRAM 1-cycle latency 對齊)
   745	    // =========================================================================
   746	    reg        ex_wb_valid_r;
   747	    /* verilator lint_off UNUSEDSIGNAL */  // 留作 debug; trap_pc 走 pc_plus_4 路徑
   748	    reg [31:0] ex_wb_pc_r;
   749	    /* verilator lint_on UNUSEDSIGNAL */
   750	    reg [31:0] ex_wb_alu_result_r;
   751	    reg [31:0] ex_wb_md_result_r;
   752	    reg [31:0] ex_wb_pc_plus_4_r;
   753	    reg [31:0] ex_wb_pc_plus_imm_r;
   754	    reg [31:0] ex_wb_csr_rdata_r;
   755	    reg [ 4:0] ex_wb_rd_idx_r;
   756	    reg        ex_wb_rd_we_r;
   757	    reg [ 2:0] ex_wb_wb_sel_r;
   758	    reg        ex_wb_is_load_r;
   759	    /* verilator lint_off UNUSEDSIGNAL */
   760	    reg        ex_wb_is_store_r;   // store 在 MEM 已 commit 到 d-port，WB 不用
   761	    /* verilator lint_on UNUSEDSIGNAL */
   762	    reg        ex_wb_is_misaligned_r;
   763	    reg        ex_wb_is_misaligned_store_r;
   764	    reg [ 2:0] ex_wb_ls_funct3_r;
   765	    reg [ 1:0] ex_wb_addr_lo_r;
   766	    reg        ex_wb_is_mret_r;
   767	    reg        ex_wb_csr_we_r;
   768	    reg [11:0] ex_wb_csr_addr_r;
   769	    reg [ 1:0] ex_wb_csr_op_r;
   770	    reg [31:0] ex_wb_csr_wdata_r;
   771	    reg        ex_wb_is_branch_taken_r;
   772	    reg        ex_wb_is_jal_r;
   773	    reg        ex_wb_is_jalr_r;
   774	    reg        ex_wb_illegal_r;
   775	    wire       wb_take_irq;
   776	
   777	    // EX/MEM → EX/WB 推進條件
   778	    //   branch/JAL/JALR 在 ex_mem 觸發 pc_redirect 不影響自己 advance 到 WB
   779	    //   只有 wb_redirect (IRQ/MRET 從 ex_wb 觸發) 才 flush ex_mem (= wrong-path)
   780	    wire wb_redirect = wb_take_irq || (ex_wb_valid_r && ex_wb_is_mret_r);
   781	    wire ex_mem_advance_to_wb = ex_mem_valid_r && !wb_redirect;
   782	
   783	    always @(posedge clk) begin
   784	        if (!resetn) begin
   785	            ex_wb_valid_r           <= 1'b0;
   786	            ex_wb_pc_r              <= 32'h0;
   787	            ex_wb_alu_result_r      <= 32'h0;
   788	            ex_wb_md_result_r       <= 32'h0;
   789	            ex_wb_pc_plus_4_r       <= 32'h0;
   790	            ex_wb_pc_plus_imm_r     <= 32'h0;
   791	            ex_wb_csr_rdata_r       <= 32'h0;
   792	            ex_wb_rd_idx_r          <= 5'h0;
   793	            ex_wb_rd_we_r           <= 1'b0;
   794	            ex_wb_wb_sel_r          <= 3'h0;
   795	            ex_wb_is_load_r         <= 1'b0;
   796	            ex_wb_is_store_r        <= 1'b0;
   797	            ex_wb_is_misaligned_r       <= 1'b0;
   798	            ex_wb_is_misaligned_store_r <= 1'b0;
   799	            ex_wb_ls_funct3_r       <= 3'h0;
   800	            ex_wb_addr_lo_r         <= 2'h0;
   801	            ex_wb_is_mret_r         <= 1'b0;
   802	            ex_wb_csr_we_r          <= 1'b0;
   803	            ex_wb_csr_addr_r        <= 12'h0;
   804	            ex_wb_csr_op_r          <= 2'h0;
   805	            ex_wb_csr_wdata_r       <= 32'h0;
   806	            ex_wb_is_branch_taken_r <= 1'b0;
   807	            ex_wb_is_jal_r          <= 1'b0;
   808	            ex_wb_is_jalr_r         <= 1'b0;
   809	            ex_wb_illegal_r         <= 1'b0;
   810	        end else if (ex_mem_advance_to_wb) begin
   811	            ex_wb_valid_r           <= 1'b1;
   812	            ex_wb_pc_r              <= ex_mem_pc_r;
   813	            ex_wb_alu_result_r      <= ex_mem_alu_result_r;
   814	            ex_wb_md_result_r       <= ex_mem_md_result_r;
   815	            ex_wb_pc_plus_4_r       <= ex_mem_pc_plus_4_r;
   816	            ex_wb_pc_plus_imm_r     <= ex_mem_pc_plus_imm_r;
   817	            ex_wb_csr_rdata_r       <= ex_mem_csr_rdata_r;
   818	            ex_wb_rd_idx_r          <= ex_mem_rd_idx_r;
   819	            ex_wb_rd_we_r           <= ex_mem_rd_we_r;
   820	            ex_wb_wb_sel_r          <= ex_mem_wb_sel_r;
   821	            ex_wb_is_load_r         <= ex_mem_is_load_r;
   822	            ex_wb_is_store_r        <= ex_mem_is_store_r;
   823	            ex_wb_is_misaligned_r       <= ex_mem_is_misaligned_r;
   824	            ex_wb_is_misaligned_store_r <= ex_mem_is_misaligned_store_r;
   825	            ex_wb_ls_funct3_r       <= ex_mem_ls_funct3_r;
   826	            ex_wb_addr_lo_r         <= ex_mem_addr_lo_r;
   827	            ex_wb_is_mret_r         <= ex_mem_is_mret_r;
   828	            ex_wb_csr_we_r          <= ex_mem_csr_we_r;
   829	            ex_wb_csr_addr_r        <= ex_mem_csr_addr_r;
   830	            ex_wb_csr_op_r          <= ex_mem_csr_op_r;
   831	            ex_wb_csr_wdata_r       <= ex_mem_csr_wdata_r;
   832	            ex_wb_is_branch_taken_r <= ex_mem_is_branch_taken_r;
   833	            ex_wb_is_jal_r          <= ex_mem_is_jal_r;
   834	            ex_wb_is_jalr_r         <= ex_mem_is_jalr_r;
   835	            ex_wb_illegal_r         <= ex_mem_illegal_r;
   836	        end else begin
   837	            // Stall / wrong-path: 插 bubble
   838	            ex_wb_valid_r           <= 1'b0;
   839	            ex_wb_rd_we_r           <= 1'b0;
   840	            ex_wb_is_load_r         <= 1'b0;
   841	            ex_wb_is_store_r        <= 1'b0;
   842	            ex_wb_is_misaligned_r       <= 1'b0;
   843	            ex_wb_is_misaligned_store_r <= 1'b0;
   844	            ex_wb_is_mret_r         <= 1'b0;
   845	            ex_wb_csr_we_r          <= 1'b0;
   846	            ex_wb_is_branch_taken_r <= 1'b0;
   847	            ex_wb_is_jal_r          <= 1'b0;
   848	            ex_wb_is_jalr_r         <= 1'b0;
   849	            ex_wb_illegal_r         <= 1'b0;
   850	        end
   851	    end
   852	
   853	    // 連 forward module 用的 wires
   854	    assign ex_wb_valid    = ex_wb_valid_r;
   855	    assign ex_wb_rd_we    = ex_wb_rd_we_r;
   856	    assign ex_wb_rd_idx   = ex_wb_rd_idx_r;
   857	    assign ex_wb_is_load  = ex_wb_is_load_r;
   858	    assign wb_csr_we      = ex_wb_csr_we_r && ex_wb_valid_r && !wb_take_irq;
   859	
   860	    // =========================================================================
   861	    // MEM/WB stage
   862	    //   組合：LSU sign-ext on d_mem_rdata；wb_data mux；PC redirect
   863	    // =========================================================================
   864	    // LSU sign-extend on load
   865	    /* verilator lint_off PINCONNECTEMPTY */
   866	    lsu u_lsu_wb (
   867	        .addr_lo   (ex_wb_addr_lo_r),
   868	        .wdata_raw (32'h0),
   869	        .funct3    (ex_wb_ls_funct3_r),
   870	        .is_store  (1'b0),
   871	        .mem_rdata (d_mem_rdata),
   872	        .mem_wdata (),
   873	        .mem_wstrb (),
   874	        .ld_result (lsu_ld_result_wb)
   875	    );
   876	    /* verilator lint_on PINCONNECTEMPTY */
   877	
   878	    // WB data mux
   879	    reg [31:0] wb_data_mux;
   880	    always @* begin
   881	        case (ex_wb_wb_sel_r)
   882	            `WB_SEL_PCIMM: wb_data_mux = ex_wb_pc_plus_imm_r;
   883	            `WB_SEL_PC4  : wb_data_mux = ex_wb_pc_plus_4_r;
   884	            `WB_SEL_LSU  : wb_data_mux = lsu_ld_result_wb;
   885	            `WB_SEL_CSR  : wb_data_mux = ex_wb_csr_rdata_r;
   886	            `WB_SEL_MD   : wb_data_mux = ex_wb_md_result_r;
   887	            default      : wb_data_mux = ex_wb_alu_result_r;
   888	        endcase
   889	    end
   890	    assign wb_data = wb_data_mux;
   891	
   892	    // IRQ / precise load/store exception entry (在 WB commit boundary)
   893	    wire wb_take_data_trap = ex_wb_valid_r && ex_wb_is_misaligned_r;
   894	    assign wb_take_irq = ex_wb_valid_r && irq_pending && !ex_wb_illegal_r && !wb_take_data_trap;
   895	    assign wb_trap_cause = wb_take_data_trap ?
   896	                           (ex_wb_is_misaligned_store_r ? `MCAUSE_STORE_ADDR_MISALIGNED :
   897	                                                          `MCAUSE_LOAD_ADDR_MISALIGNED) :
   898	                           `MCAUSE_EXT_IRQ;
   899	    assign wb_trap_mtval  = ex_wb_alu_result_r;
   900	
   901	    // RFU write
   902	    assign rfu_we      = ex_wb_valid_r && ex_wb_rd_we_r && !ex_wb_illegal_r && !wb_take_irq && !wb_take_data_trap;
   903	    assign rfu_wr_idx  = ex_wb_rd_idx_r;
   904	    assign rfu_wr_data = wb_data;
   905	
   906	    // PC redirect decision (lab08b: 只在 mispredict 時 redirect)
   907	    //   優先級 (lab08c):
   908	    //     1. IRQ entry → mtvec     (從 ex_wb)
   909	    //     2. MRET → mepc           (從 ex_wb)
   910	    //     3. MEM-stage RAS target mispredict (= RAS 預測 target 跟 alu 算的不一致)
   911	    //     4. ex_mem mispredict (= lab08b 的 direction mispredict) — RAS-predicted 已自動
   912	    //        滿足 direction 比對 (pred_taken=1 + actual_taken=1)，不會在這分支 fire
   913	    //
   914	    //   RAS 預測對且 target 也對：mem_ras_mispredict=0、ex_mem_mispredict_r=0 → 不 redirect，
   915	    //   pipeline 順利往下走（IF 階段已從 RAS target fetch 完成）。
   916	    always @* begin
   917	        pc_redirect     = 1'b0;
   918	        redirect_target = 32'h0;
   919	
   920	        if (wb_take_irq) begin
   921	            pc_redirect     = 1'b1;
   922	            redirect_target = mtvec_o;
   923	        end else if (ex_wb_valid_r && ex_wb_is_mret_r) begin
   924	            pc_redirect     = 1'b1;
   925	            redirect_target = mepc_o;
   926	        end else if (mem_ras_mispredict) begin
   927	            // RAS 預測 target 跟 actual jalr target 不一致 — recovery 到 actual target
   928	            pc_redirect     = 1'b1;
   929	            redirect_target = mem_ras_actual_target;
   930	        end else if (ex_mem_valid_r && ex_mem_mispredict_r) begin
   931	            pc_redirect     = 1'b1;
   932	            // Recovery target combinational from ex_mem.Q registers (no alu_result on path)
   933	            //   is_jalr      → alu_result_r & ~1
   934	            //   branch_taken → pc_plus_imm_r
   935	            //   is_jal       → pc_plus_imm_r
   936	            //   else (branch not-taken mispredict) → pc_plus_4_r
   937	            redirect_target = ex_mem_is_jalr_r          ? (ex_mem_alu_result_r & ~32'd1) :
   938	                              ex_mem_is_branch_taken_r  ? ex_mem_pc_plus_imm_r :
   939	                              ex_mem_is_jal_r           ? ex_mem_pc_plus_imm_r :
   940	                                                          ex_mem_pc_plus_4_r;
   941	        end
   942	    end
   943	
   944	    // CSR / trap / instret 訊號
   945	    assign wb_trap_enter        = wb_take_irq || wb_take_data_trap;
   946	    assign wb_trap_exit          = ex_wb_valid_r && ex_wb_is_mret_r;
   947	    // trap_pc_for_mepc = 中斷時要保存的「下一條 PC」
   948	    //   被中斷的指令本身已 commit (rd_we=0 但 pc 已 +4 等概念)，所以存的是 next_pc
   949	    //   normal next_pc = pc+4；如果同時是 branch taken → pc+imm 之類
   950	    assign wb_trap_pc_for_mepc = ex_wb_is_branch_taken_r ? ex_wb_pc_plus_imm_r :
   951	                                  ex_wb_is_jal_r          ? ex_wb_pc_plus_imm_r :
   952	                                  ex_wb_is_jalr_r         ? (ex_wb_alu_result_r & ~32'd1) :
   953	                                                            ex_wb_pc_plus_4_r;
   954	    assign wb_instr_retired = ex_wb_valid_r && !wb_take_irq && !wb_take_data_trap;
   955	
   956	    // =========================================================================
   957	    // Trap output (illegal 進 TRAP 簡化版：直接卡死，不像 lab05 那麼正式)
   958	    // 為了維持 ebreak 行為，遇到 illegal 時 PC 永遠 redirect 到 PC（自鎖）
   959	    // =========================================================================
   960	    reg trap_latched;
   961	    always @(posedge clk) begin
   962	        if (!resetn) trap_latched <= 1'b0;
   963	        else if (ex_wb_valid_r && ex_wb_illegal_r) trap_latched <= 1'b1;
   964	    end
   965	    assign trap = trap_latched;
   966	
   967	    // =========================================================================
   968	    // Debug
   969	    // =========================================================================
   970	    assign dbg_pc    = if_ex_pc;
   971	    assign dbg_instr = if_ex_instr;
   972	    assign dbg_state = {stall, wb_take_irq, ex_wb_valid_r};
   973	
   974	endmodule

diff --git a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v
index 8cf0c6177aef517b9f7eaf7bdf3528101ebb0fdd..dd492d23975ed89fbca905c963f9d5e6665ab40d
--- a/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v
+++ b/IP/cpu_m1/rtl/pipeline_v2/ch2_lab08e/core.v
@@ -19,6 +19,7 @@
     input             clk,
     input             resetn,
