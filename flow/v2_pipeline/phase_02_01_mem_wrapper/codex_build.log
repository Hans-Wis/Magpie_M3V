    function automatic [31:0] instr_at_pc_ref(input [31:0] pc);
        reg [31:0] word0;
        reg [31:0] word1;
        reg [15:0] half0;
        reg [15:0] half1;
        begin
            word0 = (pc[ADDR_BITS+1:2] < MEM_WORDS) ? mem_ref[pc[ADDR_BITS+1:2]] : 32'h0;
            half0 = word0[15:0];
            half1 = word0[31:16];
            if (pc[1:0] == 2'b00) begin
                if (half0[1:0] == 2'b11)
                    instr_at_pc_ref = {16'h0, half0};
                else if (pc[1] == 1'b0)
                    instr_at_pc_ref = word0;
                else begin
                    word1 = ((pc[ADDR_BITS+1:2] + 1'b1) < MEM_WORDS) ? mem_ref[pc[ADDR_BITS+1:2] + 1'b1] : 32'h0;
                    instr_at_pc_ref = {word1[15:0], half0};
                end
            end else begin
                if (half1[1:0] == 2'b11)
                    instr_at_pc_ref = {16'h0, half1};
                else begin
                    word1 = ((pc[ADDR_BITS+1:2] + 1'b1) < MEM_WORDS) ? mem_ref[pc[ADDR_BITS+1:2] + 1'b1] : 32'h0;
                    instr_at_pc_ref = {word1[15:0], half1};
                end
            end
        end
    endfunction

    function automatic [31:0] instr_at_pc_top(input [31:0] pc);
        reg [31:0] word0;
        reg [31:0] word1;
        reg [15:0] half0;
        reg [15:0] half1;
        begin
            word0 = (pc[ADDR_BITS+1:2] < MEM_WORDS) ? mem_top[pc[ADDR_BITS+1:2]] : 32'h0;
            half0 = word0[15:0];
            half1 = word0[31:16];
            if (pc[1:0] == 2'b00) begin
                if (half0[1:0] == 2'b11)
                    instr_at_pc_top = {16'h0, half0};
                else if (pc[1] == 1'b0)
                    instr_at_pc_top = word0;
                else begin
                    word1 = ((pc[ADDR_BITS+1:2] + 1'b1) < MEM_WORDS) ? mem_top[pc[ADDR_BITS+1:2] + 1'b1] : 32'h0;
                    instr_at_pc_top = {word1[15:0], half0};
                end
            end else begin
                if (half1[1:0] == 2'b11)
                    instr_at_pc_top = {16'h0, half1};
                else begin
                    word1 = ((pc[ADDR_BITS+1:2] + 1'b1) < MEM_WORDS) ? mem_top[pc[ADDR_BITS+1:2] + 1'b1] : 32'h0;
                    instr_at_pc_top = {word1[15:0], half1};
                end
            end
        end
    endfunction

    task automatic clear_mem(input bit for_top);
        integer i;
        begin
            for (i = 0; i < MEM_WORDS; i = i + 1) begin
                if (for_top)
                    mem_top[i] <= 32'h0;
                else
                    mem_ref[i] <= 32'h0;
            end
        end
    endtask

    task automatic load_firmware_ref(input bit misalign_program);
        begin
            clear_mem(1'b0);
            if (misalign_program)
                $readmemh("firmware_misalign.hex", mem_ref);
            else
                $readmemh("firmware.hex", mem_ref);
        end
    endtask

    task automatic load_firmware_top(input bit misalign_program);
        begin
            clear_mem(1'b1);
            if (misalign_program)
                $readmemh("firmware_misalign.hex", mem_top);
            else
                $readmemh("firmware.hex", mem_top);
        end
    endtask

    task automatic reset_and_prepare;
        integer i;
        begin
            resetn <= 1'b0;
            run_ref <= 1'b0;

