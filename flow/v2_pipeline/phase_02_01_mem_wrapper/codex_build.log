        .rfu_rs1_data (rfu_rs1_data),
        .rfu_rs2_data (rfu_rs2_data),
        .em_valid     (ex_mem_valid_r),
        .em_rd_we     (ex_mem_rd_we_r),
        .em_rd_idx    (ex_mem_rd_idx_r),
        .em_fwd_val   (ex_mem_fwd_val),
        .em_is_load   (ex_mem_is_load_r),
